{
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "lib": ["dom", "es2020", "dom.iterable"],
    "allowJs": false,
    "checkJs": false,
    "jsx": "react",
    "sourceMap": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": true,
    "noImplicitThis": true,
    "types": ["vite/client"],
    "alwaysStrict": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "./src",
    "./src/**/*.json",
    "./src/**/*.d.ts",
    "./packages/skin/scripts/storybook/story-markup-core.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
