<style>
    /* Footer */
    .footer {
        background-color: rgb(17 24 39);
        color: white;
    }

    footer a {
        color: var(--color-foreground-secondary);
        text-decoration: none;
        transition: color var(--transition-duration);
        font-size: 0.95rem;
    }

    footer a:visited {
        color: var(--color-foreground-secondary);
    }

    .footer__container {
        max-width: 80rem;
        margin: 0 auto;
    }

    .footer__content {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--spacing-xl);
        margin-block: var(--spacing-400);
    }

    @media (min-width: 768px) {
        .footer__content {
            grid-template-columns: 2fr auto auto;
            gap: 4rem;
            align-items: start;
        }
    }

    /* Brand Section - Left Column */
    .footer__brand-section {
        display: flex;
        flex-direction: column;
    }

    .footer__brand {
        display: flex;
        align-items: center;
        gap: var(--spacing-100);
        margin-bottom: var(--spacing-200);
    }

    .footer__logo {
        background-color: var(--color-background-primary);
        padding: var(--spacing-100);
        width: 40px;
        height: 40px;
        border-radius: 12px;
    }

    .footer__logo-icon {
        width: 1.5rem;
        height: 1.5rem;
        color: var(--color-foreground-primary);
    }

    .footer__brand-text {
        font-size: 1.5rem;
        font-weight: 600;
    }

    .footer__description {
        color: rgb(156 163 175);
        margin-bottom: var(--spacing-300);
        max-width: 24rem;
        line-height: 1.6;
    }

    .footer__social {
        display: flex;
        gap: var(--spacing-200);
    }

    .footer__social-link {
        color: rgb(156 163 175);
        transition: color var(--transition-duration);
        text-decoration: none;
    }

    .footer__social-link:hover {
        color: white;
    }

    .footer__social-icon {
        width: 1.5rem;
        height: 1.5rem;
    }

    /* Navigation Columns */
    .footer__column {
        display: flex;
        flex-direction: column;
    }

    .footer__column-title {
        font-size: 1.125rem;
        font-weight: 600;
        margin-block: 0 var(--spacing-200);
        color: white;
    }

    .footer__link-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-100);
    }

    .footer__link:hover {
        color: white;
    }

    /* Bottom Section */
    .footer__bottom {
        border-top: 1px solid rgb(55 65 81);
        // padding-top: var(--spacing-xl);
    }

    .footer__bottom-content {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        gap: var(--spacing-200);
        max-width: 80rem;
        margin: 0 auto;
    }

    @media (min-width: 768px) {
        .footer__bottom-content {
            flex-direction: row;
        }
    }

    .footer__copyright {
        color: rgb(156 163 175);
        font-size: 0.875rem;
    }

    .footer__legal {
        display: flex;
        gap: var(--spacing-300);
    }

    .footer__legal-link {
        color: rgb(156 163 175);
        text-decoration: none;
        font-size: 0.875rem;
        transition: color var(--transition-duration);
    }

    .footer__legal-link:hover {
        color: white;
    }
</style>
