import { components, getMetadata } from "./components";

<for|_key, comp| in=components>
    <const/{ componentUrls }=getMetadata(comp.name)>
    <if=comp.properName>
        <li>
            <a href=componentUrls?.overview class="nav-link" role="menuitem">
                ${comp.properName}
            </a>
        </li>
    </if>
</for>
