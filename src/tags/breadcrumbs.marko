// Function to convert URL segments to readable labels
<const/formatBreadcrumbLabel=(segment: string) => {
  return segment
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}>
// Get current URL path and create breadcrumb segments
<const/currentPath=(() => {
  let currentPath = "";
  if (typeof window !== "undefined") {
    currentPath = window.location.pathname;
  } else if ($global?.url) {
    // If we have a full URL, extract just the pathname
    try {
      const url = new URL($global.url);
      currentPath = url.pathname;
    } catch {
      // Fallback: if it's already a pathname, use it directly
      const urlString = String($global.url);
      currentPath = urlString.startsWith("/") ? urlString : "/" + urlString;
    }
  }
  currentPath = currentPath.startsWith("/") ? currentPath : "/" + currentPath;
  currentPath =
    currentPath.endsWith("/") && currentPath !== "/"
      ? currentPath.slice(0, -1)
      : currentPath;

  return currentPath;
})()>
// Parse URL segments to create breadcrumbs
<const/segments=(currentPath.split("/").filter((segment) => segment !== ""))>

<const/breadcrumbs=(() => {
  let breadcrumbs = [
    // Always start with home
    {
      label: "Evo Web",
      href: "./",
      isLast: segments.length === 0,
    },
  ];

  // Add each segment as a breadcrumb
  for (let i = 0; i < segments.length; i++) {
    const segment = segments[i];

    // Skip catch-all route markers
    if (segment.includes("$$")) {
      continue;
    }

    const href = segments.slice(0, i + 1).join("/");
    const isLast = i === segments.length - 1;

    // Handle special cases for better labels
    let label = formatBreadcrumbLabel(segment);

    // Special handling for common patterns
    if (segment === "accessibility") {
      label = "Accessibility";
    } else if (segment === "anti-patterns") {
      label = "Anti-patterns";
    } else if (segment === "patterns") {
      label = "Patterns";
    }

    breadcrumbs[breadcrumbs.length] = {
      label: label,
      href: href,
      isLast: isLast,
    };
  }
  return breadcrumbs;
})()>

<div class="site-breadcrumbs">
  <nav
    aria-labelledby="site-breadcrumbs-heading"
    class="breadcrumbs"
    role="navigation">
    <p id="site-breadcrumbs-heading" class="clipped">
      You are here
    </p>
    <ul>
      <for|breadcrumb, index| of=breadcrumbs>
        <li>
          <if=!breadcrumb.isLast>
            <a href=breadcrumb.href>
              ${breadcrumb.label}
            </a>
            <svg class="icon icon--12" height="8" width="8" aria-hidden="true">
              <use href="#icon-chevron-right-12"/>
            </svg>
          </if>
          <else>
            <a aria-current="page">
              ${breadcrumb.label}
            </a>
          </else>
        </li>
      </for>
    </ul>
  </nav>
</div>

<style>
  .site-breadcrumbs {
    padding-block-start: 8px;
  }

  .site-breadcrumbs nav.breadcrumbs {
    padding-inline-start: 0;
  }

  .site-breadcrumbs ~ main h1 {
    margin-block: 0 16px;
  }
</style>
