$ const metadata = input.metadata || {};
$ let componentName = metadata["name"] || {};
$ let dsComponent = metadata["ds-component"] || {};
$ if (dsComponent.length > 0) {
    dsComponent = dsComponent[0];
}
$ const properName = componentName.charAt(0).toUpperCase() + componentName.slice(1);

style {
    .component-header {
        display: flex;
        flex-wrap: wrap;
        margin: var(--spacing-400) 0 var(--spacing-200);
        justify-content: space-between;
        align-items: baseline;
    }

    .component-header h1 {
        margin: 0;
    }

    .component-header__link {
        text-decoration: underline;
    }
}
<macro name="body">
    ${properName} Component
    <if(input.beta === "true")>
        <sup>BETA</sup>
    </if>
    <else-if(input.alpha === "true")>
        <sup>ALPHA</sup>
    </else-if>
</macro>
<div class="component-header">
    <if(input.header === "h3")>
        <h3>
            <body/>
        </h3>
    </if>
    <else-if(input.header === "h2")>
        <h2>
            <body/>
        </h2>
    </else-if>
    <else>
        <h1>
            <body/>
        </h1>
    </else>
    <span class="component-header__link">

        <a href=`${dsComponent?.url || "https://playbook.ebay.com/design-system/components/"}` target="_blank">
            <svg class="icon icon--16" height="16" width="16" aria-hidden="true">
                <use href="#icon-external-link-16" />
            </svg> Playbook
        </a>
    </span>
</div>
