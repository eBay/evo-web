import { getMetadataFromUrl } from "../data";
static const basePath = import.meta.env.BASE_URL;
static declare global {
  interface Window {
    dataLayer: any[]; // Or a more specific type if you define a structure for your dataLayer pushes
  }
}
<const/{pageImg} = getMetadataFromUrl($global.url.pathname)>

<style.scss>
  @use "@ebay/skin/dist/global/global.css";
  @use "@ebay/skin/dist/layout-grid/layout-grid.css";

  .main {
    align-items: center;
    display: flex;
    flex-direction: column;
    height: 90vh;
    justify-content: center;
  }

  .main .layout-grid {
    --layout-grid-columns-min: 1;
    --layout-grid-columns-xs: 2;
    --layout-grid-columns-sm: 2;
    --layout-grid-columns-md: 2;
    --layout-grid-columns-lg: 2;
    --layout-grid-columns-xl: 2;
    --layout-grid-columns-xl2: 2;
    --layout-grid-columns-xl3: 2;
    --layout-grid-columns-xl4: 2;
    --layout-grid-cell-gap: 10px;

    width: 50vw;
  }

  .main nav > ul > li div {
    border: 1px solid black;
    border-radius: 5px;
    padding: 50px 30px;
    text-align: center;
    white-space: nowrap;
  }
</style>
<!doctype html>
<html lang="en">
  <head>
    <title>${$global.meta.pageTitle || "evo-web"}</title>
    <meta
      name="description"
      content=`${$global.meta.pageDescription || "Evo Web contains the latest components built with a11y in mind"}`>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <base href=basePath>
    <meta property="og:title" content=`${$global.meta.pageTitle || "evo web"}`>
    <meta
      property="og:description"
      content=`${$global.meta.pageDescription || "Evo Web contains the latest components built with a11y in mind"}`>
    <meta property="og:type" content="website">
    <meta property="og:image" content=`${pageImg || ($global.meta as any).pageImg || ""}`>
    <meta name="twitter:image" content=`${pageImg || ($global.meta as any).pageImg || ""}`>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content=`${$global.meta.pageTitle || "evo web"}`>
    <meta
      name="twitter:description"
      content=`${$global.meta.pageDescription || "Evo Web contains the latest components built with a11y in mind"}`>
    <link
      rel="icon"
      type="image/png"
      href=`${basePath}favicon/favicon-96x96.png`
      sizes="96x96">
    <link
      rel="icon"
      type="image/svg+xml"
      href=`${basePath}favicon/favicon.svg`>
    <link
      rel="shortcut icon"
      href=`${basePath}favicon/favicon.ico`>
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href=`${basePath}favicon/apple-touch-icon.png`>
    <meta name="apple-mobile-web-app-title" content="Evo Web">
    <link rel="manifest" href=`${basePath}favicon/site.webmanifest`>
    // tracking
    <html-script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-9HQJ5CWCJZ"/>
    <script>
      (window.dataLayer ||= []).push(
        ["js", new Date()],
        ["config", "G-9HQJ5CWCJZ"],
      );
    </script>
  </head>
  <body class="evo-theme">
    <${input.content}/>
  </body>
</html>
