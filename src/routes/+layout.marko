static const basePath = import.meta.env.BASE_URL;
<style.scss>
    @use "@ebay/skin/dist/global/global.css";
    @use "@ebay/skin/dist/layout-grid/layout-grid.css";

    .main {
        align-items: center;
        display: flex;
        flex-direction: column;
        height: 90vh;
        justify-content: center;
    }

    .main .layout-grid {
        --layout-grid-columns-min: 1;
        --layout-grid-columns-xs: 2;
        --layout-grid-columns-sm: 2;
        --layout-grid-columns-md: 2;
        --layout-grid-columns-lg: 2;
        --layout-grid-columns-xl: 2;
        --layout-grid-columns-xl2: 2;
        --layout-grid-columns-xl3: 2;
        --layout-grid-columns-xl4: 2;
        --layout-grid-cell-gap: 10px;

        width: 50vw;
    }

    .main nav > ul > li div {
        border: 1px solid black;
        border-radius: 5px;
        padding: 50px 30px;
        text-align: center;
        white-space: nowrap;
    }

    /* GENERAL */
    div.highlight {
        background-color: var(--color-background-tertiary);
        padding: var(--spacing-200);
    }

    span.highlight {
        background-color: var(--color-background-tertiary);
        font-family: Consolas, "Liberation Mono", Menlo, Courier, monospace;

        /* fix for long attributes values that don't wrap right */
        .s {
            overflow-wrap: break-word;
            word-break: break-all;
        }
    }
</style>
<!doctype html>
<html lang="en">
    <head>
        <title>${$global.meta.pageTitle || "evo-web"}</title>
        <meta
            name="description"
            content=`${$global.meta.pageDescription || "Evo Web contains the latest components built with a11y in mind"}`>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <base href=basePath>
        <meta
            property="og:title"
            content=`${$global.meta.pageTitle || "evo web"}`>
        <meta
            property="og:description"
            content=`${$global.meta.pageDescription || "Evo Web contains the latest components built with a11y in mind"}`>
        <meta property="og:type" content="website">
        <meta property="og:image" content=`${$global.meta.pageImgCard || ""}`>
        <meta name="twitter:image" content=`${$global.meta.pageImgCard || ""}`>
        <meta name="twitter:card" content="summary_large_image">
        <meta
            name="twitter:title"
            content=`${$global.meta.pageTitle || "evo web"}`>
        <meta
            name="twitter:description"
            content=`${$global.meta.pageDescription || "Evo Web contains the latest components built with a11y in mind"}`>
        <favicons/>
        <analytics-tracking/>
    </head>
    <body class="evo-theme">
        <${input.content}/>
    </body>
</html>
