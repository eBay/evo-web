client import "./listbox-comparison.js";

<style>
  .listbox-comparison {
    max-width: 1120px;
    padding-bottom: 48px;
  }
  .listbox-comparison__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin-block: 20px;
  }
  .listbox-comparison__controls label {
    align-items: center;
    display: inline-flex;
    gap: 8px;
  }
  .listbox-comparison__select {
    display: block;
    max-width: 100%;
    padding: 8px;
    width: 100%;
  }
  .listbox-comparison__grid {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .listbox-comparison__side {
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--border-radius-100);
    min-width: 0;
    padding: 16px;
  }
  .listbox-comparison__side h2 {
    font-size: var(--font-size-large-1);
    margin-block: 0 16px;
  }
  .listbox-comparison__stage {
    min-height: 460px;
    padding: 8px;
    position: relative;
  }
  .listbox-comparison__viewport {
    overflow: auto;
  }
  .listbox-comparison__result {
    background: var(--color-background-secondary);
    display: block;
    margin-block: 16px;
    overflow-wrap: anywhere;
    padding: 12px;
  }
  .listbox-comparison__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .listbox-comparison__error {
    color: var(--color-foreground-attention);
  }
  .listbox-comparison__close {
    margin-block: 8px;
  }
  .listbox-comparison pre {
    max-height: 360px;
    overflow: auto;
    white-space: pre-wrap;
  }
  .listbox-comparison__status {
    border-inline-start: 4px solid var(--color-border-medium);
    margin-block: 20px;
    padding-inline-start: 16px;
  }
  .listbox-comparison .demo-a11y-text-spacing,
  .listbox-comparison .demo-a11y-text-spacing * {
    line-height: 1.5 !important;
    letter-spacing: 0.12em !important;
    word-spacing: 0.16em !important;
  }
  .listbox-comparison .demo-a11y-text-spacing p {
    margin-bottom: 2em !important;
  }
  .compatibility-map {
    border-top: 1px solid var(--color-border-subtle);
    margin-top: 40px;
    padding-top: 24px;
    scroll-margin-top: 88px;
  }
  .compatibility-map__filters {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block: 24px 12px;
  }
  .compatibility-map__filters label {
    display: block;
    margin-bottom: 8px;
  }
  .compatibility-map__columns {
    display: grid;
    gap: 12px 24px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .compatibility-map__column,
  .compatibility-map__column > [data-style-lane] {
    display: contents;
  }
  .compatibility-map__column[hidden] {
    display: none;
  }
  .compatibility-map__column > h3 {
    grid-row: 1;
    margin: 0;
  }
  .compatibility-map__column > p {
    grid-row: 2;
    margin: 0;
  }
  .compatibility-map__column > * {
    grid-column: 1;
  }
  .compatibility-map__column--component > *,
  .compatibility-map__column--component .compatibility-map__card {
    grid-column: 2;
  }
  .compatibility-map__card {
    border: 1px solid var(--color-border-subtle);
    border-inline-start: 4px solid var(--color-foreground-accent);
    border-radius: var(--border-radius-100);
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    overflow-wrap: anywhere;
    padding: 12px;
  }
  .compatibility-map__column--component .compatibility-map__card {
    border-inline-start-color: var(--color-foreground-primary);
  }
  .compatibility-map__column--component .compatibility-map__subheading {
    font-size: var(--font-size-large-1);
    grid-column: 2;
    margin: 12px 0 0;
  }
  [data-style-lane="shared"] .compatibility-map__card {
    margin-block: 12px;
  }
  .compatibility-map__card h4 {
    font-size: var(--font-size-body);
    margin: 0;
  }
  .compatibility-map__card p {
    margin: 0;
  }
  .compatibility-map__owner {
    color: var(--color-foreground-secondary);
    font-size: var(--font-size-small);
  }
  .compatibility-map__card pre[class*="language-"] {
    flex: 1;
    font-size: var(--font-size-small);
    margin: 8px 0 0;
    max-height: 220px;
    overflow: auto;
  }
  .listbox-comparison [data-comparison-grid] {
    scroll-margin-top: 88px;
  }
  @media (max-width: 1000px) {
    .listbox-comparison__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .compatibility-map__filters {
      grid-template-columns: minmax(0, 1fr);
    }
    .compatibility-map__columns,
    .compatibility-map__column,
    .compatibility-map__column > [data-style-lane] {
      display: block;
    }
    .compatibility-map__column > p,
    .compatibility-map__card {
      margin-block: 12px;
    }
  }
</style>

<div class="listbox-comparison" id="listbox-comparison">
  <h1>Listbox compatibility comparison</h1>
  <p>
    Compare the original <strong>Listbox Button</strong> examples with
    <strong>Menu Button + Listbox</strong>. Choose any source example, then combine
    the controls below. Both sides are interactive.
  </p>
  <p>
    The reference uses the existing Skin story markup. Compatibility styling
    carries the original control's styling rules into the composition, including
    its popup surface. Turn it off to inspect the public modules on their own.
    This is a prototype, not a deprecation decision.
  </p>
  <p>Checked overrides add to the source example's existing states.</p>
  <p>
    <a href="#compatibility-ownership">
      See each compatibility rule and its proposed owner
    </a>.
  </p>
  <label for="listbox-source"><strong>Source example</strong></label>
  <select id="listbox-source" class="listbox-comparison__select" data-source/>
  <div class="listbox-comparison__controls" data-controls>
    <label>
      <input type="checkbox" data-toggle="open">
      Open
    </label>
    <label>
      <input type="checkbox" data-toggle="disabled">
      Disabled
    </label>
    <label>
      <input type="checkbox" data-toggle="ariaDisabled">
      ARIA disabled
    </label>
    <label>
      <input type="checkbox" data-toggle="fluid">
      Full width
    </label>
    <label>
      <input type="checkbox" data-toggle="long">
      Long labels
    </label>
    <label>
      <input type="checkbox" data-toggle="error">
      Error class
    </label>
    <label>
      <input type="checkbox" data-toggle="invalid">
      Invalid
    </label>
    <label>
      <input type="checkbox" data-toggle="tokens">
      Custom tokens
    </label>
    <label>
      <input type="checkbox" data-toggle="abbreviated">
      Abbreviated button classes
    </label>
    <label>
      <input type="checkbox" data-required>
      Required
    </label>
    <label>
      <input type="checkbox" data-bridge-toggle checked>
      Compatibility styling
    </label>
  </div>
  <div class="listbox-comparison__actions">
    <button type="button" class="button button--secondary" data-reset-case>
      Reset case
    </button>
    <button type="button" class="button button--secondary" data-clear>
      Clear selection
    </button>
    <button type="button" class="button button--secondary" data-measure>
      Compare current styling
    </button>
  </div>
  <p data-source-info/>
  <div data-comparison-grid class="listbox-comparison__grid"/>
  <div class="listbox-comparison__status" aria-live="polite" data-status>
    Loading source examples.
  </div>
  <details>
    <summary>Current styling differences</summary>
    <pre data-differences/>
  </details>
  <details>
    <summary>Source coverage</summary>
    <p data-coverage/>
    <ul data-source-list/>
  </details>
  <p>
    Enter or Space opens the list. Arrows, Home, End and typing move through
    enabled options. Enter or Space selects; Escape cancels. Close options is
    also available below each example. Submit shows the native form values;
    reset restores the source example.
  </p>
  <section
    class="compatibility-map"
    id="compatibility-ownership"
    aria-labelledby="compatibility-ownership-title"
  >
    <h2 id="compatibility-ownership-title">
      Where the compatibility styles belong
    </h2>
    <p>
      Proposed ownership: <strong>Menu Button</strong> owns the wrapper and the
      dropdown. <strong>Button</strong> owns the trigger.
      <strong>Listbox</strong> owns the options. <strong>Phone Input</strong>
      owns the joined telephone field. Each rule is shown with its proposed BEM
      name, under its owner's block only; new element names are proposals.
    </p>
    <p>
      Every rule the prototype copied, including rules the components already
      share, plus the four POC adjustments. A copied rule is not necessarily
      missing from the new composition.
    </p>
    <p data-style-total/>
    <div class="compatibility-map__filters">
      <div>
        <label for="compatibility-owner"><strong>Proposed owner</strong></label>
        <select
          id="compatibility-owner"
          class="listbox-comparison__select"
          data-style-filter
        >
          <option value="all">All owners</option>
          <option value="Menu Button">Menu Button</option>
          <option value="Button">Button</option>
          <option value="Listbox">Listbox</option>
          <option value="Phone Input">Phone Input</option>
          <option value="Shared Skin">Shared Skin foundations</option>
        </select>
      </div>
      <div>
        <label for="compatibility-search">
          <strong>Find a style, selector or token</strong>
        </label>
        <span class="textbox textbox--fluid">
          <input
            id="compatibility-search"
            class="textbox__control"
            type="search"
            data-style-search
          >
        </span>
      </div>
    </div>
    <p data-style-count role="status"/>
    <div class="compatibility-map__columns">
      <div class="compatibility-map__column">
        <h3>Menu Button layer</h3>
        <p>The wrapper and the dropdown.</p>
        <div data-style-lane="menu-button"/>
      </div>
      <div class="compatibility-map__column compatibility-map__column--component">
        <h3>Component layer</h3>
        <p>
          The <strong>Button</strong> trigger, <strong>Listbox</strong> options
          and the <strong>Phone Input</strong> field.
        </p>
        <div data-style-lane="component"/>
      </div>
    </div>
    <div>
      <h3>Keep in shared foundations</h3>
      <div data-style-lane="shared"/>
    </div>
    <p>
      <strong>Listbox Button</strong> keeps its legacy selectors during
      migration. Existing custom properties and abbreviated button classes need
      a migration contract, rather than an extra stylesheet for consumers.
      Interaction and form submission remain demonstration-controller behavior,
      outside this CSS map.
    </p>
    <p><a href="#listbox-source">Back to the interactive comparison</a></p>
  </section>
</div>
