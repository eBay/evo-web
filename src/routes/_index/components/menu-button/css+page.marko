                    width="18"
                    aria-hidden="true"
                  >
                    <icon-symbol name="checkbox-checked-18"/>
                  </svg>
                </span>
                <span class="filter-menu__text">Blue</span>
              </div>
              <div
                class="filter-menu__item"
                role="menuitemcheckbox"
                aria-checked="false"
                tabindex="-1"
              >
                <span class="filter-menu__checkbox">
