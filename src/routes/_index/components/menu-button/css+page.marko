import { urls } from "../../../../data";
<div id="menu-button">
  <section-header/>
  <p>
    A menu button holds a trigger button and a
    <code>menu-button__dropdown</code> . The dropdown is hidden until the
    trigger, which must come first, has <code>aria-expanded="true"</code> . It
    opens below the trigger, at least as wide as the trigger.
  </p>
  <p>
    <strong>NOTE:</strong> Only limited JavaScript behaviour has been
    implemented in these examples. For detailed behaviour requirements, see the
    <a href=`${urls.components}/menu-button/accessibility`>
      accessibility guidelines
    </a>
    .
  </p>

  <h2 id="menu-button-action">Action Menu</h2>
  <p>
    To open commands, place an
    <a href=`${urls.components}/action-menu`>action menu</a> in the dropdown.
    The trigger sets <code>aria-haspopup="menu"</code> , and the menu points
    back at it with <code>aria-labelledby</code> .
  </p>
  <div class="demo">
    <div class="demo__inner">
      <span class="menu-button">
        <button
          class="button"
          type="button"
          id="pb-docs-action-trigger"
          aria-expanded="false"
          aria-haspopup="menu"
          aria-controls="pb-docs-action-content"
        >
          <span class="button__cell">
            <span class="button__text">Actions</span>
            <svg
              class="icon icon--12"
              height="12"
              width="12"
              aria-hidden="true"
            >
              <icon-symbol name="chevron-down-12"/>
            </svg>
          </span>
        </button>
        <div class="menu-button__dropdown">
          <div
            class="action-menu"
            role="menu"
            id="pb-docs-action-content"
            aria-labelledby="pb-docs-action-trigger"
          >
            <div class="action-menu__item" role="menuitem" tabindex="0">
              <span>Edit</span>
            </div>
            <div class="action-menu__item" role="menuitem" tabindex="-1">
              <span>Duplicate</span>
            </div>
            <div
              class="action-menu__item"
              role="menuitem"
              aria-disabled="true"
              tabindex="-1"
            >
              <span>Archive</span>
            </div>
            <hr class="action-menu__separator" role="separator">
            <div
              class="action-menu__item"
              role="menuitemcheckbox"
              aria-checked="true"
              tabindex="-1"
            >
              <span>Show sold items</span>
              <svg
                class="icon icon--16 action-menu__icon"
                height="16"
                width="16"
                aria-hidden="true"
              >
                <icon-symbol name="tick-16"/>
              </svg>
            </div>
            <div
              class="action-menu__item"
              role="menuitemcheckbox"
              aria-checked="false"
              tabindex="-1"
            >
              <span>Show ended items</span>
              <svg
                class="icon icon--16 action-menu__icon"
                height="16"
                width="16"
                aria-hidden="true"
              >
                <icon-symbol name="tick-16"/>
              </svg>
            </div>
            <hr class="action-menu__separator" role="separator">
            <div
              class="action-menu__item"
              role="menuitemradio"
              aria-checked="true"
              data-makeup-group="sort"
              tabindex="-1"
            >
              <span>Sort by price</span>
              <svg
                class="icon icon--16 action-menu__icon"
                height="16"
                width="16"
                aria-hidden="true"
              >
                <icon-symbol name="tick-16"/>
              </svg>
            </div>
            <div
              class="action-menu__item"
              role="menuitemradio"
              aria-checked="false"
              data-makeup-group="sort"
              tabindex="-1"
            >
              <span>Sort by date</span>
              <svg
                class="icon icon--16 action-menu__icon"
                height="16"
                width="16"
                aria-hidden="true"
              >
                <icon-symbol name="tick-16"/>
              </svg>
            </div>
          </div>
        </div>
      </span>
    </div>
  </div>

