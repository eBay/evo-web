  <h2 id="menu-button-deprecated">Deprecated markup</h2>
  <section
    class="section-notice section-notice--attention"
    role="region"
    aria-label="Attention"
    aria-roledescription="Notice"
  >
    <div class="section-notice__header" id="menu-button-css-deprecated-notice">
      <svg class="icon icon--16" height="16" width="16" aria-label="Attention">
        <icon-symbol name="attention-filled-16"/>
      </svg>
    </div>
    <div class="section-notice__main">
      <h3 class="section-notice__title">Deprecated</h3>
      <p>
        The older <code>menu-button</code> classes,
        <code>menu-button__button</code> , <code>__menu</code> ,
        <code>__items</code> , <code>__item</code> , <code>__separator</code> ,
        <code>__footer</code> , <code>__option--active</code> and
        <code>menu-button--filter</code> , are deprecated and will be removed in
        the next major version of Skin. Use <code>menu-button__dropdown</code>
        with an <a href=`${urls.components}/action-menu`>action-menu</a> ,
        <a href=`${urls.components}/filter-menu`>filter-menu</a> or
        <a href=`${urls.components}/navigation-menu`>navigation-menu</a> inside
        it instead.
      </p>
    </div>
  </section>

  <p><strong>NOTE:</strong> .</p>

  <h3 id="menu-button-default">Default Menu Button</h3>
  <p>
