  <h2 id="menu-button-filter">Filter Menu</h2>
  <p>
    To open filter choices, use a
    <a href=`${urls.components}/filter-chip`>filter chip</a> as the trigger and
    place a <a href=`${urls.components}/filter-menu`>filter menu</a> in the
    dropdown. When a filter is applied, add <code>filter-chip--selected</code>
    and say so in visually hidden text; do not use <code>aria-pressed</code> .
  </p>
  <div class="demo">
    <div class="demo__inner">
      <span class="menu-button">
        <button
          class="filter-chip filter-chip--selected"
          type="button"
          id="pb-docs-filter-trigger"
          aria-expanded="false"
          aria-haspopup="menu"
          aria-controls="pb-docs-filter-content"
        >
          <span class="filter-chip__text">Color</span>
          <svg
            class="icon icon--12 filter-chip__trailing"
            height="12"
            width="13"
            aria-hidden="true"
          >
            <icon-symbol name="chevron-down-12"/>
          </svg>
          <span class="clipped">Filter Applied</span>
        </button>
        <div class="menu-button__dropdown">
          <span class="filter-menu">
            <div
              class="filter-menu__items"
              role="menu"
              id="pb-docs-filter-content"
              aria-labelledby="pb-docs-filter-trigger"
            >
              <div
                class="filter-menu__item"
                role="menuitemcheckbox"
                aria-checked="true"
                tabindex="0"
              >
                <span class="filter-menu__checkbox">
                  <svg
                    class="icon icon--18 icon--unchecked"
                    height="18"
                    width="18"
                    aria-hidden="true"
                  >
                    <icon-symbol name="checkbox-unchecked-18"/>
                  </svg>
                  <svg
                    class="icon icon--18 icon--checked"
                    height="18"
                    width="18"
                    aria-hidden="true"
                  >
                    <icon-symbol name="checkbox-checked-18"/>
