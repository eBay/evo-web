import { urls } from "../../../../data";
<div id="menu-button-overview">
  <component-banner-img/>

  <p>
    A menu button pairs a trigger button with the content it opens, shown in a
    dropdown below the trigger. The trigger can be a
    <a href=`${urls.components}/button`>button</a> , an
    <a href=`${urls.components}/icon-button`>icon button</a> or a
    <a href=`${urls.components}/filter-chip`>filter chip</a> , and keeps its own
    look.
  </p>
  <p>The dropdown holds one of three menus:</p>
  <ul>
    <li>
      an <a href=`${urls.components}/action-menu`>action menu</a> , for commands
      that run on the current page;
    </li>
    <li>
      a <a href=`${urls.components}/filter-menu`>filter menu</a> , for choices
      that narrow a set of results;
    </li>
    <li>
      a <a href=`${urls.components}/navigation-menu`>navigation menu</a> , for
      links to other pages.
    </li>
  </ul>
  <section
    class="section-notice section-notice--attention"
    role="region"
    aria-label="Attention"
    aria-roledescription="Notice"
  >
    <div class="section-notice__header" id="menu-button-deprecated-notice">
      <svg class="icon icon--16" height="16" width="16" aria-label="Attention">
        <icon-symbol name="attention-filled-16"/>
      </svg>
    </div>
    <div class="section-notice__main">
      <h3 class="section-notice__title">Deprecated</h3>
      <p>
        The older <code>menu-button</code> classes,
        <code>menu-button__button</code> , <code>__menu</code> ,
        <code>__items</code> , <code>__item</code> , <code>__separator</code> ,
        <code>__footer</code> , <code>__option--active</code> and
        <code>menu-button--filter</code> , are deprecated and will be removed in
        the next major version of Skin. Use <code>menu-button__dropdown</code>
        with an <a href=`${urls.components}/action-menu`>action-menu</a> ,
        <a href=`${urls.components}/filter-menu`>filter-menu</a> or
        <a href=`${urls.components}/navigation-menu`>navigation-menu</a> inside
        it instead.
      </p>
    </div>
  </section>
</div>
