import tbLandscapeImg from "/img/tb-landscape-pic.jpg";
static const basePath = import.meta.env.BASE_URL;
<let/open=false>
<let/visible=false>
<script>
  if (open) {
    $dialog().showModal();
    $dialog().addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          open = false;
        }
      },
      {
        signal: $signal,
      },
    );
    $dialog().addEventListener(
      "click",
      (event) => {
        if (event.target === $dialog()) {
          open = false;
        }
      },
      {
        signal: $signal,
      },
    );
    visible = true;
  } else {
    if (visible) {
      $dialog().classList.add("dialog-close");
      $dialog().addEventListener(
        "animationend",
        () => {
          $dialog().close();
          visible = false;
          $dialog().classList.remove("dialog-close");
        },
        {
          signal: $signal,
          once: true,
        },
      );
    }
  }
</script>
<div id="dialog">
  <section-header/>

  <div class="demo">
    <div class="demo__inner">
      <button
        class="btn btn--primary"
        onClick() {
          open = true;
        }
        type="button">
        Open Dialog
      </button>
      <dialog/$dialog class="dialog">
        <div class="dialog__header">
          <h2 id="dialog-title-default" class="large-text-1 bold-text">
            Dialog
          </h2>
          <button
            aria-label="Close dialog"
            class="icon-btn dialog__close"
            type="button"
            onClick() {
              open = false;
            }>
            <svg
              aria-hidden="true"
              class="icon icon--16"
              height="16"
              width="16">
              <icon-symbol name="close-16"/>
            </svg>
          </button>
        </div>
        <div class="dialog__main">
          <p>
