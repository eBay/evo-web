  <component-demo
    component="toggle-button"
    variant="gallery-layout-responsive/mediumButtonWithCSSImageCoverBackground"
  />
  <component-demo
    component="toggle-button"
    variant="gallery-layout-responsive/largeButtonWithCSSImageCoverBackground"
  />

  <h4>Gallery Toggle Button with Icon</h4>

  <p>
    To add an icon to a toggle button, you can use the
    <code>toggle-button__icon</code> block.
  </p>

  <component-demo
    component="toggle-button"
    variant="gallery-layout/iconTitleSubtitle"
  />

  <h4>Disabled Toggle Button</h4>

  <p>
    Toggle buttons may be disabled with <code>disabled</code> or
    <code>aria-disabled="true"</code> .
  </p>

