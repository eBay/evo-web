import "../../../../sass/accessibility.scss";

<div class="a11y-pattern-content">
    <h1>Signal Accessibility</h1>
    <h2>Best Practices</h2>
    <p>
        The signal text${" "}
        <strong>must</strong>
        ${" "}be visible and descriptive to convey its meaning.
    </p>
    <p>
        Signal color alone${" "}
        <strong>must not</strong>
        ${" "}be the only means of conveying information. The text content
        provides the accessible name.
    </p>
    <h2>Interaction Design</h2>
    <h3>Keyboard</h3>
    <p>
        Signals are not interactive and should not be keyboard focusable.
    </p>
    <h3>Screen Reader</h3>
    <p>
        A screen reader${" "}
        <strong>must</strong>
        ${" "}announce the signal text content.
    </p>
    <h3>Pointer</h3>
    <p>
        Signals are not clickable.
    </p>
    <h2>ARIA Reference</h2>
    <p>
        No further ARIA attributes are required. Signals rely on visible text alone.
    </p>
    <h2>Further Reading</h2>
    <ul>
        <li>
            <a href="https://www.w3.org/WAI/WCAG21/Understanding/use-of-color.html">
                WCAG Use of Color
            </a>
        </li>
    </ul>
</div>
