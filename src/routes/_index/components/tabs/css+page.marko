import { urls } from "../../../../data";
<div id="tabs">
  <section-header/>

  <h3 id="tabs-default">Default Tabs</h3>
  <p>
    When a tab is selected, the <code>aria-selected</code> state of all tabs in
    the list must be updated in order for the CSS to reflect the change. Only
    one tab can be selected and in the tab order at any moment in time.
    Likewise, only one tabpanel can be visible at any time, and it must
    correspond to the currently selected tab.
  </p>

  <p>
    Use child element modifier <code>tabs--large</code> to opt into larger
    font-size for tabs.
  </p>

  <p>
    <strong>NOTE:</strong> JavaScript is required to handle tab selection state,
    panel visibility, focus management and arrow-key navigation. For detailed
    behaviour requirements, please visit the
    <a href="https://opensource.ebay.com/mindpatterns/disclosure/tabs/index.html">
      eBay MIND Pattern for Tabs
    </a>
    .
  </p>
  <p>
    To disable a tab, add <code>aria-disabled="true"</code> to the tab to
    disable. Disabled state on the currently selected tab is not valid.
  </p>

  <component-demo component="tabs" variant="block/three"/>

  <h3 id="tabs-fake">Fake Tabs</h3>
  <section
    class="section-notice section-notice--attention"
    role="region"
    aria-label="Attention"
    aria-roledescription="Notice"
  >
    <div class="section-notice__header" id="section-notice-attention">
      <svg class="icon icon--16" height="16" width="16" aria-label="Attention">
        <icon-symbol name="attention-filled-16"/>
      </svg>
    </div>
    <div class="section-notice__main">
      <h4 class="section-notice__title">Deprecated</h4>
      <p>
        The <code>fake-tabs</code> classes are deprecated and will be removed in
        the next major version of Skin. Use
        <a href=`${urls.components}/navigation-tabs`>navigation-tabs</a>
        instead.
      </p>
    </div>
  </section>
  <p>
    A fake tab <em>looks</em> like a normal tab, but is actually a hyperlink to
    a new page. Therefore a set of fake tabs behaves more like a simple
    navigational widget, rather than a dynamic user interface control.
  </p>
  <p>
    If HREF is not present, then the tab will be in disabled state. A value of
    "javascript" (or any such variant) is <strong>not</strong> a valid URL!
  </p>
  <p>
    The <code>aria-current</code> attribute is used to programmatically denote
    the current page state and current link.
  </p>

  <p>
    Use child element modifier <code>fake-tabs--large</code> to opt into larger
    font-size for fake tabs.
  </p>

  <component-demo component="fake-tabs" variant="tabs-fake-tabs-block/three"/>
</div>
