<div id="static-navigation-button">
  <h1>Navigation Button CSS Component</h1>

  <h3 id="navigation-button-default">Default Navigation Button</h3>
  <p>
    Use the <code>navigation-button</code> class on an anchor tag to create a
    minimal, default navigation-button.
  </p>
  <div class="demo">
    <div class="demo__inner">
      <a class="navigation-button" href="https://www.ebay.com">Link</a>
    </div>
  </div>

  <highlight-code type="html">
    <a class="navigation-button" href="https://www.ebay.com">Link</a>
  </highlight-code>

  <p>
    Use the <code>large</code> modifier to increase the size of the
    navigation-button.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <a
        class="navigation-button navigation-button--large"
        href="https://www.ebay.com"
      >
        Large Link
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--large"
      href="https://www.ebay.com"
    >
      Large Link
    </a>
  </highlight-code>

  <p>
    Use the <code>small</code> modifier to decrease the size of the
    navigation-button.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <a
        class="navigation-button navigation-button--small"
        href="https://www.ebay.com"
      >
        Small Link
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--small"
      href="https://www.ebay.com"
    >
      Small Link
    </a>
  </highlight-code>

  <h3 id="navigation-button-primary">Primary Navigation Button</h3>
  <p>
    Use the <code>primary</code> modifier to create a primary navigation-button
    style.
  </p>
  <div class="demo">
    <div class="demo__inner">
      <a
        class="navigation-button navigation-button--primary"
        href="https://www.ebay.com"
      >
        Link
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--primary"
      href="https://www.ebay.com"
    >
      Link
    </a>
  </highlight-code>

  <h3 id="navigation-button-secondary">Secondary Navigation Button</h3>
  <p>
    Use the <code>secondary</code> modifier to create a secondary
    navigation-button style.
  </p>
  <div class="demo">
    <div class="demo__inner">
      <a
        class="navigation-button navigation-button--secondary"
        href="https://www.ebay.com"
      >
        Link
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--secondary"
      href="https://www.ebay.com"
    >
      Link
    </a>
  </highlight-code>

  <h3 id="navigation-button-tertiary">Tertiary Navigation Button</h3>
  <p>
    Use the <code>tertiary</code> modifier to create a tertiary
    navigation-button style.
  </p>
  <div class="demo">
    <div class="demo__inner">
      <a
        class="navigation-button navigation-button--tertiary"
        href="https://www.ebay.com"
      >
        Link
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--tertiary"
      href="https://www.ebay.com"
    >
      Link
    </a>
  </highlight-code>

  <h3 id="navigation-button-disabled">Disabled Navigation Button</h3>
  <p>
    Remove the <code>href</code> attribute to fully disable a navigation-button.
  </p>
  <div class="demo">
    <div class="demo__inner">
      <a class="navigation-button navigation-button--primary">Primary Link</a>
      <a class="navigation-button navigation-button--secondary">
        Secondary Link
      </a>
      <a class="navigation-button navigation-button--tertiary">Tertiary Link</a>
    </div>
  </div>
  <highlight-code type="html">
    <a class="navigation-button navigation-button--primary">Primary Link</a>
    <a class="navigation-button navigation-button--secondary">Secondary Link</a>
    <a class="navigation-button navigation-button--tertiary">Tertiary Link</a>
  </highlight-code>

  <h3 id="navigation-button-partially-disabled">
    Partially Disabled Navigation Button
  </h3>
  <p>
    Use <code>aria-disabled="true"</code> to partially disable a
    navigation-button. This retains keyboard focus while still communicating a
    disabled state, preventing keyboard focus from being moved back to the start
    of the page when focus is lost.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <a
        class="navigation-button navigation-button--primary"
        href="https://www.ebay.com"
        aria-disabled="true"
      >
        Link
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--primary"
      href="https://www.ebay.com"
      aria-disabled="true"
    >
      Link
    </a>
  </highlight-code>

  <h3 id="navigation-button-delete">Destructive Navigation Button</h3>
  <p>
    Use the <code>destructive</code> modifier to create a destructive
    navigation-button style used for removing data.
  </p>

  <h4>Primary Destructive Navigation Button</h4>
  <div class="demo">
    <div class="demo__inner">
      <a
        class="navigation-button navigation-button--primary navigation-button--destructive"
        href="https://www.ebay.com"
      >
        Primary Link
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--primary navigation-button--destructive"
      href="https://www.ebay.com"
    >
      Destructive Link
    </a>
  </highlight-code>

  <h4>Secondary Destructive Navigation Button</h4>
  <div class="demo">
    <div class="demo__inner">
      <a
        class="navigation-button navigation-button--secondary navigation-button--destructive"
        href="https://www.ebay.com"
      >
        Secondary Link
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--secondary navigation-button--destructive"
      href="https://www.ebay.com"
    >
      Secondary Link
    </a>
  </highlight-code>

  <h4>Tertiary Destructive Navigation Button</h4>
  <div class="demo">
    <div class="demo__inner">
      <a
        class="navigation-button navigation-button--tertiary navigation-button--destructive"
        href="https://www.ebay.com"
      >
        Tertiary Link
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--tertiary navigation-button--destructive"
      href="https://www.ebay.com"
    >
      Tertiary Link
    </a>
  </highlight-code>

  <h3 id="navigation-button-icon-adjacent">Adjacent Icon Navigation Button</h3>
  <p>
    Any SVG icon can be placed adjacent to the navigation-button text. To flip
    position of text and icon, simply swap the DOM order.
  </p>
  <div class="demo">
    <div class="demo__inner">
      <a
        class="navigation-button navigation-button--primary"
        href="https://www.ebay.com"
      >
        <span class="navigation-button__cell">
          <svg aria-hidden="true" class="icon icon--24" height="16" width="16">
            <icon-symbol name="menu-24"/>
          </svg>
          <span>Link</span>
        </span>
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--primary"
      href="https://www.ebay.com"
    >
      <span class="navigation-button__cell">
        <svg aria-hidden="true" class="icon icon--24" height="16" width="16">
          <use href="#icon-menu-24"/>
        </svg>
        <span>Link</span>
      </span>
    </a>
  </highlight-code>

  <h3 id="navigation-button-fluid">Fluid Navigation Button</h3>
  <p>
    Use the <code>navigation-button--fluid</code> modifier to make a
    navigation-button fill the width of its container.
  </p>
  <div class="demo">
    <div class="demo__inner">
      <a
        class="navigation-button navigation-button--primary navigation-button--fluid"
        href="https://www.ebay.com"
      >
        Link
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--primary navigation-button--fluid"
      href="https://www.ebay.com"
    >
      Link
    </a>
  </highlight-code>

  <h3 id="navigation-button-fixed-width">Fixed Width Navigation Button</h3>

  <p>
    Navigation buttons naturally grow wider with their text. The text will wrap
    naturally once the navigation-button width grows to exceed its constrained
    width.
  </p>

  <div class="demo">
    <a
      class="navigation-button navigation-button--primary"
      href="https://www.ebay.com"
      style="width: 200px;"
    >
      Link with a lot of text that will wrap
    </a>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--primary"
      href="https://www.ebay.com"
      style="width: 200px;"
    >
      Link with a lot of text that will wrap
    </a>
  </highlight-code>

  <p>
    The solution is to apply truncation, via the
    <code>navigation-button--truncated</code> or
    <code>navigation-button--large-truncated</code> modifiers, combined with a
    fixed height.
  </p>

  <div class="demo">
    <a
      class="navigation-button navigation-button--primary navigation-button--large-fixed-height navigation-button--truncated"
      href="https://www.ebay.com"
      style="width: 200px;"
    >
      Link with a lot of text that will wrap
    </a>
  </div>

  <highlight-code type="html">
    <a
      class="navigation-button navigation-button--primary navigation-button--large-fixed-height navigation-button--truncated"
      href="https://www.ebay.com"
      style="width: 200px;"
    >
      Link with a lot of text that will wrap
    </a>
  </highlight-code>
</div>
