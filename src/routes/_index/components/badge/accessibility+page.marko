import "../../../../sass/accessibility.scss";
import { urls } from "../../../../data";

<div class="a11y-pattern-content">
  <h1>Badge Accessibility</h1>
  <h2>Best Practices</h2>
  <p>
    Standalone badges must use <code>role=&quot;img&quot;</code> with
    <code>aria-label</code> to convey their meaning to assistive technologies.
  </p>
  <p>
    Badges are non-interactive visual indicators. When a badge appears inside an
    interactive element, such as a button, link, or menu item, give that element
    an appropriate accessible name.
  </p>
  <p>
    Also refer related accessibility guidance for badges in an
    <a href=`${urls.components}/icon-button/accessibility`>icon button</a> or
    <a href=`${urls.components}/menu/accessibility`>menu</a>.
  </p>
  <h2>Interaction Design</h2>
  <p>
    This section provides detailed instructions for how different input types
    should navigate and operate the pattern.
  </p>
  <h3>Keyboard</h3>
  <p>
    Badge elements are not interactive by default and therefore should not be
    keyboard focusable.
  </p>
  <p>
    If a badge is placed within an interactive element (such as a button or
    link), the interactive element must be keyboard accessible via
    <strong>TAB</strong> key.
  </p>
  <h3>Screen Reader</h3>
  <p>
    A screen reader will announce a standalone badge as an image along with its
    <code>aria-label</code> value (e.g., “2 notifications, image”).
  </p>
  <h3>Pointer</h3>
  <p>
    Badge elements are not interactive by default and therefore are not
    clickable.
  </p>
  <p>
    If a badge is placed within an interactive element (such as a button or
    link), clicking the badge will activate that interactive element.
  </p>
  <h2>ARIA Reference</h2>
  <table>
    <thead>
      <tr>
        <th>Attribute</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>role=“img”</strong></td>
        <td>
          Applied to a badge to identify it as an image to assistive
          technologies.
        </td>
      </tr>
      <tr>
        <td><strong>aria-label</strong></td>
        <td>
          Applied to a badge with <code>role=&quot;img&quot;</code> to provide
          an accessible name with context (e.g., “2 notifications”).
        </td>
      </tr>
      <tr>
        <td><strong>aria-hidden=“true”</strong></td>
        <td>
          Hides an embedded badge or its wrapper when the containing interactive
          element’s accessible name includes the badge count and meaning.
        </td>
      </tr>
    </tbody>
  </table>
  <h2>Further Reading</h2>
  <ul>
    <li><a href=`${urls.components}/icon-button`>Icon Button</a></li>
    <li><a href=`${urls.components}/menu-button`>Menu Button</a></li>
    <li>
      <a href=`${urls.accessibility}/techniques/background-icon`>
        Background Icon Technique
      </a>
    </li>
  </ul>
</div>
