import "../../../../sass/accessibility.scss";
import { urls } from "../../../../data";

<div class="a11y-pattern-content">
  <h1>Text Button Accessibility</h1>
  <h2>Best Practices</h2>
  <p>
    A text button <strong>must</strong> be a real <code>&lt;button&gt;</code>
    element, never a styled <code>&lt;div&gt;</code> or
    <code>&lt;span&gt;</code> with a click handler. This preserves native
    keyboard operability and the “button” role for assistive technology.
  </p>
  <p>
    Use a text button only when the action triggers JavaScript behaviour. If the
    action navigates to a URL, use a real
    <a href=`${urls.components}/link`>link</a> instead.
  </p>
  <p>
    Disabled state <strong>must</strong> be conveyed with the
    <code>disabled</code> attribute (or <code>aria-disabled="true"</code> for a
    partially disabled, focusable state).
  </p>
  <h2>Interaction Design</h2>
  <p>
    This section provides interaction design for keyboard and screen reader
    users.
  </p>
  <h3>Keyboard</h3>
  <p>
    Text button <strong>must</strong> activate with <code>ENTER</code> or
    <code>SPACEBAR</code> , consistent with native button behaviour.
  </p>
  <h3>Screen Reader</h3>
  <p>Text button <strong>must</strong> announce with a role of “button”.</p>
</div>
