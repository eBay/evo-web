import { urls } from "../../../../data";
<div id="button-link-overview">
  <component-banner-img/>

  <p>
    A link may be styled to <em>look</em> like a
    <a href=`${urls.components}/button`>button</a> . Use
    <code>button-link</code> when the action navigates to a URL, so that the
    <code>&lt;a&gt;</code> tag with a valid <code>href</code> attribute is
    <strong>required</strong> instead of a <code>&lt;button&gt;</code> .
  </p>
  <p>
    The <code>fake-btn</code> class is deprecated and will be removed in the
    next major version of Skin. Use <code>button-link</code> instead.
  </p>
</div>
