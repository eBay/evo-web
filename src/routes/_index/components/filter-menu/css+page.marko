import { urls } from "../../../../data";
<div id="filter-menu">
  <h1>Filter Menu CSS Component</h1>
  <p>
    A filter menu is an ARIA menu of <code>menuitemcheckbox</code> or
    <code>menuitemradio</code> items. Each item sets <code>aria-checked</code> ,
    checked or not, and the checkbox or radio graphic follows it.
  </p>
  <p>
    <strong>NOTE:</strong> Only limited JavaScript behaviour has been
    implemented in these examples. To open a filter menu from a filter chip, see
    <a href=`${urls.components}/menu-button`>menu button</a> .
  </p>

  <h2 id="filter-menu-checkbox">Multiple-Choice Filter Menu</h2>
  <p>
    Each item has a role of <code>menuitemcheckbox</code> . Any number of items
    can be checked.
  </p>
  <div class="demo">
    <div class="demo__inner">
      <span class="filter-menu">
        <div class="filter-menu__items" role="menu" aria-label="Color">
          <div
            class="filter-menu__item"
            role="menuitemcheckbox"
            aria-checked="true"
            tabindex="0"
          >
            <span class="filter-menu__checkbox">
              <svg
                class="icon icon--18 icon--unchecked"
                height="18"
                width="18"
                aria-hidden="true"
              >
                <icon-symbol name="checkbox-unchecked-18"/>
              </svg>
              <svg
                class="icon icon--18 icon--checked"
                height="18"
                width="18"
                aria-hidden="true"
              >
                <icon-symbol name="checkbox-checked-18"/>
              </svg>
            </span>
            <span class="filter-menu__text">Black</span>
          </div>
          <div
            class="filter-menu__item"
            role="menuitemcheckbox"
            aria-checked="false"
          >
            <span class="filter-menu__checkbox">
              <svg
                class="icon icon--18 icon--unchecked"
                height="18"
                width="18"
                aria-hidden="true"
              >
                <icon-symbol name="checkbox-unchecked-18"/>
              </svg>
              <svg
                class="icon icon--18 icon--checked"
                height="18"
                width="18"
                aria-hidden="true"
              >
                <icon-symbol name="checkbox-checked-18"/>
              </svg>
            </span>
            <span class="filter-menu__text">Blue</span>
          </div>
          <div
            class="filter-menu__item"
            role="menuitemcheckbox"
            aria-checked="false"
          >
            <span class="filter-menu__checkbox">
              <svg
                class="icon icon--18 icon--unchecked"
                height="18"
                width="18"
                aria-hidden="true"
              >
                <icon-symbol name="checkbox-unchecked-18"/>
              </svg>
              <svg
                class="icon icon--18 icon--checked"
                height="18"
                width="18"
                aria-hidden="true"
              >
                <icon-symbol name="checkbox-checked-18"/>
              </svg>
            </span>
            <span class="filter-menu__text">
              Red with a long label that wraps to another line
            </span>
          </div>
        </div>
      </span>
    </div>
  </div>

  <highlight-code type="html">
    <span class="filter-menu">
      <div class="filter-menu__items" role="menu" aria-label="Color">
        <div
