<div id="video">
  <section-header/>

  <h3 id="video-base">
    Base Video
  </h3>
  <p>
    The${" "}
    <code>video</code>
    ${" "}block wraps a native${" "}
    <code>&lt;video&gt;</code>
    ${" "}element and a${" "}
    <code>video__controls</code>
    ${" "}bar. The control bar is a flex row that sizes to 100% of the
    container. Time labels are plain${" "}
    <code>&lt;span&gt;</code>
    ${" "}elements — no class needed. The scrubber range input uses${" "}
    <code>video__scrubber</code>
    ${" "}to fill remaining space. All buttons in the bar use${" "}
    <code>video__control</code>
    ${" "}— a bare, unstyled button with only a pressed state.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <div class="video" style="max-width: 640px">
        <video
          src="https://archive.org/download/BigBuckBunny_124/Content/big_buck_bunny_720p_surround.mp4"
          poster="https://peach.blender.org/wp-content/uploads/title_anouncement.jpg?x11217"
          aria-label="sample video"/>
        <div class="video__controls" role="group" aria-label="Video controls">
          <button class="video__control" type="button" aria-label="Play">
            <svg
              class="icon icon--20"
              width="20"
              height="20"
              aria-hidden="true">
              <icon-symbol name="play-20"/>
            </svg>
          </button>
          <span class="video__timestamp">
            0:00
          </span>
          <input
            class="video__scrubber"
            type="range"
            min="0"
            max="100"
            value="0"
            step="0.1"
            aria-label="Seek">
          <span class="video__timestamp">
            1:23
          </span>
          <button class="video__control" type="button" aria-label="Fullscreen">
            <svg
              class="icon icon--20"
              width="20"
              height="20"
              aria-hidden="true">
              <icon-symbol name="expand-16"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <highlight-code type="html">
