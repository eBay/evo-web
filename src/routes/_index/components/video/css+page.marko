  <h3 id="video-overlays">
    Overlays
  </h3>
  <p>
    <code>video__overlay</code>
    ${" "}centers content over the video for error and loading states (add${" "}
    <code>video__overlay--transparent</code>
    ${" "}for a spinner without a scrim).${" "}
    <code>video__play-overlay</code>
    ${" "}is a full-bleed poster play button, and${" "}
    <code>video__nav</code>
    ${" "}is a full-bleed overlay link rendered under the control bar.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <div class="video" style="max-width: 640px">
        <video
          poster="https://peach.blender.org/wp-content/uploads/title_anouncement.jpg?x11217"
          aria-label="sample video"/>
        <div class="video__overlay">
          <svg class="icon icon--24" width="24" height="24" aria-hidden="true">
            <use href="#icon-attention-24"/>
          </svg>
          <div class="video__overlay-text">
            An error has occurred
          </div>
