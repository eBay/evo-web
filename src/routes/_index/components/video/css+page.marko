  <h3 id="video-popover-control">
    Popover Controls
  </h3>
  <p>The control bar may buttons that open popovers</p>

  <div class="demo">
    <div class="demo__inner">
      <div class="video" style="max-width: 640px">
        <video
          src="https://archive.org/download/BigBuckBunny_124/Content/big_buck_bunny_720p_surround.mp4"
          poster="https://peach.blender.org/wp-content/uploads/title_anouncement.jpg?x11217"
          aria-label="sample video"/>
        <div class="video__controls" role="group" aria-label="Video controls">
          <button class="video__control" type="button" aria-label="Play">
            <svg
              class="icon icon--20"
              width="20"
              height="20"
              aria-hidden="true">
              <icon-symbol name="play-20"/>
            </svg>
          </button>
          <span class="video__timestamp">
            0:00
          </span>
          <input
            class="video__scrubber"
            type="range"
            min="0"
            max="100"
            value="0"
            step="0.1"
            aria-label="Seek">
          <span class="video__timestamp">
            1:23
          </span>
          <span class="video__popover-container">
            <button
              class="video__control"
              type="button"
              aria-label="Closed captions"
              aria-expanded="false"
              onClick(_, el) {
                el.ariaExpanded = el.ariaExpanded === "true" ? "false" : "true";
              }>
              <svg
                class="icon icon--20"
                width="20"
                height="20"
                aria-hidden="true">
                <icon-symbol name="closed-caption-24"/>
              </svg>
            </button>
            <span class="video__popover">
              <span class="menu">
                <div role="menu" class="menu__items">
                  <div
                    class="menu__item"
                    role="menuitemradio"
                    aria-checked="false">
                    <span>Off</span>
                  </div>
                </div>
                <div role="menu" class="menu__items">
                  <div
                    class="menu__item"
                    role="menuitemradio"
                    aria-checked="false">
                    <span>English</span>
                  </div>
                </div>
              </span>
            </span>
          </span>
          <span class="video__popover-container">
            <button
              class="video__control"
              type="button"
              aria-label="Volume"
              aria-expanded="true"
              onClick(_, el) {
                el.ariaExpanded = el.ariaExpanded === "true" ? "false" : "true";
              }>
              <svg
                class="icon icon--20"
                width="20"
                height="20"
                aria-hidden="true">
                <icon-symbol name="audio-high-24"/>
              </svg>
            </button>
            <div class="video__popover" id="vol-popover-demo">
              <input
                class="video__volume"
                type="range"
                min="0"
                max="100"
                value="80"
                aria-label="Volume">
            </div>
          </span>
          <button class="video__control" type="button" aria-label="Fullscreen">
            <svg
              class="icon icon--20"
              width="20"
              height="20"
              aria-hidden="true">
              <icon-symbol name="expand-16"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
