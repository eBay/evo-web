<div id="star-rating-select">
  <section-header/>
  <p>
    <strong>NOTE:</strong> The filled visual marking of all stars previous to
    the currently selected star rating follows the checked radio. Browsers
    without <code>:has()</code> support still require JavaScript to set the
    <code>star-rating-select__control--filled</code> modifier on those stars.
  </p>
  <h3>Star Rating Select with Visual Semantic Grouping</h3>
  <p>
    This instance of star rating select uses visible HTML <code>fieldset</code>
    and <code>legend</code> for semantic grouping.
  </p>

  <component-demo component="star-rating-select" variant="withFieldset"/>

  <h3>Star Rating Select with Invisible ARIA Semantic Grouping</h3>
  <p>
    This instance of star rating select uses an invisible ARIA radio group for
    semantic grouping.
  </p>
  <component-demo component="star-rating-select" variant="empty"/>
</div>
export const metadata = {
  component: "star-rating-select",
  "ds-component": {
    name: "review-input",
    version: 1,
  },
};

<script>
  document.querySelectorAll(".star-rating-select").forEach(function (widgetEl) {
    widgetEl.addEventListener("change", function (e: Event) {
      const selectedIndex = parseInt((e.target as HTMLInputElement).value) - 1;
      widgetEl.querySelectorAll("input").forEach(function (inputEl, index) {
        inputEl.classList.toggle(
          "star-rating-select__control--filled",
          index < selectedIndex,
        );
      });
    });
  });
</script>
