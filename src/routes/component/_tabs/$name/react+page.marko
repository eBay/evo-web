$ const name = $global.params.name;

<await(import(`../${name}/+meta.json`))>
  <@then|metadata|>
    <div id=`${name}-react`>
        <h1>${metadata.title} React Component</h1>
        <p>
            React components in Evo are managed and presented through storybook.
        </p>

        <a class="fake-btn fake-btn--primary" href=metadata.reactStorybookURL target="_blank">
            <span class="fake-btn__cell">
                <span>React ${metadata.title} Storybook</span>
                <svg class="icon icon--16" height="16" width="16" aria-hidden="true">
                    <use href="#icon-external-link-16" />
                </svg>
            </span>
        </a>
    </div>
  </@then>
</await>

