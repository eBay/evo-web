{
    "name": "@ebay/ui-core-react",
    "version": "9.3.1",
    "description": "Skin components build off React",
    "keywords": [
        "React",
        "Skin",
        "EbayUI"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eBay/evo-web.git",
        "directory": "packages/ebayui-core-react"
    },
    "license": "ISC",
    "author": "tmanyanov@ebay.com",
    "exports": {
        "./package.json": "./package.json",
        "./icons/*": {
            "types": "./ebay-icon/icons/*.d.ts",
            "default": "./icons/*/index.js"
        },
        "./*": {
            "types": "./*/index.d.ts",
            "default": "./*/index.js"
        }
    },
    "scripts": {
        "build": "npm run clean && npm run type:check && vitest run && vite build && npm run copy && npm run smoke-test",
        "build:storybook": "storybook build",
        "clean": "node scripts/clean",
        "generate-locale-info": "node scripts/generate-locale-info.js",
        "copy": "copyfiles package.json README.md dist && npm run copy:rest",
        "copy:rest": "copyfiles 'src/**/*.md' dist -u 1",
        "coverage": "npm run clean && npm run test -- --coverage --ci",
        "deploy": "NODE_OPTIONS=--max-old-space-size=8192 storybook build -o ./_site/$(git branch --show-current)",
        "format": "eslint . --fix 'src/**/*.{ts,tsx}' && prettier . --write --log-level=warn",
        "lint": "eslint . --ext .ts,.tsx && prettier . --check --log-level=warn",
        "release": "vite build && npm run copy",
        "smoke-test": "concurrently --kill-others-on-fail \"npm run smoke-test:react-16\" \"npm run smoke-test:react-18\" \"npm run smoke-test:react-19\"",
        "smoke-test:react-16": "cd ./smoke-tests/react-16 && npm ci && npm run test",
        "smoke-test:react-18": "cd ./smoke-tests/react-18 && npm ci && npm run test",
        "smoke-test:react-19": "cd ./smoke-tests/react-19 && npm ci && npm run test",
        "start": "NODE_OPTIONS=--openssl-legacy-provider storybook dev -p 9001 -c .storybook --no-open",
        "storybook": "NODE_OPTIONS=--openssl-legacy-provider storybook dev -p 9001 -c .storybook --no-open",
        "test": "vitest run",
        "type:check": "tsc --noEmit",
        "update-icons": "node ./scripts/update-icons",
        "version": "npm run update-icons && git add -A src"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.md": [
            "prettier --write"
        ]
    },
    "resolutions": {
        "string-width": "4.2.3"
    },
    "dependencies": {
        "@floating-ui/react": "^0.27.17",
        "classnames": "^2.5.1",
        "makeup-active-descendant": "^0.7.11",
        "makeup-expander": "^0.11.10",
        "makeup-floating-label": "^0.4.9",
        "makeup-focusables": "^0.4.6",
        "makeup-keyboard-trap": "^0.5.8",
        "makeup-prevent-scroll-keys": "^0.3.5",
        "makeup-roving-tabindex": "^0.7.8",
        "makeup-screenreader-trap": "^0.5.7",
        "makeup-typeahead": "^0.3.5",
        "react-remove-scroll": "^2.7.2"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.1.3"
    },
    "peerDependencies": {
        "@ebay/skin": "^19",
        "react": "^19",
        "react-dom": "^19"
    },
    "optionalDependencies": {
        "shaka-player": "^5.0.2"
    },
    "publishConfig": {
        "directory": "dist"
    }
}
