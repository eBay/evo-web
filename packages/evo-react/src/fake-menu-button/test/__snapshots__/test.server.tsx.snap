exports[`EvoFakeMenuButton SSR > renders a closed text trigger 1`] = `"<span class="fake-menu-button"><button type="button" aria-expanded="false" aria-controls="_R_0_" class="btn fake-menu-button__button btn--secondary"><span class="btn__cell"><span class="btn__text">Account options</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-chevron-down-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-chevron-down-16"><path d="M8.707 12.707a1 1 0 0 1-1.414 0l-6-6a1 1 0 0 1 1.414-1.414L8 10.586l5.293-5.293a1 1 0 1 1 1.414 1.414l-6 6Z"/></symbol></defs></svg></span></button></span>"`;

exports[`EvoFakeMenuButton SSR > renders an icon trigger 1`] = `"<span class="fake-menu-button"><button aria-expanded="false" aria-controls="_R_0_" type="button" aria-label="More actions" class="fake-menu-button__button icon-btn"><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-overflow-vertical-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-overflow-vertical-16"><path d="M8 4.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm0 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM9.5 8a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/></symbol></defs></svg></button></span>"`;

exports[`EvoFakeMenuButton SSR > renders an initially open menu with named regions 1`] = `"<span class="fake-menu-button"><button type="button" aria-expanded="true" aria-controls="_R_0_" class="btn fake-menu-button__button btn--secondary"><span class="btn__cell"><span class="btn__text"><span class="menu-button-prefix-label">Account:</span> <!-- -->Options</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-chevron-down-16"></use></svg></span></button><span id="_R_0_" tabindex="-1" style="position:absolute;left:0;top:0;visibility:hidden" class="fake-menu-button__menu fake-menu-button__menu--reverse fake-menu-button__menu--fix-width"><ul class="fake-menu__items" tabindex="-1"><li><a href="/orders" class="fake-menu-button__item"><span>Orders</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-tick-16"><path fill-rule="evenodd" d="M13.707 5.707a1 1 0 0 0-1.414-1.414L6 10.586 3.707 8.293a1 1 0 0 0-1.414 1.414l3 3a1 1 0 0 0 1.414 0l7-7Z" clip-rule="evenodd"/></symbol></defs></svg></a></li><li><button type="button" class="fake-menu-button__item"><span>Sign out</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></button></li></ul></span></span>"`;
