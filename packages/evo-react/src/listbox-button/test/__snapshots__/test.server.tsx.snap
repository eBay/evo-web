exports[`EvoListboxButton SSR > renders a div wrapper when truncated and not fluid 1`] = `"<div class="listbox-button"><button type="button" class="listbox-button__control btn btn--form btn--truncated" aria-label="Shipping region" aria-haspopup="listbox" aria-expanded="false" aria-controls="_R_0_-listbox"><span class="btn__cell"><span id="_R_0_-label" class="btn__text">-</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-chevron-down-16"></use></svg></span></button><div class="listbox-button__listbox" style="position:absolute;left:0;top:0"><div id="_R_0_-listbox" role="listbox" aria-label="Shipping region" tabindex="-1" class="listbox-button__options"><div id="_R_5_-option-0" role="option" tabindex="-1" aria-selected="false" class="listbox-button__option" data-value="US"><span class="listbox-button__value">United States</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></div></div><select hidden="" class="listbox-button__native"><option value="US" selected="">United States</option></select></div></div>"`;

exports[`EvoListboxButton SSR > renders an open form variant with an external label 1`] = `"<span class="listbox-button listbox-button--fluid listbox-button--form"><button type="button" class="listbox-button__control btn btn--form" aria-haspopup="listbox" aria-expanded="true" aria-controls="_R_0_-listbox" aria-invalid="true" aria-labelledby="shipping-label _R_0_-label"><span class="btn__cell"><span id="_R_0_-label" class="btn__text">-</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-chevron-down-16"></use></svg></span></button><div class="listbox-button__listbox" style="position:absolute;left:0;top:0;visibility:hidden"><div id="_R_0_-listbox" aria-labelledby="shipping-label" role="listbox" tabindex="0" class="listbox-button__options"><div id="_R_5_-option-0" role="option" tabindex="-1" aria-selected="false" class="listbox-button__option" data-value="1"><span class="listbox-button__value">Standard delivery</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></div></div><select hidden="" class="listbox-button__native"><option value="1" selected="">Standard delivery</option></select></div></span>"`;

exports[`EvoListboxButton SSR > renders the default button and hidden form select 1`] = `"<span class="listbox-button"><button type="button" value="CA" class="listbox-button__control btn btn--form" aria-haspopup="listbox" aria-expanded="false" aria-controls="_R_0_-listbox"><span class="btn__cell"><span class="btn__label">Shipping region</span><span id="_R_0_-label" class="btn__text">Canada</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-chevron-down-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-chevron-down-16"><path d="M8.707 12.707a1 1 0 0 1-1.414 0l-6-6a1 1 0 0 1 1.414-1.414L8 10.586l5.293-5.293a1 1 0 1 1 1.414 1.414l-6 6Z"/></symbol></defs></svg></span></button><div class="listbox-button__listbox" style="position:absolute;left:0;top:0"><div id="_R_0_-listbox" role="listbox" aria-label="Shipping region" tabindex="-1" class="listbox-button__options"><div id="_R_5_-option-0" role="option" tabindex="-1" aria-selected="false" class="listbox-button__option" data-value="US"><span class="listbox-button__value">United States</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-tick-16"><path fill-rule="evenodd" d="M13.707 5.707a1 1 0 0 0-1.414-1.414L6 10.586 3.707 8.293a1 1 0 0 0-1.414 1.414l3 3a1 1 0 0 0 1.414 0l7-7Z" clip-rule="evenodd"/></symbol></defs></svg></div><div id="_R_5_-option-1" role="option" tabindex="-1" aria-selected="true" class="listbox-button__option" data-value="CA"><span class="listbox-button__value">Canada<span class="clipped">selected</span></span><div class="listbox-button__description">International</div><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></div></div><select hidden="" class="listbox-button__native" name="region"><option value="US">United States</option><option value="CA" selected="">Canada</option></select></div></span>"`;
