exports[`EvoInlineNotice SSR > renders a labeled information notice 1`] = `"<div class="inline-notice inline-notice--information"><span class="inline-notice__header"><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-label="Shipping information" role="img"><use xlink:href="#icon-information-filled-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-information-filled-16"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0Zm1 11a1 1 0 1 1-2 0V8a1 1 0 0 1 2 0v3ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/></symbol></defs></svg></span><span class="inline-notice__main">Delivery dates have changed.</span></div>"`;

exports[`EvoInlineNotice SSR > renders an attention notice by default 1`] = `"<div class="inline-notice inline-notice--attention"><span class="inline-notice__header"><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-label="Attention" role="img"><use xlink:href="#icon-attention-filled-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-attention-filled-16"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0Zm0 12a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm1-4a1 1 0 1 1-2 0V5a1 1 0 0 1 2 0v3Z"/></symbol></defs></svg></span><span class="inline-notice__main">Update your payment method.</span></div>"`;

exports[`EvoInlineNotice SSR > renders nothing while hidden 1`] = `""`;
