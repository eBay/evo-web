exports[`EvoProgressBarExpressive SSR > renders a custom accessible label 1`] = `"<div class="progress-bar-expressive"><div role="progressbar" aria-label="Uploading photos" class="progress-bar-expressive__progress"><div class="progress-bar-expressive__lines"><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div></div></div></div>"`;

exports[`EvoProgressBarExpressive SSR > renders a single message 1`] = `"<div class="progress-bar-expressive"><div class="progress-bar-expressive__messages"><div role="status" id="_R_0_" class="progress-bar-expressive__message progress-bar-expressive__message--in progress-bar-expressive__message--initial"></div></div><div role="progressbar" aria-label="Loading" aria-describedby="_R_0_" class="progress-bar-expressive__progress"><div class="progress-bar-expressive__lines"><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div><div class="progress-bar-expressive__line"></div></div></div></div>"`;

