exports[`EvoSegmentedButtons SSR > renders a large icon segment 1`] = `"<div class="segmented-buttons segmented-buttons--large"><ul aria-label="Preview"><li><button type="button" class="segmented-buttons__button" aria-current="true"><span class="segmented-buttons__button-cell"><svg class="icon icon--24" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-full-view-24"></use><defs><symbol viewBox="0 0 24 24" id="icon-full-view-24"><path d="M22 3H2a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h20a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1Zm-1 12H3V5h18v10ZM2 19h20a1 1 0 0 1 0 2H2a1 1 0 0 1 0-2Z"/></symbol></defs></svg><span>Desktop</span></span></button></li></ul></div>"`;

exports[`EvoSegmentedButtons SSR > renders a selected segment and preserves list markup 1`] = `"<div id="listing-status" class="segmented-buttons"><ul aria-label="Listing status"><li><button type="button" class="segmented-buttons__button" aria-current="true">Active</button></li><li><button type="button" class="segmented-buttons__button">Sold</button></li></ul></div>"`;

exports[`EvoSegmentedButtons SSR > renders no current button when selected is null 1`] = `"<div class="segmented-buttons"><ul aria-label="Listing status"><li><button type="button" class="segmented-buttons__button">Active</button></li></ul></div>"`;
