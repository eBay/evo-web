exports[`EvoDialog SSR > renders the expressive composition 1`] = `"<dialog closedby="any" aria-labelledby="_R_0_" class="dialog dialog--expressive"><div class="dialog__image" style="background-image:url(https://example.com/banner.jpg);background-position:top"></div><div class="dialog__header"><button type="button" aria-label="Back" class="dialog__prev icon-btn"><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-chevron-left-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-chevron-left-16"><path d="M3.293 8.708a1 1 0 0 1 0-1.415l6-6a1 1 0 0 1 1.414 1.414L5.414 8l5.293 5.293a1 1 0 0 1-1.414 1.414l-6-6Z"/></symbol></defs></svg></button><h2 id="_R_0_" class="dialog__title">Dialog Title</h2><button type="button" aria-label="Close Dialog" class="dialog__close icon-btn"><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-close-16"></use></svg></button></div><div class="dialog__main">Dialog content</div><div class="dialog__footer"><button class="btn btn--secondary">Done</button></div></dialog>"`;

