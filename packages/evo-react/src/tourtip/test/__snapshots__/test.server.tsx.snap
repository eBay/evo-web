exports[`EvoTourtip SSR > renders a closed tourtip with default span host and labelled content 1`] = `"<span class="tourtip"><span class="tourtip__host" aria-expanded="false" aria-controls="_R_0_">Seller tools</span><span aria-label="Seller tools guide" id="_R_0_" role="region" class="tourtip__overlay" style="position:absolute;left:0;top:0"><span class="tourtip__pointer"></span><span class="tourtip__mask"><span class="tourtip__cell"><span class="tourtip__content">Find your listing tools here.</span><button type="button" aria-label="Dismiss guide" class="icon-btn icon-btn--transparent tourtip__close"><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-close-16"></use></svg></button></span></span></span></span>"`;

exports[`EvoTourtip SSR > renders a named tourtip with footer 1`] = `"<span class="tourtip tourtip--expanded"><button type="button" aria-expanded="true" aria-controls="_R_0_" class="btn tourtip__host btn--secondary">Seller tools</button><span id="_R_0_" role="region" aria-labelledby="_R_5_" class="tourtip__overlay" style="position:absolute;left:0;top:0;visibility:hidden"><span class="tourtip__pointer"></span><span class="tourtip__mask"><span class="tourtip__cell"><span class="tourtip__content"><h2 id="_R_5_" class="tourtip__heading">Manage listings</h2><p>Find your listing tools here.</p></span><button type="button" aria-label="Dismiss guide" class="icon-btn icon-btn--transparent tourtip__close"><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-close-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-close-16"><path d="M2.293 2.293a1 1 0 0 1 1.414 0L8 6.586l4.293-4.293a1 1 0 1 1 1.414 1.414L9.414 8l4.293 4.293a1 1 0 0 1-1.414 1.414L8 9.414l-4.293 4.293a1 1 0 0 1-1.414-1.414L6.586 8 2.293 3.707a1 1 0 0 1 0-1.414Z"/></symbol></defs></svg></button><span class="tourtip__footer"><span class="tourtip__index">1 of 3</span>Next</span></span></span></span></span>"`;
