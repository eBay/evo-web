exports[`EvoToastDialog SSR > renders closed state and named structure 1`] = `"<dialog aria-modal="false" aria-live="polite" closedby="closerequest" aria-labelledby="_R_0_" class="toast-dialog toast-dialog--close"><div class="toast-dialog__window"><div class="toast-dialog__header"><h2 id="_R_0_" class="toast-dialog__title">Draft saved</h2><button type="button" aria-label="Close draft saved message" class="toast-dialog__close icon-btn icon-btn--transparent"><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-close-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-close-16"><path d="M2.293 2.293a1 1 0 0 1 1.414 0L8 6.586l4.293-4.293a1 1 0 1 1 1.414 1.414L9.414 8l4.293 4.293a1 1 0 0 1-1.414 1.414L8 9.414l-4.293 4.293a1 1 0 0 1-1.414-1.414L6.586 8 2.293 3.707a1 1 0 0 1 0-1.414Z"/></symbol></defs></svg></button></div><div class="toast-dialog__main">Continue editing when ready.</div><div class="toast-dialog__footer"><button type="button" class="btn btn--secondary">View draft</button></div></div></dialog>"`;

