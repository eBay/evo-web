// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`EvoToggleButtonGroup SSR > renders a selected item with an external label 1`] = `"<h2 id="condition-heading">Listing condition</h2><div class="toggle-button-group"><ul aria-labelledby="condition-heading"><li><button type="button" class="toggle-button toggle-button--list-layout" aria-pressed="false"><div class="toggle-button__content"><p class="toggle-button__title">New</p></div></button></li><li><button type="button" class="toggle-button toggle-button--list-layout" aria-pressed="true"><div class="toggle-button__content"><p class="toggle-button__title">Used</p></div></button></li></ul></div>"`;

exports[`EvoToggleButtonGroup SSR > renders the wrapper, list, and unpressed items 1`] = `"<div class="toggle-button-group" data-columns-min="2"><ul aria-label="Listing condition"><li><button type="button" class="toggle-button toggle-button--minimal-layout" aria-pressed="false"><div class="toggle-button__content"><p class="toggle-button__title">New</p></div></button></li><li><button type="button" class="toggle-button toggle-button--minimal-layout" aria-pressed="false"><div class="toggle-button__content"><p class="toggle-button__title">Used</p></div></button></li></ul></div>"`;
