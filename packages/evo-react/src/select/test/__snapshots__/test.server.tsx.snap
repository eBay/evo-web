exports[`EvoSelect SSR > renders a floating label, native option group, and large treatment 1`] = `"<span class="floating-label floating-label--large"><label class="floating-label__label floating-label__label--animate floating-label__label--invalid floating-label__label--inline" for="_R_0_">Shipping method</label><span class="select select--large"><select aria-invalid="true" id="_R_0_"><option value="">Choose</option><optgroup label="Domestic"><option value="express">Express</option></optgroup></select><svg height="8" width="8" class="icon icon--12" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-chevron-down-12"></use></svg></span></span>"`;

