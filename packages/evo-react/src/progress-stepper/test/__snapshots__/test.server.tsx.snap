exports[`EvoProgressStepper SSR > renders a vertical list and custom heading element 1`] = `"<div aria-labelledby="_R_0_" class="progress-stepper progress-stepper--vertical"><h3 id="_R_0_" class="clipped">Order progress</h3><div role="list" class="progress-stepper__items"><div data-step="first" role="listitem" aria-current="step" class="progress-stepper__item"><div class="progress-stepper__icon"><svg width="24" height="24" class="icon icon--24" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-labelledby="icon-title-_R_1l_" role="img"><title id="icon-title-_R_1l_">current</title><use xlink:href="#icon-stepper-confirmation-24"></use></svg></div><div class="progress-stepper__text"><h5>Paid</h5><p>Payment received</p></div></div></div></div>"`;

exports[`EvoProgressStepper SSR > renders active state with stable indices 1`] = `"<div aria-labelledby="_R_0_" class="progress-stepper"><h2 id="_R_0_" class="clipped">Shipment progress</h2><div role="list" class="progress-stepper__items"><div role="listitem" class="progress-stepper__item"><div class="progress-stepper__icon"><svg width="24" height="24" class="icon icon--24" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-labelledby="icon-title-_R_6d_" role="img"><title id="icon-title-_R_6d_">complete</title><use xlink:href="#icon-stepper-confirmation-24"></use><defs><symbol viewBox="0 0 24 24" id="icon-stepper-confirmation-24"><path d="M0 12C0 5.373 5.373 0 12 0c3.183 0 6.235 1.264 8.485 3.515A11.996 11.996 0 0124 12c0 6.627-5.373 12-12 12S0 18.627 0 12zm10.71 4.71l8-8h-.01a1 1 0 00-1.41-1.41L10 14.59 6.71 11.3a1 1 0 00-1.41 1.41l4 4a1 1 0 001.41 0z" fill="var(--progress-stepper-confirmation-icon, var(--color-background-accent))"/></symbol></defs></svg></div><div class="progress-stepper__text"><h4>Ordered</h4><p>Payment received</p></div></div><hr class="progress-stepper__separator" role="presentation"/><div role="listitem" aria-current="step" class="progress-stepper__item"><div class="progress-stepper__icon"><svg width="24" height="24" class="icon icon--24" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-labelledby="icon-title-_R_6l_" role="img"><title id="icon-title-_R_6l_">current</title><use xlink:href="#icon-stepper-confirmation-24"></use></svg></div><div class="progress-stepper__text"><h4>Shipped</h4><p>Package is on its way</p></div></div><hr class="progress-stepper__separator" role="presentation"/><div role="listitem" class="progress-stepper__item"><div class="progress-stepper__icon"><svg width="24" height="24" class="icon icon--24" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-labelledby="icon-title-_R_6t_" role="img"><title id="icon-title-_R_6t_">upcoming</title><use xlink:href="#icon-stepper-upcoming-24"></use><defs><symbol viewBox="0 0 24 25" fill="none" id="icon-stepper-upcoming-24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2.5C6.47759 2.5 2 6.97649 2 12.5C2 18.0223 6.47775 22.5 12 22.5C17.5223 22.5 22 18.0223 22 12.5C22 6.97649 17.5224 2.5 12 2.5ZM0 12.5C0 5.87176 5.37318 0.5 12 0.5C18.6268 0.5 24 5.87176 24 12.5C24 19.1268 18.6268 24.5 12 24.5C5.37318 24.5 0 19.1268 0 12.5Z" fill="var(--progress-stepper-upcoming-icon, var(--color-border-medium))"/></symbol></defs></svg></div><div class="progress-stepper__text"><h4>Delivered</h4><p>Awaiting delivery</p></div></div></div></div>"`;

