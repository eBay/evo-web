exports[`EvoFilePreviewCardGroup SSR > renders a controlled subset and its remaining count 1`] = `"<div class="file-preview-card-group"><ul><li class="file-preview-card"><div class="file-preview-card__body"><svg class="icon icon--24 file-preview-card__asset" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-file-24"></use></svg><div class="file-preview-card__info">CSV</div></div></li><li class="file-preview-card"><div class="file-preview-card__body"><svg class="icon icon--24 file-preview-card__asset" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-file-24"></use></svg><div class="file-preview-card__info">CSV</div></div></li><li class="file-preview-card"><div class="file-preview-card__body"><svg class="icon icon--24 file-preview-card__asset" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-file-24"></use></svg><button type="button" aria-label="See more files" class="file-preview-card__see-more"><span>+<!-- -->15</span></button><div class="file-preview-card__info">CSV</div></div></li></ul></div>"`;

