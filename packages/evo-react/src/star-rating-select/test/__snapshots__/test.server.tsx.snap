exports[`EvoStarRatingSelect SSR > renders disabled radios with an external legend 1`] = `"<fieldset><legend id="rating-legend">Rate your purchase</legend><div aria-labelledby="rating-legend" role="radiogroup" class="star-rating-select"><span class="star-rating-select__radio"><input aria-label="1 star" class="star-rating-select__control star-rating-select__control--filled" type="radio" disabled="" name="evo-star-rating-_R_2_" value="1"/><span class="star-rating-select__radio-icon"><svg class="icon icon--star-dynamic star-rating__icon" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-star-dynamic"></use></svg></span></span><span class="star-rating-select__radio"><input aria-label="2 stars" class="star-rating-select__control star-rating-select__control--filled" type="radio" disabled="" name="evo-star-rating-_R_2_" checked="" value="2"/><span class="star-rating-select__radio-icon"><svg class="icon icon--star-dynamic star-rating__icon" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-star-dynamic"></use></svg></span></span><span class="star-rating-select__radio"><input aria-label="3 stars" class="star-rating-select__control" type="radio" disabled="" name="evo-star-rating-_R_2_" value="3"/><span class="star-rating-select__radio-icon"><svg class="icon icon--star-dynamic star-rating__icon" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-star-dynamic"></use></svg></span></span><span class="star-rating-select__radio"><input aria-label="4 stars" class="star-rating-select__control" type="radio" disabled="" name="evo-star-rating-_R_2_" value="4"/><span class="star-rating-select__radio-icon"><svg class="icon icon--star-dynamic star-rating__icon" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-star-dynamic"></use></svg></span></span><span class="star-rating-select__radio"><input aria-label="5 stars" class="star-rating-select__control" type="radio" disabled="" name="evo-star-rating-_R_2_" value="5"/><span class="star-rating-select__radio-icon"><svg class="icon icon--star-dynamic star-rating__icon" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-star-dynamic"></use></svg></span></span></div></fieldset>"`;

exports[`EvoStarRatingSelect SSR > renders five labeled radios with a selected value 1`] = `"<div role="radiogroup" aria-label="Rate your purchase" class="star-rating-select"><span class="star-rating-select__radio"><input aria-label="1 star" class="star-rating-select__control star-rating-select__control--filled" type="radio" name="purchase-rating" value="1"/><span class="star-rating-select__radio-icon"><svg class="icon icon--star-dynamic star-rating__icon" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-star-dynamic"></use><defs><symbol viewBox="0 0 16 16" id="icon-star-dynamic"><path d="M8.596 1.928a.625.625 0 0 0-1.19 0L6.055 6.136H1.62a.625.625 0 0 0-.346 1.146l3.56 2.364-1.366 4.035a.625.625 0 0 0 .953.71L8 11.862l3.578 2.528a.625.625 0 0 0 .953-.71l-1.366-4.036 3.55-2.364a.625.625 0 0 0-.346-1.145H9.955l-1.36-4.207Z" fill="var(--color-star-rating-full, transparent)" stroke="var(--color-star-rating-full-stroke, #707070)" stroke-width="1.25"/><path d="M8.596 1.928a.625.625 0 0 0-1.19 0L6.055 6.136H1.62a.625.625 0 0 0-.346 1.146l3.56 2.364-1.366 4.035a.625.625 0 0 0 .953.71L8 11.862l3.578 2.528a.625.625 0 0 0 .953-.71l-1.366-4.036 3.55-2.364a.625.625 0 0 0-.346-1.145H9.955l-1.36-4.207Z" fill="var(--color-star-rating-half, transparent)" stroke="var(--color-star-rating-half-stroke, #707070)" stroke-width="1.25" clip-path="polygon(0 0, 50% 0, 50% 100%, 0 100%)"/></symbol></defs></svg></span></span><span class="star-rating-select__radio"><input aria-label="2 stars" class="star-rating-select__control star-rating-select__control--filled" type="radio" name="purchase-rating" value="2"/><span class="star-rating-select__radio-icon"><svg class="icon icon--star-dynamic star-rating__icon" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-star-dynamic"></use></svg></span></span><span class="star-rating-select__radio"><input aria-label="3 stars" class="star-rating-select__control star-rating-select__control--filled" type="radio" name="purchase-rating" checked="" value="3"/><span class="star-rating-select__radio-icon"><svg class="icon icon--star-dynamic star-rating__icon" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-star-dynamic"></use></svg></span></span><span class="star-rating-select__radio"><input aria-label="4 stars" class="star-rating-select__control" type="radio" name="purchase-rating" value="4"/><span class="star-rating-select__radio-icon"><svg class="icon icon--star-dynamic star-rating__icon" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-star-dynamic"></use></svg></span></span><span class="star-rating-select__radio"><input aria-label="5 stars" class="star-rating-select__control" type="radio" name="purchase-rating" value="5"/><span class="star-rating-select__radio-icon"><svg class="icon icon--star-dynamic star-rating__icon" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-star-dynamic"></use></svg></span></span></div>"`;
