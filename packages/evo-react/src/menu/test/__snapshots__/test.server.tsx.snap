exports[`EvoMenu SSR > applies prefixed menu classes 1`] = `"<span class="menu-button__menu menu-button__menu--reverse menu-button__menu--fixed menu-button__menu--fix-width"><div aria-label="Actions" role="menu" tabindex="-1" class="menu-button__items"><div role="menuitem" tabindex="-1" class="menu-button__item"><span>Open</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></div></div></span>"`;

exports[`EvoMenu SSR > renders command items, a badge, a separator, and a footer 1`] = `"<span class="menu"><div aria-label="Actions" role="menu" tabindex="-1" class="menu__items"><div role="menuitem" tabindex="-1" class="menu__item"><span>Messages<span class="badge badge--circle" aria-label="5 unread messages">5</span></span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-tick-16"><path fill-rule="evenodd" d="M13.707 5.707a1 1 0 0 0-1.414-1.414L6 10.586 3.707 8.293a1 1 0 0 0-1.414 1.414l3 3a1 1 0 0 0 1.414 0l7-7Z" clip-rule="evenodd"/></symbol></defs></svg></div><hr class="menu__separator"/><div role="menuitem" aria-disabled="true" tabindex="-1" class="menu__item"><span>Disabled</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></div></div><div class="menu__footer"><button class="btn btn--secondary">Apply</button></div></span>"`;

exports[`EvoMenu SSR > renders selected radio and checkbox items 1`] = `"<span class="menu"><div aria-label="Preferences" role="menu" tabindex="-1" class="menu__items"><div role="menuitemradio" data-value="price" aria-checked="true" tabindex="-1" class="menu__item"><span>Price</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></div><div role="menuitemradio" data-value="distance" aria-checked="false" tabindex="-1" class="menu__item"><span>Distance</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></div><div role="menuitemcheckbox" data-value="shipping" aria-checked="true" tabindex="-1" class="menu__item"><span>Shipping</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></div><div role="menuitemcheckbox" data-value="returns" aria-checked="false" tabindex="-1" class="menu__item"><span>Returns</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></div></div></span>"`;

