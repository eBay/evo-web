// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`EvoFakeMenu SSR > applies positioning and prefixed classes 1`] = `"<span class="fake-menu-button__menu fake-menu-button__menu--reverse fake-menu-button__menu--fixed fake-menu-button__menu--fix-width custom-menu"><ul class="fake-menu__items custom-items" tabindex="-1"><li><a href="/account" class="fake-menu-button__item custom-item"><span>Account</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></a></li><li><hr class="fake-menu-button__separator custom-separator"/></li></ul></span>"`;

exports[`EvoFakeMenu SSR > renders an anchor item with a custom link component 1`] = `"<span class="fake-menu"><ul class="fake-menu__items" tabindex="-1"><li><a data-custom-link="true" href="/account" class="fake-menu__item"><span>Account</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></a></li></ul></span>"`;

exports[`EvoFakeMenu SSR > renders button items and disabled states 1`] = `"<span class="fake-menu"><ul class="fake-menu__items" tabindex="-1"><li><button type="submit" class="fake-menu__item"><span>Submit</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></button></li><li><button type="button" disabled="" class="fake-menu__item"><span>Disabled button</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></button></li><li><a aria-disabled="true" class="fake-menu__item"><span>Disabled link</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></a></li></ul></span>"`;

exports[`EvoFakeMenu SSR > renders links, current state, a badge, and a separator 1`] = `"<span class="fake-menu"><ul class="fake-menu__items" tabindex="-1"><li><a href="/messages" class="fake-menu__item"><span>Messages<span class="badge badge--circle" aria-label="5 unread messages">5</span></span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-tick-16"><path fill-rule="evenodd" d="M13.707 5.707a1 1 0 0 0-1.414-1.414L6 10.586 3.707 8.293a1 1 0 0 0-1.414 1.414l3 3a1 1 0 0 0 1.414 0l7-7Z" clip-rule="evenodd"/></symbol></defs></svg></a></li><li><a href="/account" aria-current="page" class="fake-menu__item"><span>Account</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use></svg></a></li><li><hr class="fake-menu__separator"/></li></ul></span>"`;
