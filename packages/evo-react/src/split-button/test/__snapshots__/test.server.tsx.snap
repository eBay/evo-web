exports[`EvoSplitButton SSR > renders an anchor action and open menu 1`] = `"<span class="split-button"><a class="fake-btn fake-btn--secondary fake-btn--large fake-btn--split-start fake-btn--transparent" href="/drafts"><span class="btn__cell"><span class="btn__text">View drafts</span></span></a><span class="menu-button"><button type="button" id="_R_2H1_" aria-expanded="true" aria-controls="_R_2_" aria-haspopup="true" aria-label="Menu" class="btn menu-button__button btn--secondary btn--large btn--split-end btn--transparent"><svg class="icon icon--12" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-chevron-down-12"></use></svg></button><span id="_R_2_" tabindex="-1" style="position:absolute;left:0;top:0;visibility:hidden" class="menu-button__menu menu-button__menu--reverse"><div aria-labelledby="_R_2H1_" role="menu" tabindex="-1" class="menu-button__items"><div role="menuitem" tabindex="-1" class="menu-button__item"><span>Archive</span><svg class="icon icon--16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true"><use xlink:href="#icon-tick-16"></use><defs><symbol viewBox="0 0 16 16" id="icon-tick-16"><path fill-rule="evenodd" d="M13.707 5.707a1 1 0 0 0-1.414-1.414L6 10.586 3.707 8.293a1 1 0 0 0-1.414 1.414l3 3a1 1 0 0 0 1.414 0l7-7Z" clip-rule="evenodd"/></symbol></defs></svg></div></div></span></span></span>"`;

