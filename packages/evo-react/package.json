{
  "name": "@evo-web/react",
  "version": "0.3.2",
  "description": "Collection of core eBay components; considered to be the building blocks for all composite structures, pages & apps.",
  "keywords": [
    "React",
    "eBay Evo",
    "evo-web",
    "components",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eBay/evo-web.git",
    "directory": "packages/evo-react"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./icons/*": {
      "types": "./dist/icon/icons/*.d.ts",
      "default": "./dist/icon/icons/*.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm type:check && pnpm test && vite build",
    "build:icons": "pnpm update-icons",
    "build:storybook": "storybook build -o ./_site",
    "deploy": "pnpm build:storybook",
    "format": "eslint . --fix && prettier . --write --log-level=warn",
    "lint": "eslint . && prettier . --check --log-level=warn",
    "release": "pnpm build",
    "start": "storybook dev -p 9001",
    "test": "vitest run --browser.headless --passWithNoTests",
    "type:check": "tsc --noEmit",
    "update-icons": "tsx scripts/import-svg.ts",
    "version": "pnpm update-icons && git add -A src"
  },
  "dependencies": {
    "@floating-ui/react": "catalog:",
    "classnames": "catalog:",
    "makeup-active-descendant": "catalog:",
    "makeup-expander": "catalog:",
    "makeup-floating-label": "catalog:",
    "makeup-focusables": "catalog:",
    "makeup-keyboard-trap": "catalog:",
    "makeup-prevent-scroll-keys": "catalog:",
    "makeup-roving-tabindex": "catalog:",
    "makeup-screenreader-trap": "catalog:",
    "makeup-typeahead": "catalog:",
    "react-remove-scroll": "catalog:"
  },
  "devDependencies": {
    "@ebay/skin": "workspace:^",
    "@eslint/js": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "del": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "globals": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rollup-plugin-node-externals": "catalog:",
    "storybook": "catalog:",
    "svgson": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.0.5"
  },
  "peerDependencies": {
    "@ebay/skin": "^19",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
