// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders button with appearance=borderless 1`] = `
"<button
  class="btn btn--borderless"
  type="button"
>
  Button
</button>"
`;

exports[`renders button with appearance=form 1`] = `
"<button
  class="btn btn--form"
  type="button"
>
  Button
</button>"
`;

exports[`renders button with appearance=primary 1`] = `
"<button
  class="btn btn--primary"
  type="button"
>
  Button
</button>"
`;

exports[`renders button with appearance=secondary 1`] = `
"<button
  class="btn btn--secondary"
  type="button"
>
  Button
</button>"
`;

exports[`renders button with appearance=tertiary 1`] = `
"<button
  class="btn btn--tertiary"
  type="button"
>
  Button
</button>"
`;

exports[`renders button with fluid=false 1`] = `
"<button
  class="btn btn--secondary"
  type="button"
>
  Button
</button>"
`;

exports[`renders button with fluid=true 1`] = `
"<button
  class="btn btn--fluid btn--secondary"
  type="button"
>
  Button
</button>"
`;

exports[`renders button with size=large 1`] = `
"<button
  class="btn btn--large btn--secondary"
  type="button"
>
  Button
</button>"
`;

exports[`renders defaults 1`] = `
"<button
  class="btn btn--secondary"
  type="button"
>
  Button
</button>"
`;

exports[`renders destructive button 1`] = `
"<button
  class="btn btn--destructive btn--primary"
  type="button"
>
  Button
</button>"
`;

exports[`renders disabled version 1`] = `
"<button
  class="btn btn--secondary"
  disabled=""
  type="button"
>
  Button
</button>"
`;

exports[`renders fake version 1`] = `
"<a
  arialabel="fake button"
  class="fake-btn fake-btn--large fake-btn--primary"
  href="#"
>
  Button
</a>"
`;

exports[`renders large truncated button 1`] = `
"<button
  class="btn btn--large-truncated btn--large btn--secondary"
  type="button"
>
  Button
</button>"
`;

exports[`renders loading state when a11yLoadingText is set 1`] = `
"<button
  aria-label="loading text"
  class="btn btn--primary"
  type="button"
>
  <span
    class="btn__cell"
  >
    <span
      class="progress-spinner"
      role="img"
    >
      <svg
        aria-hidden="true"
        class="icon icon--24"
      >
        <symbol
          fill="none"
          id="GENERATED-0"
          viewBox="0 0 24 24"
        >
          <path
            d="M22.5 12A10.5 10.5 0 1 1 9.514 1.798"
            stroke="var(--color-spinner-icon-background, #3665F3)"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="3"
          />
          <path
            d="M14.606 1.829a10.5 10.5 0 0 1 4.056 2.055 10.499 10.499 0 0 1 2.806 3.577"
            stroke="var(--color-spinner-icon-foreground, #E5E5E5)"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="3"
          />
        </symbol>
        <use
          href="#icon-spinner-24"
        />
      </svg>
    </span>
  </span>
</button>"
`;

exports[`renders partially disabled version 1`] = `
"<button
  aria-disabled="true"
  class="btn btn--secondary"
  type="button"
>
  Button
</button>"
`;

exports[`renders small button 1`] = `
"<button
  class="btn btn--small btn--secondary"
  type="button"
>
  Button
</button>"
`;

exports[`renders small truncated button 1`] = `
"<button
  class="btn btn--truncated btn--small btn--secondary"
  type="button"
>
  Button
</button>"
`;

exports[`renders truncated button 1`] = `
"<button
  class="btn btn--truncated btn--secondary"
  type="button"
>
  Button
</button>"
`;

exports[`renders with id override 1`] = `
"<button
  class="btn btn--secondary"
  id="test"
  type="button"
>
  Button
</button>"
`;

exports[`renders with type override 1`] = `
"<button
  class="btn btn--secondary"
  type="submit"
>
  Button
</button>"
`;
