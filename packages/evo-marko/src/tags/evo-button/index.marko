export type RootInput = Marko.HTML.Button | Marko.HTML.A;
export interface Input
  extends Marko.HTML.Button, Omit<Marko.HTML.A, "type" | `on${string}`> {
  href?: string;
  size?: "large" | "small";
  appearance?: "primary" | "secondary" | "tertiary" | "borderless" | "form";
  destructive?: boolean;
  fluid?: boolean;
  disabled?: boolean;
  partiallyDisabled?: boolean;
  truncate?: boolean;
  split?: "start" | "end";
  /**
   * The `aria-label` while loading; setting it shows the progress spinner
   */
  a11yLoadingText?: string | false | null;
}

<const/{
  content,
  a11yLoadingText,
  class: inputClass,
  destructive,
  fluid,
  href,
  partiallyDisabled,
  appearance = "secondary",
  size,
  split,
  truncate,
  type = "button",
  ...htmlInput
}=input>

<const/baseClass=href ? "fake-btn" : "btn">
<const/sizeClass=size && baseClass + "--" + size>
<const/truncateClass=(
  truncate && `${baseClass}--${size === "large" ? "large-" : ""}truncated`
)>

<define/Root|input: RootInput|>
  <if=href><a ...input as Marko.HTML.A href=href/></if>
  <else>
    <button ...input as Marko.HTML.Button type=type/>
  </else>
</define>

<Root
  ...htmlInput
  class=[
    inputClass,
    baseClass,
    fluid && `${baseClass}--fluid`,
    truncateClass,
    destructive && `${baseClass}--destructive`,
    sizeClass,
    split && `${baseClass}--split-${split}`,
    `${baseClass}--${appearance}`,
  ]
  aria-disabled=partiallyDisabled && "true"
  aria-label=a11yLoadingText || input["aria-label"]
>
  <if=a11yLoadingText>
    <span class="btn__cell">
      <evo-progress-spinner a11yText=null/>
    </span>
  </if>
  <else>
    <${content}/>
  </else>
</Root>
