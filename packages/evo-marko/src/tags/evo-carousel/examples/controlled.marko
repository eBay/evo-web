<style>
  .demo-carousel-slide {
    align-items: center;
    background-color: var(--color-background-secondary);
    border-radius: var(--border-radius-50);
    display: flex;
    height: 120px;
    justify-content: center;
  }
</style>

<let/index=0>

<p>Showing item ${index + 1}</p>

<evo-button onClick() {
  index = 0;
}>
  Back to the start
</evo-button>
<evo-button onClick() {
  index = 8;
}>
  Jump to item 9
</evo-button>

<evo-carousel ...input a11yText="Top products" itemsPerSlide=3 index:=index>
  <@previous a11yText="Previous slide"/>
  <@next a11yText="Next slide"/>
  <for|i| from=1 to=12>
    <@item>
      <div class="demo-carousel-slide">
        Card ${i}
      </div>
    </@item>
  </for>
</evo-carousel>
