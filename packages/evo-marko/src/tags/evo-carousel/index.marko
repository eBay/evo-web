import { observe, page, scrollToIndex } from "../../common/carousel";
export interface Control extends Omit<
  Marko.HTML.Button,
  "type" | "aria-label" | "aria-disabled" | "aria-controls"
> {
  /**
   * The `aria-label` of the control
   *
   * English default to be overridden is `"Previous slide"` or `"Next slide"`
   */
  a11yText?: string;
}
export interface Playback extends Omit<
  Marko.HTML.Button,
  "type" | "aria-label"
> {
  /**
   * The `aria-label` of the playback control while paused
   *
   * English default to be overridden is `"Play carousel"`
   */
  a11yPlayText?: string;
  /**
   * The `aria-label` of the playback control while playing
   *
   * English default to be overridden is `"Pause carousel"`
   */
  a11yPauseText?: string;
}
export interface Input extends Omit<Marko.HTML.Div, "role" | "aria-label"> {
  /**
   * The accessible name for the carousel
   *
   * Pass `null` explicitly _only_ if alternative accessibility information is present
   */
  a11yText: string | null;
  item?: Marko.AttrTag<Marko.HTML.LI>;
  previous?: Marko.AttrTag<Control>;
  next?: Marko.AttrTag<Control>;
  playback?: Marko.AttrTag<Playback>;
  itemsPerSlide?: number;
  noPeek?: boolean;
  gap?: number | string;
  imageTreatment?: "none" | "matte" | "large";
  hiddenScrollbar?: boolean;
  autoplay?: boolean | number;
  paused?: boolean;
  pausedChange?: (paused: boolean) => void;
  index?: number;
  indexChange?: (index: number) => void;
}
static function getLayout(
  itemsPerSlide: number | undefined,
  noPeek: boolean | undefined,
  interval: number,
) {
  if (!itemsPerSlide && !interval) return { perSlide: 0, inView: 0 };
  const perSlide = Math.max(Math.floor(itemsPerSlide || 1), 1);
  const peek = (itemsPerSlide || 1) % 1 || (noPeek || interval ? 0 : 0.1);
  return { perSlide, inView: perSlide + peek };
}

<const/{
  class: inputClass,
  style: inputStyle,
  a11yText,
  item: items,
  previous,
  next,
  playback,
  itemsPerSlide,
  noPeek,
  gap,
  imageTreatment = "none",
  hiddenScrollbar,
  autoplay,
  paused: inputPaused,
  pausedChange,
  index: inputIndex,
  indexChange,
  "aria-roledescription": ariaRoledescription = "carousel",
  onPointerEnter,
  onPointerLeave,
  onFocusIn,
  onFocusOut,
  ...htmlInput
}=input>

<const/itemList=[...(items || [])]>
<const/interval=(autoplay === true ? 4000 : autoplay || 0)>
<const/{ perSlide, inView }=getLayout(itemsPerSlide, noPeek, interval)>

<let/index:=input.index>
<let/atStart=true>
<let/atEnd=false>
<let/visible=null as boolean[] | null>
<let/moving=false>

<script>
  $signal.onabort = observe($list(), (changes) => {
    if (changes.atStart !== undefined) atStart = changes.atStart;
    if (changes.atEnd !== undefined) atEnd = changes.atEnd;
    if (changes.visible) visible = changes.visible;
    if (changes.moving !== undefined) moving = changes.moving;
    if (changes.index !== undefined) index = changes.index;
  });
</script>

<script>
  if (index !== undefined) {
    const landing = scrollToIndex($list(), index);
    if (landing !== index) index = landing;
  }
</script>

<let/paused:=input.paused>
<let/hovering=false>
<let/focused=false>
<const/playing=!!interval && !paused && !hovering && !focused>

<script>
  if (interval && matchMedia("(prefers-reduced-motion: reduce)").matches) {
    paused = true;
  }
</script>

<script>
  void index; // restarts the wait after scrolling by hand
  if (playing && !moving && !(atStart && atEnd)) {
    const timer = setTimeout(() => page($list(), 1, true), interval);
    $signal.onabort = () => clearTimeout(timer);
  }
</script>

<id/listId>

<define/Paddle|
  {
    control,
    direction,
  }: {
    control: Marko.AttrTag<Control> | undefined;
    direction: 1 | -1;
  },
|>
  <const/{
    a11yText: controlText = direction === 1 ? "Next slide" : "Previous slide",
    class: controlClass,
    onClick,
    ...buttonInput
  }=control || ({} as Control)>
  <const/disabled=!interval && (direction === 1 ? atEnd : atStart)>
  <button
    ...buttonInput
    type="button"
    aria-label=controlText
    aria-controls=listId
    aria-disabled=disabled && "true"
    class=[
      "carousel__control",
      direction === 1 ? "carousel__control--next" : "carousel__control--prev",
      controlClass,
    ]
    onClick(e, el) {
      if (!disabled) page($list(), direction, !!interval);
      onClick && onClick(e, el);
    }>
    <if=direction === 1>
      <evo-icon-chevron-right-16/>
    </if>
    <else>
      <evo-icon-chevron-left-16/>
    </else>
  </button>
</define>

<div
  ...htmlInput
  role="group"
  aria-roledescription=ariaRoledescription
  aria-label=a11yText
  class=[
    "carousel",
    hiddenScrollbar && "carousel--hidden-scrollbar",
    !!perSlide && "carousel--slides",
    !!(inView % 1) && "carousel--peek",
    inputClass,
  ]
  style=[
    inputStyle,
    gap != null &&
      `--carousel-gap: ${typeof gap === "number" ? `${gap}px` : gap}`,
    !!inView && `--carousel-items-in-view: ${inView}`,
  ]
  onPointerEnter(e, el) {
    hovering = true;
    onPointerEnter && onPointerEnter(e, el);
  }
  onPointerLeave(e, el) {
    hovering = false;
    onPointerLeave && onPointerLeave(e, el);
  }
  onFocusIn(e, el) {
    focused = !(e.target as Element).classList.contains("carousel__playback");
    onFocusIn && onFocusIn(e, el);
  }
  onFocusOut(e, el) {
    if (!el.contains(e.relatedTarget as Node | null)) focused = false;
    onFocusOut && onFocusOut(e, el);
  }>
  <if=interval && !(atStart && atEnd)>
    <const/{
      a11yPlayText = "Play carousel",
      a11yPauseText = "Pause carousel",
      class: playbackClass,
      onClick: onPlaybackClick,
      ...playbackInput
    }=playback || ({} as Playback)>
    <button
      ...playbackInput
      type="button"
      aria-label=(paused ? a11yPlayText : a11yPauseText)
      class=["carousel__playback", playbackClass]
      onClick(e, el) {
        const wasPaused = paused;
        paused = !wasPaused;
        if (wasPaused) page($list(), 1, true);
        onPlaybackClick && onPlaybackClick(e, el);
      }>
      <if=paused>
        <evo-icon-play-24/>
      </if>
      <else>
        <evo-icon-pause-24/>
      </else>
    </button>
  </if>
  <div class=[
    "carousel__container",
    atStart && atEnd && "carousel__container--controls-disabled",
  ]>
    <Paddle control=previous direction=-1/>
    <div class=[
      "carousel__viewport",
      !perSlide && !atEnd && "carousel__viewport--mask",
    ]>
      <ul/$list
        id=listId
        aria-live=(interval ? (playing ? "off" : "polite") : undefined)
        class=[
          "carousel__list",
          "carousel__list--gap",
          !!perSlide && "carousel__list--slides",
          imageTreatment === "matte" && "carousel__list--image-treatment",
          imageTreatment === "large" && "carousel__list--image-treatment-large",
        ]>
        <for|item, i| of=itemList>
          <li
            ...item
            class=[
              "carousel__item",
              (!perSlide || i % perSlide === 0) && "carousel__item--snap",
              item.class,
            ]
            inert=!!visible && !visible[i]/>
        </for>
      </ul>
    </div>
    <Paddle control=next direction=1/>
  </div>
</div>
