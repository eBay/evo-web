export interface Item extends Marko.HTML.A {}
export interface Input extends Omit<Marko.HTML.Nav, "role"> {
    a11yHeadingText?: string;
    a11yHeadingTag?: keyof Marko.NativeTags;
    a11yMenuButtonText?: string;
    item?: Marko.AttrTag<Item>;
}

<const/{
    class: inputClass,
    a11yHeadingText,
    a11yHeadingTag: HeadingTag = "h2",
    a11yMenuButtonText,
    item: items,
    ...htmlInput
}=input>

<const/itemList=[...items || []]>
<id/headingId>
<let/hiddenCount=0>

<const/calculateMaxItems() {
    const el = $items();
    if (!el || itemList.length < 3) { hiddenCount = 0; return; }

    const nav = el.parentElement!;
    const { paddingLeft, paddingRight } = getComputedStyle(nav);
    const maxWidth = nav.clientWidth - parseFloat(paddingLeft) - parseFloat(paddingRight);

    // Measure each <li>, temporarily unhiding hidden ones.
    // The overflow menu <li> is always DOM child 1, so input item[N] = child[N+1].
    const widths = Array.from(el.children as HTMLCollectionOf<HTMLElement>, (child) => {
        if (child.hidden) { child.hidden = false; const v = child.offsetWidth; child.hidden = true; return v; }
        return child.offsetWidth;
    });

    // Check if all items fit without the overflow menu.
    const last = widths.length - 1;
    const itemTotal = widths[0] + widths.slice(2).reduce((a, b) => a + b, 0);
    if (itemTotal <= maxWidth) { hiddenCount = 0; return; }

    // Items don't fit. Starting from first + menu + last, walk backward and
    // count how many items to hide. Hidden items are always a contiguous
    // range from input index 1..hiddenCount.
    let used = widths[0] + widths[1] + widths[last];
    let count = 0;
    for (let i = last - 1; i >= 2; i--) {
        used += widths[i];
        if (used > maxWidth || i <= last - 3) count++;
    }
    hiddenCount = count;
}>

<script>
    calculateMaxItems();
    window.addEventListener("resize", calculateMaxItems, { signal: $signal });
</script>

<nav
    ...htmlInput
    aria-labelledby=headingId
    class=["breadcrumbs", "breadcrumb--overflow", inputClass]
    role="navigation">
    <${HeadingTag} id=headingId class="clipped">
        ${a11yHeadingText}
    </>
    <ul/$items>
        <for|item, i| of=itemList>
            <const/{ class: itemClass, href, content, ...htmlItem }=item>
            <if=(i === 1)>
                <li hidden=(hiddenCount === 0)>
                    <evo-fake-menu-button
                        variant="icon"
                        transparent
                        noToggleIcon
                        collapseOnSelect
                        a11yText=a11yMenuButtonText>
                        <evo-icon-overflow-horizontal-16/>
                        <for|menuItem, j| of=itemList>
                            <if=(j >= 1 && j <= hiddenCount)>
                                <@item href=menuItem.href content=menuItem.content/>
                            </if>
                        </for>
                    </evo-fake-menu-button>
                    <evo-icon-chevron-right-12/>
                </li>
            </if>
            <li hidden=(i >= 1 && i <= hiddenCount)>
                <${href ? "a" : "button"}
                    ...htmlItem
                    href=href
                    class=itemClass
                    aria-current=(!href && i === itemList.length - 1) && "location">
                    <${content}/>
                </>
                <if=(i < itemList.length - 1)>
                    <evo-icon-chevron-right-12/>
                </if>
            </li>
        </for>
    </ul>
</nav>
