import IconButton from "<evo-icon-button>";
import FilterChip from "<evo-filter-chip>";
import Button, { type Input as ButtonInput } from "<evo-button>";
import ButtonField from "<evo-button-field>";
import { type Input as MenuInput } from "<evo-menu>";
export interface Input<Index extends number | string | (number | string)[]>
  extends
    Omit<MenuInput<Index>, "a11yLabelId" | "a11yText" | "variant">,
    Pick<Marko.HTML.Span, "aria-label" | "aria-labelledby"> {
  open?: boolean;
  openChange?: (open: boolean) => void;
  collapseOnSelect?: boolean;
  prefixId?: string;
  variant?: "form" | "button" | "icon" | "filter";
  partiallyDisabled?: ButtonInput["partiallyDisabled"];
  priority?: "primary" | "secondary" | "tertiary";
  size?: ButtonInput["size"];
  /**
   * Removes the button's border, for the `button`, `form` and `icon` variants
   */
  transparent?: boolean;
  disabled?: boolean;
  split?: ButtonInput["split"];
  noToggleIcon?: boolean;
  label?: Marko.AttrTag<Marko.HTML.Span>;
  footerButton?: Marko.AttrTag<ButtonInput>;
  reverse?: boolean;
  strategy?: "absolute" | "fixed";
  fixWidth?: boolean;
}
<const/{
  class: inputClass,
  noToggleIcon: inputNoToggleIcon,
  reverse,
  strategy,
  fixWidth,
  size,
  partiallyDisabled: inputPartiallyDisabled,
  footerButton,
  priority: inputPriority,
  disabled,
  variant,
  item: items,
  group: groups,
  label,
  selected: inputSelected,
  selectedChange,
  open: inputOpen,
  openChange,
  prefixId,
  split: inputSplit,
  collapseOnSelect,
  transparent: inputTransparent,
  onKeyDown,
  onFocusOut,
  ...htmlInput
}=input>

<id/labelId>
<let/selected:=input.selected>
<let/open:=input.open>
// Stays false until the user opens the menu, so that a menu which starts open
// does not steal focus.
<let/focusOnOpen=false>
<const/focusButton=() => {
  $root().querySelector<HTMLElement>(".menu-button__button")!.focus();
}>
<const/{
  tagName,
  isSelected,
  chipVariant,
  split,
  appearance,
  toggleIcon,
  fieldTransparent,
  partiallyDisabled,
  ariaDisabled,
}=(() => {
  let appearance;
  let split;
  let toggleIcon = true;
  let tagName;
  let isSelected;
  let chipVariant;
  let fieldTransparent;
  let partiallyDisabled = inputPartiallyDisabled;
  let ariaDisabled;

  if (variant === "icon") {
    tagName = IconButton;
    if (inputTransparent) appearance = "transparent";
  } else if (variant === "filter") {
    tagName = FilterChip;
    chipVariant = variant;
    isSelected = Array.isArray(selected)
      ? selected.length > 0
      : selected != null && selected !== -1;
  } else if (variant === "form") {
    tagName = ButtonField;
    fieldTransparent = inputTransparent;
    toggleIcon = false;
    partiallyDisabled = undefined;
    ariaDisabled = inputPartiallyDisabled && "true";
  } else {
    tagName = Button;
    split = inputSplit;
    toggleIcon = !inputNoToggleIcon;
    appearance = inputTransparent ? "transparent" : inputPriority;
  }

  return {
    tagName,
    split,
    isSelected,
    chipVariant,
    toggleIcon,
    appearance,
    fieldTransparent,
    partiallyDisabled,
    ariaDisabled,
  };
})()>

<evo-expander/expander
  open=open
  placement=reverse ? "bottom-end" : "bottom-start"
  strategy=strategy
  host=$root
  overlay=(): HTMLElement => $menuEls().$root()
/>
// The menu only becomes focusable once the expander has positioned, and so
// made visible, it.
<script>
  if (open && focusOnOpen && expander.positioned) {
    const item = $menuEls()
      .$root()
      .querySelector(`[role^="menuitem"]:not([aria-disabled="true"])`);
    if (item instanceof HTMLElement) item.focus();
  }
</script>

<span/$root
  ...htmlInput
  class=["menu-button", inputClass]
  onKeyDown(e, el) {
    if (e.key === "Escape" && open) {
      open = false;
      focusButton();
    }
    onKeyDown && onKeyDown(e, el);
  }
  onFocusOut(e, el) {
    if (!el.contains(e.relatedTarget as Node)) {
      open = false;
    }
    onFocusOut && onFocusOut(e, el);
  }
>
  <${tagName as any}
    class=[`menu-button__button`]
    size=size
    appearance=appearance
    transparent=fieldTransparent
    variant=chipVariant
    aria-haspopup="true"
    selected=isSelected
    aria-expanded=expander.ariaExpanded
    aria-labelledby=(
      prefixId && (variant === "icon" ? prefixId : `${prefixId} ${labelId}`)
    )
    split=split
    disabled=disabled
    partiallyDisabled=partiallyDisabled
    aria-disabled=ariaDisabled
    onClick() {
      if (inputPartiallyDisabled) return;
      focusOnOpen = true;
      open = !open;
    }
  >
    <if=label>
      <span ...label class=["menu-button-prefix-label", label.class]/>${" "}
    </if>
    <if=variant === "icon">
      <${input.content}/>
    </if>
    <else>
      <span id=prefixId && labelId>
        <${input.content}/>
      </span>
      <if=toggleIcon>
        <evo-icon-chevron-down-12/>
      </if>
    </else>
  </>
  <evo-menu/$menuEls
    style=expander.floatingStyles
    selected:=input.selected
    classPrefix="menu-button"
    fixed=strategy === "fixed"
    variant=variant as MenuInput<Index>["variant"]
    fixWidth=fixWidth
    tabindex=-1
    footerButton=footerButton
    onClick() {
      if (collapseOnSelect) {
        open = false;
        focusButton();
      }
    }
    item=items
    group=groups
  />
</span>
