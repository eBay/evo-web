import type { Input as TextboxInput } from "<evo-input>";
export type Input = Omit<TextboxInput, "value" | "valueChange"> & {
  value?: number;
  valueChange?: (value: number) => void;
  min?: number;
  max?: number;
  a11yDeleteText?: string;
  onDelete?: (event: Event, target: HTMLElement) => void;
} & (
    | {
        label: Marko.AttrTag<Marko.HTML.Label>;
        /**
         * Accessible name used when no visible `label` is supplied. English
         * default to be overridden is `"Number input"`. Pass `null` explicitly
         * _only_ if alternative accessibility information is present.
         */
        a11yText?: null;
      }
    | {
        /**
         * Accessible name used when no visible `label` is supplied. English
         * default to be overridden is `"Number input"`. Pass `null` explicitly
         * _only_ if alternative accessibility information is present.
         */
        a11yText?: string | null;
        label?: never;
      }
  );

<const/defaultMin=input.a11yDeleteText ? 1 : 0>

<const/{
  label,
  a11yText = "Number input",
  a11yDeleteText,
  class: inputClass,
  disabled,
  min = defaultMin,
  max = Infinity,
  id,
  onDelete,
  readonly,
  ...htmlInput
}=input>

<id/numberInput=id>
<let/value:=input.value>

<const/displayValue=value === undefined ? min : value>
<const/controlsDisabled=Boolean(disabled || readonly)>

<const/checkBoundary(value: number, inc: number = 0) {
  let newValue = value + inc;
  if (isNaN(newValue)) {
    newValue = min;
  } else if (newValue > max) {
    newValue = max;
  } else if (newValue < min) {
    newValue = min;
  }
  return newValue;
}>

<span class=[
  "number-input",
  a11yDeleteText && displayValue === min && "number-input--show-delete",
  inputClass,
]>
  <evo-input
    ...htmlInput
    aria-label=label ? undefined : a11yText
    disabled=disabled
    readonly=readonly
    min=min
    max=max
    id=numberInput
    type="number"
    value=displayValue
    valueChange(newValue) {
      value = checkBoundary(parseInt(newValue, 10), 0);
    }
  >
    <@prefixIcon>
      <if=label><label ...label for=numberInput/></if>
      <evo-icon-button
        aria-hidden="true"
        a11yText=null
        disabled=controlsDisabled || displayValue <= min
        size="small"
        class="number-input__decrement"
        transparent
        tabindex="-1"
        onClick() {
          value = checkBoundary(displayValue, -1);
        }
      >
        <evo-icon-remove-24/>
      </evo-icon-button>
    </@prefixIcon>
    <@postfixIcon>
      <if=a11yDeleteText>
        <evo-icon-button
          class="number-input__delete"
          size="small"
          transparent
          a11yText=a11yDeleteText
          disabled=controlsDisabled
          onClick(event, target) {
            (onDelete || null)?.(event, target);
          }
        >
          <evo-icon-delete-24/>
        </evo-icon-button>
      </if>

      <evo-icon-button
        aria-hidden="true"
        a11yText=null
        disabled=controlsDisabled || displayValue >= max
        class="number-input__increment"
        size="small"
        transparent
        onClick() {
          value = checkBoundary(displayValue, 1);
        }
        tabindex="-1"
      >
        <evo-icon-add-24/>
      </evo-icon-button>
    </@postfixIcon>
  </evo-input>
</span>
