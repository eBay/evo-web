import { type Input as ButtonInput } from "<evo-button>";
import type { Input as BadgeInput } from "<evo-badge>";
export interface Input
  extends
    Omit<Marko.HTML.Button, "aria-label">,
    Omit<Marko.HTML.A, "type" | `on${string}` | "aria-label"> {
  badge?: Marko.AttrTag<Omit<BadgeInput, "a11yText" | "type">>;
  href?: string;
  appearance?: "primary" | "secondary" | "tertiary" | "transparent";
  size?: ButtonInput["size"];
  partiallyDisabled?: ButtonInput["partiallyDisabled"];
  /**
   * The `aria-label` of the button
   *
   * English default to be overridden is `"button"`
   *
   * Pass `null` explicitly _only_ if alternative accessibility information is present
   */
  a11yText: string | null;
}

<const/{
  badge,
  appearance,
  partiallyDisabled,
  content,
  type,
  size,
  class: inputClass,
  a11yText = "button",
  ...htmlInput
}=input>

<const/tagType=input.href ? "a" : "button">
<const/baseClassName=input.href ? "icon-link" : "icon-btn">

<${tagType}
  ...htmlInput
  aria-label=a11yText
  class=[
    inputClass,
    baseClassName,
    appearance && `${baseClassName}--${appearance}`,
    size && `${baseClassName}--${size}`,
  ]
  type=tagType === "button" && (type || "button")
  aria-disabled=partiallyDisabled && "true"
>
  <${content}/>
  <if=badge>
    <evo-badge ...badge type="icon" aria-hidden="true" a11yText=null/>
  </if>
</>
