import { localeDefault, type MonthISO } from "../../common/dates/date-utils";
import type { DayInput as CalendarDayInput } from "<evo-calendar>";
import type {
  DateFieldAttrs,
  DateInputValue,
  InvalidDateEvent,
} from "<evo-date-field>";
export type { DateFieldAttrs, DateInputValue, InvalidDateEvent };
export type { DayISO } from "../../common/dates/date-utils";

// Calendar attributes callers may customize. The date input owns the
// selection, locale, and select mode.
export interface DateInputCalendarAttrs extends Omit<
  CalendarDayInput,
  "selectMode" | "selected" | "selectedChange" | "locale"
> {
  strategy?: "absolute" | "fixed";
}

export interface Input extends Omit<Marko.HTML.Span, "value"> {
  value?: DateInputValue;
  valueChange?: (value: DateInputValue) => void;
  locale?: string;
  /**
   * Accessible label for the button that opens the calendar popover, mapped
   * to `aria-label`.
   */
  a11yOpenPopoverText: string;
  collapseOnSelect?: boolean;
  open?: boolean;
  openChange?: (open: boolean) => void;
  disabled?: boolean;
  readonly?: boolean;
  onInvalidDate?: (event: InvalidDateEvent) => void;
  input?: Marko.AttrTag<DateFieldAttrs>;
  calendar?: Marko.AttrTag<DateInputCalendarAttrs>;
}

<const/{
  class: inputClass,
  a11yOpenPopoverText,
  collapseOnSelect,
  disabled,
  readonly,
  onInvalidDate,
  input: field,
  calendar,
  value: _value,
  valueChange: _valueChange,
  open: _open,
  openChange: _openChange,
  onKeyDown,
  onFocusOut,
  ...htmlInput
}=input>
<const/locale=localeDefault(input.locale)>
<const/{
  strategy,
  visibleMonth: controlledVisibleMonth,
  visibleMonthChange,
  visibleMonthCount,
  disable,
  ...calendarRest
}=calendar ?? ({} as DateInputCalendarAttrs)>

<let/value:=input.value>
<let/open:=input.open>
<id/popoverId>

// While closed, the calendar follows the committed date's month.
<let/visibleMonth=value ? (value.slice(0, 7) as MonthISO) : undefined>
// Show two month panes on wide viewports unless the caller overrides.
<let/paneCount=1>
<script>
  const media = window.matchMedia("(min-width: 600px)");
  const update = () => {
    paneCount = media.matches ? 2 : 1;
  };
  update();
  media.addEventListener("change", update, { signal: $signal });
</script>

<const/focusTrigger() {
  $root().querySelector<HTMLElement>(`[aria-controls="${popoverId}"]`)?.focus();
}>
<const/toggle() {
  if (disabled || readonly) return;
  if (!open && value) {
    visibleMonth = value.slice(0, 7) as MonthISO;
  }
  open = !open;
}>

<evo-expander/expander
  open=open
  placement="bottom-start"
  strategy=strategy
  inline=false
  host=$root
  overlay=$popover
/>

<span/$root
  ...htmlInput
  class=["date-textbox", inputClass]
  onKeyDown(e, el) {
    if (e.key === "Escape" && open) {
      open = false;
      focusTrigger();
    }
    onKeyDown && onKeyDown(e, el);
  }
  onFocusOut(e, el) {
    if (!el.contains(e.relatedTarget as Node)) {
      open = false;
    }
    onFocusOut && onFocusOut(e, el);
  }
>
  <evo-date-field
    iso=value ?? ""
    locale=locale
    index=0
    disabled=disabled
    readonly=readonly
    field=field
    trigger={
      a11yText: a11yOpenPopoverText,
      open: open ?? false,
      popoverId,
      toggle,
    }
    commit(next) {
      value = next;
    }
    onInvalidDate=onInvalidDate
  />
  <div/$popover
    id=popoverId
    hidden=!open
    tabindex=(
      open && -1 // keeps focus inside the root on popover clicks, so onFocusOut does not close it
    )
    class=[
      "date-textbox__popover",
      strategy === "fixed" && "date-textbox__popover--fixed",
    ]
    style=expander.floatingStyles
  >
    <evo-calendar
      ...calendarRest
      selectMode="day"
      locale=locale
      disable=disabled ? { callback: () => true } : disable
      visibleMonthCount=visibleMonthCount ?? paneCount
      visibleMonth=controlledVisibleMonth ?? visibleMonth
      visibleMonthChange(month) {
        if (controlledVisibleMonth === undefined) {
          visibleMonth = month;
        }
        visibleMonthChange && visibleMonthChange(month);
      }
      selected=value || undefined
      selectedChange(next) {
        if (disabled || readonly) return;
        value = next;
        if (collapseOnSelect) {
          open = false;
          focusTrigger();
        }
      }
    />
  </div>
</span>
