import { localeDefault, type MonthISO } from "../../common/dates/date-utils";
import type { DayInput as CalendarDayInput } from "<evo-calendar>";
import type { DateInputValue } from "<evo-date-parts>";
export type { DateInputValue };
export type { DayISO } from "../../common/dates/date-utils";

export interface CalendarInput extends Omit<
  CalendarDayInput,
  "selectMode" | "selected" | "selectedChange" | "locale"
> {}

export interface Input extends Omit<Marko.HTML.Span, "value"> {
  value?: DateInputValue;
  valueChange?: (value: DateInputValue) => void;
  name?: string;
  locale?: string;
  floatingLabel?: string;
  /**
   * Accessible label for the button that opens the calendar popover, mapped
   * to `aria-label`.
   *
   * English default to be overridden is `"open calendar"`
   */
  a11yOpenPopoverText: string;
  collapseOnSelect?: boolean;
  open?: boolean;
  openChange?: (open: boolean) => void;
  disabled?: boolean;
  readonly?: boolean;
  invalid?: boolean;
  detachPopover?: boolean;
  calendar?: Marko.AttrTag<CalendarInput>;
}

<const/{
  class: inputClass,
  a11yOpenPopoverText = "open calendar",
  collapseOnSelect,
  name,
  floatingLabel,
  disabled,
  readonly,
  invalid,
  detachPopover,
  calendar,
  locale: _locale,
  value: _value,
  valueChange: _valueChange,
  open: _open,
  openChange: _openChange,
  onKeyDown,
  ...htmlInput
}=input>
<const/locale=localeDefault(input.locale)>
<let/value:=input.value>
<let/open:=input.open>
<id/partsId>
<id/popoverId>

<let/visibleMonth=value ? (value.slice(0, 7) as MonthISO) : undefined>
<let/paneCount=1>
<script>
  const media = window.matchMedia("(min-width: 600px)");
  const update = () => {
    paneCount = media.matches ? 2 : 1;
  };
  update();
  media.addEventListener("change", update, { signal: $signal });
</script>
<script>
  if (open) {
    document.addEventListener(
      "pointerdown",
      (e) => {
        if (!$root().contains(e.target as Node)) {
          open = false;
        }
      },
      { signal: $signal },
    );
  }
</script>

<const/close() {
  open = false;
  $trigger().focus();
}>

<evo-expander/expander
  open=open
  placement="bottom-start"
  detachPopover=detachPopover
  inline=false
  host=$root
  overlay=$popover
/>

<span/$root
  ...htmlInput
  class=["date-textbox", inputClass]
  onKeyDown(e, el) {
    if (e.key === "Escape" && open) close();
    onKeyDown && onKeyDown(e, el);
  }
  onFocusOut(e, el) {
    if (open && e.relatedTarget && !el.contains(e.relatedTarget as Node)) {
      open = false;
    }
  }
>
  <evo-floating-label
    floatingLabel=floatingLabel
    alwaysUp
    htmlFor=partsId
    disabled=disabled
    invalid=invalid
  >
    <span
      class=[
        "textbox",
        disabled && "textbox--disabled",
        invalid && "textbox--invalid",
        readonly && "textbox--readonly",
      ]
      role="group"
      aria-label=floatingLabel
    >
      <span class="textbox__control date-textbox__value">
        <evo-date-parts
          id=partsId
          value=value ?? ""
          valueChange(next) {
            value = next;
          }
          locale=locale
          name=name
          disabled=disabled
          readonly=readonly
          invalid=invalid
        />
      </span>
      <button/$trigger
        class="icon-btn icon-btn--transparent"
        type="button"
        aria-label=a11yOpenPopoverText
        aria-expanded=open ? "true" : "false"
        aria-controls=popoverId
        disabled=disabled || readonly
        onClick() {
          if (!open && value) visibleMonth = value.slice(0, 7) as MonthISO;
          open = !open;
        }
      >
        <evo-icon-calendar-24/>
      </button>
    </span>
  </evo-floating-label>
  <div/$popover
    id=popoverId
    hidden=!open
    class=[
      "date-textbox__popover",
      detachPopover && "date-textbox__popover--fixed",
    ]
    style=expander.floatingStyles
  >
    <evo-calendar
      visibleMonthCount=paneCount
      visibleMonth:=visibleMonth
      ...calendar
      selectMode="day"
      locale=locale
      disable=disabled ? { callback: () => true } : calendar?.disable
      selected=value || undefined
      selectedChange(next) {
        if (disabled || readonly) return;
        value = next;
        if (collapseOnSelect) close();
      }
    />
  </div>
</span>
