import { type Input as ButtonInput } from "<evo-button>";
export interface Input extends Marko.HTML.Button {
  size?: ButtonInput["size"];
  transparent?: boolean;
  truncate?: boolean;
}

<const/{
  content,
  class: inputClass,
  size,
  transparent,
  truncate,
  type = "button",
  ...htmlInput
}=input>

<button
  ...htmlInput
  type=type
  class=[
    inputClass,
    "btn",
    "btn--form",
    transparent && "btn--borderless",
    size && `btn--${size}`,
    truncate && `btn--${size === "large" ? "large-" : ""}truncated`,
  ]
>
  <span class="btn__cell">
    <${content}/>
    <evo-icon-chevron-down-12/>
  </span>
</button>
