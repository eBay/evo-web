import type { Placement } from "@floating-ui/dom";

export interface Input extends Marko.HTML.Span {
    open?: boolean;
    openChange?: (open: boolean) => void;
    placement?: Placement;
    offset?: number;
    flip?: boolean;
    shift?: boolean;
    inline?: boolean;
    noHover?: boolean;
    host: Marko.AttrTag<
        Marko.HTML.Span & {
            as?: Marko.Renderable;
        }
    >;
    heading?: Marko.AttrTag<
        Marko.HTML.Span & {
            as?: Marko.Renderable;
        }
    >;
}

<const/{
    class: inputClass,
    placement = "bottom" as Placement,
    offset: inputOffset,
    flip,
    shift,
    inline,
    noHover,
    host,
    heading,
    ...htmlInput
}=input>

<let/open=(input.open ?? false) valueChange=input.openChange>
<let/hoverTimeout=(undefined as ReturnType<typeof setTimeout> | undefined)>

<id/hostId> // TODO: Remove when Marko support dynamic tag variables
<const/$host() { return document.getElementById(hostId)! }>
<id/overlayId> // TODO: remove when Marko TS fixes its recursive issue
<const/$overlay() { return document.getElementById(overlayId)! }>
<id/arrowId> // TODO: remove when Marko TS fixes its recursive issue
<const/$arrow() { return document.getElementById(arrowId)! }>

<evo-expander/expander
    open=open
    placement=placement
    offset=(inputOffset ?? 8)
    flip=flip
    shift=shift
    inline=inline
    strategy="absolute"
    host=$host
    overlay=$overlay
    arrow=$arrow/>

<span/$root
    ...htmlInput
    class=["tooltip", inputClass]
    onMouseEnter=(!noHover && (() => {
        clearTimeout(hoverTimeout);
        open = true;
    }))
    onMouseLeave=(!noHover && (() => {
        clearTimeout(hoverTimeout);
        hoverTimeout = setTimeout(() => { open = false; }, 300);
    }))>
    <const/{ as: hostAs = "span", class: hostClass, ...htmlHost }=host>
    <${hostAs}
        ...htmlHost
        id=hostId
        class=["tooltip__host", hostClass]
        aria-expanded=expander.ariaExpanded
        onFocusIn() { open = true; }
        onFocusOut(e: FocusEvent) {
            if ($root().contains(e.relatedTarget as Node)) return;
            open = false;
        }/>
    <span
        id=overlayId
        class="tooltip__overlay"
        style=expander.floatingStyles
        role="tooltip">
        <span id=arrowId class="tooltip__pointer" style=expander.arrowStyles/>
        <span class="tooltip__mask">
            <span class="tooltip__cell">
                <span class="tooltip__content">
                    <if=heading>
                        <const/{
                            as: headingAs = "span",
                            class: headingClass,
                            ...htmlHeading
                        }=heading>
                        <${headingAs} ...htmlHeading class=["tooltip__heading", headingClass]/>
                    </if>
                    <${input.content}/>
                </span>
            </span>
        </span>
    </span>
</span>
