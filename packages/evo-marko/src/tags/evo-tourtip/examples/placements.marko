<style/styles>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
    justify-items: center;
  }
</style>

<div class=((styles as any).grid)>
  <for|placement| of=(
    [
      "top-start",
      "top",
      "top-end",
      "right-start",
      "right",
      "right-end",
      "bottom-start",
      "bottom",
      "bottom-end",
      "left-start",
      "left",
      "left-end",
    ] as const
  )>
    <let/open=false>
    <evo-tourtip
      ...input
      open:=open
      placement=placement
      a11yCloseText="Dismiss"
      flip=false>
      <@host
        as="button"
        onClick() {
          open = !open;
        }>
        ${placement}
      </@host>
      <@heading>${placement}</@heading>
      <p>
        Here we explicitly set${" "}
        <code>flip=false</code>
        ${" "}for demonstration. By default, tourtip will not extend outside the
        window
      </p>
    </evo-tourtip>
  </for>
</div>
