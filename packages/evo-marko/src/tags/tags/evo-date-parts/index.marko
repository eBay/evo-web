import {
  getDateParts,
  type DateField,
  type DayISO,
} from "../../../common/dates/date-utils";

export type DateInputValue = DayISO | "";

export interface Input {
  value: DateInputValue;
  valueChange: (value: DateInputValue) => void;
  locale: string;
  name?: string;
  id?: string;
  disabled?: boolean;
  readonly?: boolean;
  invalid?: boolean;
}

static const SIZES: Record<DateField, number> = { year: 4, month: 2, day: 2 };
static const MAX: Record<DateField, number> = {
  year: 9999,
  month: 12,
  day: 31,
};
static const SEPARATOR_KEYS = ["/", "-", ".", " "];

static function partsOf(value: string): Record<DateField, string> {
  const [year = "", month = "", day = ""] = value ? value.split("-") : [];
  return { year, month, day };
}

static function toDate({ year, month, day }: Record<DateField, string>) {
  if (!year || !month || !day) return "";
  const days = new Date(Date.UTC(+year, +month, 0)).getUTCDate();
  if (+year < 1 || +month < 1 || +month > 12 || +day < 1 || +day > days) {
    return "invalid";
  }
  return `${year}-${month}-${day}` as DayISO;
}

static function clean(field: DateField, value: string) {
  const size = SIZES[field];
  const digits = value.replace(/\D/g, "");
  return digits && digits.slice(-size).padStart(size, "0");
}

// Repeats the initial of the field's localized name, as in JJ/MM/AAAA. Scripts
// without letter case have no such convention, so they use English letters.
static function placeholderFor(
  field: DateField,
  names: Intl.DisplayNames,
  locale: string,
) {
  const initial = [...names.of(field)!][0].toLocaleUpperCase(locale);
  const letter =
    initial === initial.toLocaleLowerCase(locale)
      ? field[0].toUpperCase()
      : initial;
  return letter.repeat(SIZES[field]);
}

// Parts of a range are siblings in one field, so focus moves across dates.
static function moveFocus(el: HTMLInputElement, by: number) {
  const inputs = [
    ...el
      .closest(".date-textbox__value")!
      .querySelectorAll<HTMLInputElement>(".date-textbox__part > input"),
  ];
  inputs[inputs.indexOf(el) + by]?.focus();
}

<const/{
  value,
  valueChange,
  locale,
  name,
  id,
  disabled,
  readonly,
  invalid,
}=input>
<const/layout=getDateParts(locale)>
<const/fields=(
  layout
    .map(({ type }) => type)
    .filter((type): type is DateField => type !== "literal")
)>

<let/draft=(
  undefined as { key: string; parts: Record<DateField, string> } | undefined
)>
<const/parts=draft?.key === value ? draft.parts : partsOf(value)>
<const/date=toDate(parts)>
<const/commit(next: Record<DateField, string>) {
  const nextDate = toDate(next);
  const nextValue = nextDate === "invalid" ? "" : nextDate;
  draft = { key: nextValue, parts: next };
  if (nextValue !== value) valueChange(nextValue);
}>
<const/step=(field: DateField, by: number) => {
  const max = MAX[field];
  let n = parts[field]
    ? +parts[field] + by
    : field === "year"
      ? new Date().getFullYear()
      : by > 0
        ? 1
        : max;
  if (field === "year") n = Math.min(Math.max(n, 1), max);
  else if (n < 1) n = max;
  else if (n > max) n = 1;
  commit({ ...parts, [field]: String(n).padStart(SIZES[field], "0") });
}>
<const/fieldNames=new Intl.DisplayNames(locale, { type: "dateTimeField" })>
<const/placeholderOf=(type: DateField) =>
  placeholderFor(type, fieldNames, locale)>

// Digits typed since the part was focused: padding keeps a part full, so
// this is how typing knows a part is done.
<const/typed={ count: 0 }>

<for|{ type, value: literal }| of=layout>
  <if=type === "literal">
    <span class="date-textbox__separator" aria-hidden="true">${literal}</span>
  </if>
  <else>
    <span
      class="date-textbox__part"
      data-size=parts[type] || placeholderOf(type)
    >
      <input
        id=type === fields[0] ? id : undefined
        role="spinbutton"
        aria-label=fieldNames.of(type)
        aria-valuenow=parts[type] ? +parts[type] : undefined
        aria-invalid=(invalid || date === "invalid") && "true"
        inputmode="numeric"
        autocomplete="off"
        placeholder=placeholderOf(type)
        maxlength=SIZES[type] + 1
        disabled=disabled
        readonly=readonly
        value=parts[type]
        valueChange(next) {
          commit({ ...parts, [type]: clean(type, next) });
        }
        onInput(e, el) {
          if (!(e as InputEvent).inputType?.startsWith("insert")) return;
          typed.count++;
          const digits = clean(type, el.value);
          if (
            typed.count === SIZES[type] ||
            (type !== "year" && +digits > (type === "day" ? 3 : 1))
          ) {
            moveFocus(el, 1);
          }
        }
        onFocus(e, el) {
          typed.count = 0;
          el.select();
        }
        onClick(e, el) {
          el.select();
        }
        onKeyDown(e, el) {
          if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
            e.preventDefault();
            moveFocus(el, e.key === "ArrowLeft" ? -1 : 1);
          } else if (readonly) {
            return;
          } else if (e.key === "ArrowUp" || e.key === "ArrowDown") {
            e.preventDefault();
            step(type, e.key === "ArrowUp" ? 1 : -1);
          } else if (e.key === "Backspace" && !el.value) {
            e.preventDefault();
            moveFocus(el, -1);
          } else if (e.key === "Backspace") {
            // Digits shift back out to the right: 12, then 01, then empty.
            e.preventDefault();
            const rest = el.value.slice(0, -1);
            typed.count = 0;
            commit({
              ...parts,
              [type]: +rest ? rest.padStart(el.value.length, "0") : "",
            });
          } else if (SEPARATOR_KEYS.includes(e.key)) {
            e.preventDefault();
            if (el.value) moveFocus(el, 1);
          }
        }
      >
    </span>
  </else>
</for>
<if=name>
  <input type="hidden" name=name value=value>
</if>
