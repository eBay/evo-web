import {
    autoUpdate,
    computePosition,
    shift,
    offset,
    flip,
    inline,
    arrow,
    type Placement,
} from "@floating-ui/dom";

export interface Input {
    open?: boolean;
    openChange?: (open: boolean) => void;
    host: () => HTMLElement;
    overlay: () => HTMLElement;
    arrow?: () => HTMLElement;
    placement?: Placement;
    strategy?: "absolute" | "fixed";
    offset?: number;
    flip?: boolean;
    shift?: boolean;
    inline?: boolean;
    collapseOnClickOutside?: boolean;
    collapseOnEscape?: boolean;
    collapseOnSelect?: boolean;
    focusOnOpen?: boolean;
}

<let/floatingStyles=({ visibility: "hidden" } as Record<string, string>)>
<let/arrowStyles=(undefined as undefined | Record<string, string>)>

<const/update=() => {
    const hostEl = input.host();
    const overlayEl = input.overlay();
    const arrowEl = input.arrow?.();

    const middleware = [
        offset(input.offset ?? 4),
        (input.inline !== false) && inline(),
        (input.flip !== false) && flip({
            fallbackAxisSideDirection: "end",
            flipAlignment: false,
        }),
        (input.shift !== false) && shift(),
        arrowEl && arrow({
            element: arrowEl,
            padding: 20,
        }),
    ].filter(Boolean);

    computePosition(hostEl, overlayEl, {
        placement: input.placement ?? "bottom-start",
        strategy: input.strategy ?? "fixed",
        middleware,
    }).then(({ x, y, placement, middlewareData }) => {
        if ($signal.aborted) {
            return;
        }

        floatingStyles = {
            left: `${x}px`,
            top: `${y}px`,
            visibility: "visible",
        };

        if (arrowEl && middlewareData.arrow) {
            const { x: arrowX, y: arrowY } = middlewareData.arrow;
            const staticSide = {
                top: "bottom",
                right: "left",
                bottom: "top",
                left: "right",
            }[placement.split("-")[0]] as string;

            arrowStyles = {
                left: arrowX != null ? `${arrowX}px` : "",
                top: arrowY != null ? `${arrowY}px` : "",
                right: "",
                bottom: "",
                [staticSide]: "-4px",
            };
        }
    });
}>

<let/open:=input.open>

<script>
    if (open) {
        const cleanupFn = autoUpdate(input.host(), input.overlay(), update);
        $signal.onabort = () => {
            cleanupFn();
        };

        if (input.focusOnOpen !== false) {
            let focusItem = input
                .overlay()
                ?.querySelector("[tabindex]") as HTMLInputElement;
            if (!focusItem) {
                focusItem = input.overlay() as HTMLInputElement;
            }
            focusItem?.focus();
        }

        setTimeout(() => {
            if (input.collapseOnClickOutside !== false) {
                document.addEventListener(
                    "click",
                    (e: Event) => {
                        if (
                            input.host().contains(e.target as Node) === false ||
                            input.collapseOnSelect
                        ) {
                            open = false;
                        }
                    },
                    { signal: $signal },
                );
            }

            if (input.collapseOnEscape !== false) {
                document.addEventListener(
                    "keydown",
                    (e) => {
                        if (e.key === "Escape") {
                            open = false;
                        }
                    },
                    { signal: $signal },
                );
            }
        }, 0);
    }
</script>

<return={
    floatingStyles,
    arrowStyles,
    onClick() {
        open = !open;
    },
    onFocus() {
        open = true;
    },
    onFocusOut() {
        open = false;
    },
    onKeyDown(e: KeyboardEvent) {
        if (e.key === "Enter" || e.key === " ") {
            open = true;
        }
    },
    ariaExpanded: open
        ? "true" as const
        : "false" as const,
}>
