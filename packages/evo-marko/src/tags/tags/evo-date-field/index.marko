import { type DayISO } from "../../../common/dates/date-utils";
import {
  editAtSeparator,
  endsWithSeparator,
  format,
  isFilled,
  parse,
  placeholder,
  remainingFormat,
  typeDigit,
} from "../../../common/dates/format";

export type DateInputValue = DayISO | "";

export interface Input {
  value: DateInputValue;
  valueChange: (value: DateInputValue) => void;
  locale: string;
  index: 0 | 1;
  id?: string;
  name?: string;
  "aria-label"?: string;
  disabled?: boolean;
  readonly?: boolean;
  invalid?: boolean;
  /** Called when typing at the end fills in the last part of the date. */
  onFilled?: () => void;
  onInvalidDate?: (
    event: Event,
    target: HTMLElement,
    value: string,
    index: number,
  ) => void;
}

<const/{
  locale,
  index,
  id,
  name,
  "aria-label": ariaLabel,
  disabled,
  readonly,
  onFilled,
  onInvalidDate,
}=input>
<let/value:=input.value>
<const/hint=placeholder(locale)>

// Text the user typed shows until the value changes some other way.
<let/draft=(
  undefined as
    { key: DateInputValue; text: string; invalid: boolean } | undefined
)>
<const/typed=draft?.key === value ? draft : undefined>
<script>
  // A date set from outside, as from the calendar, discards the typed text.
  if (draft && draft.key !== value) draft = undefined;
</script>
<const/text=typed ? typed.text : value ? format(value, locale) : "">
<const/commit(next: string) {
  const parsed = next.trim() ? parse(next, locale) : "";
  if (parsed === null) {
    draft = { key: value, text: next, invalid: true };
    return false;
  }
  draft = undefined;
  value = parsed;
  return true;
}>
<let/focused=false>
<id/formlessId>
<const/rest=focused ? remainingFormat(text, locale) : undefined>

// The hidden ::after sizes the field to what it shows: text and format hint,
// or the placeholder.
<span class="date-textbox__field" data-size=text + (rest ?? "") || hint>
  <input/$input
    id=id
    class="date-textbox__input"
    aria-label=ariaLabel
    aria-invalid=(input.invalid || typed?.invalid) && "true"
    inputmode="numeric"
    autocomplete=(
      "off"
      // No element has this id, so the text belongs to no form; only the hidden
    )
    form=formlessId
    placeholder=hint
    disabled=disabled
    readonly=readonly
    value=text
    valueChange(next) {
      if (next) {
        draft = { key: value, text: next, invalid: false };
      } else {
        commit("");
      }
    }
    onChange(e, el) {
      if (!commit(el.value)) {
        onInvalidDate && onInvalidDate(e, el, el.value, index);
      }
    }
    onBeforeInput(e, el) {
      const { value: current, selectionStart, selectionEnd } = el;
      const data = e.data ?? "";
      const collapsed = selectionStart === selectionEnd;
      if (
        e.inputType === "insertText" &&
        collapsed &&
        selectionEnd === current.length
      ) {
        if (/^\d$/.test(data)) {
          const insert = typeDigit(current, data, locale);
          if (insert !== data) {
            e.preventDefault();
            // Unlike setting the value, this keeps the edit on the undo stack.
            document.execCommand("insertText", false, insert);
          }
        } else if (
          /^[^\p{L}\d]$/u.test(data) &&
          endsWithSeparator(current, locale)
        ) {
          e.preventDefault();
        }
      } else if (
        (e.inputType === "deleteContentBackward" ||
          e.inputType === "deleteContentForward") &&
        collapsed
      ) {
        const edit = editAtSeparator(
          current,
          selectionStart ?? 0,
          e.inputType === "deleteContentForward",
        );
        if (edit) {
          e.preventDefault();
          el.setSelectionRange(edit.start, edit.end);
          if (edit.start !== edit.end) document.execCommand("delete");
        }
      }
    }
    onFocus() {
      focused = true;
    }
    onBlur() {
      focused = false;
    }
    onInput(e, el) {
      if (
        (e as InputEvent).inputType === "insertText" &&
        el.selectionEnd === el.value.length &&
        isFilled(el.value, locale)
      ) {
        onFilled && onFilled();
      }
    }
  >
  <if=rest>
    <span class="date-textbox__ghost" aria-hidden="true">
      <span>${text}</span>${rest}
    </span>
  </if>
</span>
<if=name>
  <input type="hidden" name=name value=value disabled=disabled>
</if>

<return=$input>
