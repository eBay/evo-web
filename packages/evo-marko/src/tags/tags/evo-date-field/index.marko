import { type DayISO } from "../../../common/dates/date-utils";
import {
  format,
  maskDate,
  parse,
  placeholder as localePlaceholder,
} from "../../../common/dates/format";
import type { Input as TextboxInput } from "<evo-input>";

export type DateInputValue = DayISO | "";

export type FieldInput = Omit<
  TextboxInput,
  | "value"
  | "valueChange"
  | "type"
  | "disabled"
  | "readonly"
  | "prefixIcon"
  | "postfixIcon"
  | "prefixText"
  | "postfixText"
>;

export interface Input {
  value: DateInputValue;
  locale?: string;
  index: 0 | 1;
  disabled?: boolean;
  readonly?: boolean;
  invalid?: boolean;
  field?: FieldInput;
  trigger?: {
    a11yText: string;
    open: boolean;
    popoverId: string;
    toggle: () => void;
  };
  valueChange: (value: DateInputValue) => void;
  onInvalidDate?: (
    event: Event,
    target: HTMLElement,
    value: string,
    index: number,
  ) => void;
}

<const/{ value, locale, index, disabled, readonly, trigger, valueChange }=input>
<const/{
  placeholder,
  invalid: fieldInvalid,
  onBlur,
  ...field
}=input.field ?? ({} as FieldInput)>

<let/draft=null as string | null>
<let/invalid=false>
<let/prevValue=value>
<script>
  // An external change to the committed value discards any in-progress draft.
  if (value !== prevValue) {
    prevValue = value;
    draft = null;
    invalid = false;
  }
</script>
<const/display=draft ?? (value ? format(value, locale) : "")>

<evo-input/control
  ...field
  disabled=disabled
  readonly=readonly
  invalid=fieldInvalid || invalid || input.invalid
  placeholder=placeholder ?? localePlaceholder(locale)
  value=display
  valueChange(next) {
    draft = maskDate(next, locale, next.length > display.length);
    invalid = false;
  }
  onBlur(e, el) {
    const text = (e.target as HTMLInputElement).value;
    if (text.trim() === "") {
      draft = null;
      invalid = false;
      valueChange("");
    } else {
      const parsed = parse(text, locale);
      if (parsed === null) {
        invalid = true;
        input.onInvalidDate && input.onInvalidDate(e, el, text, index);
      } else {
        draft = null;
        invalid = false;
        valueChange(parsed);
      }
    }
    onBlur && onBlur(e, el);
  }
>
  <if=trigger>
    <@postfixIcon
      a11yText=trigger.a11yText
      aria-expanded=trigger.open ? "true" : "false"
      aria-controls=trigger.popoverId
      onClick() {
        trigger.toggle();
      }
    >
      <evo-icon-calendar-24/>
    </@postfixIcon>
  </if>
</evo-input>

<return=control>
