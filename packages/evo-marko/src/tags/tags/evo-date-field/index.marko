import { type DayISO } from "../../../common/dates/date-utils";
import {
  editAtSeparator,
  endsWithSeparator,
  format,
  isFilled,
  parse,
  placeholder,
  remainingFormat,
  typeDigit,
} from "../../../common/dates/format";

export type DateInputValue = DayISO | "";

static const BLOCKS_IMPLICIT_SUBMISSION =
  /^(text|search|url|tel|email|password|date|month|week|time|datetime-local|number)$/;

// Enter in a field of `form`, as the browser handles it for the form's own
// fields: click the default button, or submit if no other field would stop it.
static function submitImplicitly(form: HTMLFormElement) {
  const controls = [...form.elements] as HTMLInputElement[];
  const button = controls.find(
    (control) => control.type === "submit" || control.type === "image",
  );
  if (button) {
    if (!button.disabled) button.click();
    return;
  }
  const fields =
    controls.filter((control) => BLOCKS_IMPLICIT_SUBMISSION.test(control.type))
      .length + form.querySelectorAll(".date-textbox__input").length;
  if (fields === 1) form.requestSubmit();
}

export interface Input {
  value: DateInputValue;
  valueChange: (value: DateInputValue) => void;
  locale: string;
  index: 0 | 1;
  id?: string;
  name?: string;
  "aria-label"?: string;
  disabled?: boolean;
  readonly?: boolean;
  invalid?: boolean;
  /** Called when typing at the end fills in the last part of the date. */
  onFilled?: () => void;
  onInvalidDate?: (
    event: Event,
    target: HTMLElement,
    value: string,
    index: number,
  ) => void;
}

<const/{
  locale,
  index,
  id,
  name,
  "aria-label": ariaLabel,
  disabled,
  readonly,
  onFilled,
  onInvalidDate,
}=input>
<let/value:=input.value>
<const/hint=placeholder(locale)>

// Text the user typed shows until the value changes some other way.
<let/draft=(
  undefined as
    { key: DateInputValue; text: string; invalid: boolean } | undefined
)>
<const/typed=draft?.key === value ? draft : undefined>
<script>
  // A date set from outside, as from the calendar, discards the typed text.
  if (draft && draft.key !== value) draft = undefined;
</script>
<const/text=typed ? typed.text : value ? format(value, locale) : "">
<const/setValue(next: DateInputValue) {
  draft = undefined;
  value = next;
  // Set now rather than on render, so a submit right after sends the new date.
  $hidden().value = next;
}>
<const/commit(next: string) {
  const parsed = next.trim() ? parse(next, locale) : "";
  if (parsed === null) {
    draft = { key: value, text: next, invalid: true };
    return false;
  }
  setValue(parsed);
  return true;
}>
<let/focused=false>
<const/rest=focused ? remainingFormat(text, locale) : undefined>

// No element has this id, so the text inputs belong to no form, which only
// sees the hidden ISO input. Enter and reset are forwarded to keep the feel.
<id/formlessId>

// The hidden ::after sizes the field to what it shows: text and format hint,
// or the placeholder.
<span class="date-textbox__field" data-size=text + (rest ?? "") || hint>
  <input/$input
    id=id
    class="date-textbox__input"
    aria-label=ariaLabel
    aria-invalid=(input.invalid || typed?.invalid) && "true"
    inputmode="numeric"
    autocomplete="off"
    form=formlessId
    placeholder=hint
    disabled=disabled
    readonly=readonly
    value=text
    valueChange(next) {
      if (next) {
        draft = { key: value, text: next, invalid: false };
      } else {
        commit("");
      }
    }
    onChange(e, el) {
      if (!commit(el.value)) {
        onInvalidDate && onInvalidDate(e, el, el.value, index);
      }
    }
    onBeforeInput(e, el) {
      const { value: current, selectionStart, selectionEnd } = el;
      const data = e.data ?? "";
      const collapsed = selectionStart === selectionEnd;
      if (
        e.inputType === "insertText" &&
        collapsed &&
        selectionEnd === current.length
      ) {
        if (/^\d$/.test(data)) {
          const insert = typeDigit(current, data, locale);
          if (insert !== data) {
            e.preventDefault();
            // Unlike setting the value, this keeps the edit on the undo stack.
            document.execCommand("insertText", false, insert);
          }
        } else if (
          /^[^\p{L}\d]$/u.test(data) &&
          endsWithSeparator(current, locale)
        ) {
          e.preventDefault();
        }
      } else if (
        (e.inputType === "deleteContentBackward" ||
          e.inputType === "deleteContentForward") &&
        collapsed
      ) {
        const edit = editAtSeparator(
          current,
          selectionStart ?? 0,
          e.inputType === "deleteContentForward",
        );
        if (edit) {
          e.preventDefault();
          el.setSelectionRange(edit.start, edit.end);
          if (edit.start !== edit.end) document.execCommand("delete");
        }
      }
    }
    onFocus() {
      focused = true;
    }
    onBlur() {
      focused = false;
    }
    onKeyDown(e, el) {
      const form = $hidden().form;
      // Invalid text doesn't submit, as it blocks a native date input's form.
      if (e.key === "Enter" && !e.isComposing && form && commit(el.value)) {
        submitImplicitly(form);
      }
    }
    onInput(e, el) {
      if (
        (e as InputEvent).inputType === "insertText" &&
        el.selectionEnd === el.value.length &&
        isFilled(el.value, locale)
      ) {
        onFilled && onFilled();
      }
    }
  >
  <if=rest>
    <span class="date-textbox__ghost" aria-hidden="true">
      <span>${text}</span>${rest}
    </span>
  </if>
</span>
<input/$hidden type="hidden" name=name value=value disabled=disabled>
<let/initialValue=input.value>
<script>
  document.addEventListener(
    "reset",
    (e) => {
      if (e.target === $hidden().form) setValue(initialValue);
    },
    { signal: $signal },
  );
</script>

<return=$input>
