static const boxes = ["A", "B", "C", "D"];

<let/checkedValue=[] as string[]>
<const/checked=checkedValue.length === boxes.length ? "true" as const : checkedValue.length ? "mixed" as const : "false" as const>

<div class="field">
    <id/id>
    <evo-tri-state-checkbox
        checked=checked
        checkedChange() {
            if (checked === "true") {
                checkedValue = [];
            } else {
                checkedValue = boxes;
            }
        }
        id=id/>
    <label class="field__label field__label--end" for=id>
        Select all
    </label>
</div>
<div class="container" style="margin-left: 10px;">
    <for|value| of=boxes>
        <id/id>
        <div class="field">
            <evo-checkbox
                id=id
                value=value
                checkedValue:=checkedValue/>
            <label class="field__label field__label--end" for=id>
                Option ${value}
            </label>
        </div>
    </for>
</div>
