import { type Input as ListboxButtonInput } from "<evo-listbox-button>";

export interface Input extends ListboxButtonInput<string> {}

<let/selected=input.selected ?? "A" valueChange=input.selectedChange>

<evo-listbox-button ...input selected:=selected>
    <@option value="A">Option A</>
    <@option value="B">Option B</>
    <@option value="C">Option C</>
</evo-listbox-button>

<for|value| of=["A", "B", "C"]>
  <label>
    <input type="radio" value=value checkedValue:=selected>
    ${value}
  </label>
</for>
