<const/options=[
  {
    value: 1,
    text: "Option 1",
  },
  {
    value: 2,
    text: "Option 2",
  },
  {
    value: 3,
    text: "Option 3",
  },
]>
<evo-listbox-button a11ySelectedText="selected" name="formFieldName">
  <for|option| of=options>
    <@option value=option.value>${option.text}</@option>
  </for>
</evo-listbox-button>
