import { type Input as AccordionInput } from "<evo-accordion>";
export interface Input extends AccordionInput<number | number[]> {}

<let/open=(input.open ?? 0) valueChange=input.openChange>
<let/openString=(
  Array.isArray(open) ? open.map(String) : open + ""
) valueChange(o) {
  open = Array.isArray(o) ? o.map((o) => +o) : +o;
}>

<label>
  <evo-switch
    checked=Array.isArray(open)
    checkedChange() {
      if (Array.isArray(open)) {
        open = open[0] ?? -1;
      } else {
        open = open === -1 ? [] : [open];
      }
    }/>
  ${" "}select ${Array.isArray(open) ? "multiple" : "one"}
</label>

<div>
  <for|i| until=3>
    <label>
      <input
        type=(Array.isArray(open) ? "checkbox" : "radio")
        value=i + ""
        checkedValue:=openString>
      ${" "}${i}
    </label>
  </for>
</div>

<evo-accordion ...input open:=open a11yText="Accordion Menu">
