export interface Input extends Marko.HTML.Button {
    selected?: boolean;
    selectedChange?: (selected: boolean) => void;
}

<const/{
    content,
    class: inputClass,
    selected: selectedInput,
    onClick,
    ...htmlInput
}=input>

<let/selected:=input.selected>

<button
    ...htmlInput
    class=["selection-chip", "selection-chip--animated", inputClass]
    aria-pressed=(selected ? "true" : "false")
    type="button"
    onClick(e, el) {
        selected = !selected;
        input.onClick && input.onClick(e, el);
    }>
    <span class="selection-chip__text">
        <${content}/>
    </span>
    <evo-icon-close-12 class="selection-chip__trailing"/>
</button>
