<let/sortSelected="price-low">
<let/filterSelected=["shipping-free"]>
<evo-menu ...input>
  <@group selected:=sortSelected>
    <@item value="price-low">
      Price: low to high
    </@item>
    <@item value="price-high">
      Price: high to low
    </@item>
  </@group>
  <@group selected:=filterSelected>
    <@item value="shipping-free">
      Free shipping
    </@item>
    <@item value="buy-it-now">
      Buy It Now
    </@item>
    <@item value="auction">
      Auction
    </@item>
  </@group>
</evo-menu>
