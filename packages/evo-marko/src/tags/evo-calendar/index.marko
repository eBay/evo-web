import {
  localeDefault,
  type DayISO,
  type MonthISO,
  getWeekdayInfo,
  monthOffset,
  toISO,
  fromISO,
  offsetISO,
} from "../../common/dates/date-utils";
export interface Disable {
  before?: DayISO;
  after?: DayISO;
  weekdays?: number[];
  list?: DayISO[];
  callback?: (iso: DayISO) => boolean;
}
export interface Input {
  numMonths?: number;
  locale?: string;
  selectMode?: "day" | "range";
  linkBuilder?: (iso: DayISO) => string | false | null | undefined;
  selected?: DayISO | { from: DayISO; to: DayISO };
  selectedChange?: (s: DayISO | { from: DayISO; to: DayISO }) => void;
  today?: DayISO;
  disable?: Disable;
  viewStart?: MonthISO;
  viewStartChange?: (m: MonthISO) => void;
  /**
   * Must be present to allow navigation between months
   *
   * Should return a string like `"Show ${month}"`
   */
  a11yNavigateText?: (monthName: string, dir: "next" | "prev") => string;
  /**
   * Clipped text to communicate the current day cells to screen readers, required for non-interactive calendars
   *
   * English default to be overridden is `"selected"`
   **/
  a11yTodayText?: string;
  /**
   * Clipped text to communicate disabled cells to screen readers, required only in non-interactive calendars when any days are or will be disabled
   *
   * English default to be overridden is `"disabled"`
   **/
  a11yDisabledText?: string;
  /**
   * Clipped text to communicate selected cells to screen readers, required for non-interactive calendars if any days are or will be selected
   *
   * English default to be overridden is `"selected"`
   **/
  a11ySelectedText?: string;
  /**
   * Clipped text to communicate range cells to screen readers, required if there is or will be a selected range
   */
  a11yRangeText?: {
    /**
     * English default to be overridden is `"start of range"`
     */
    start: string;
    /**
     * English default to be overridden is `"end of range"`
     */
    end: string;
    /**
     * English default to be overridden is `"in range"`
     */
    in: string;
  };
}
<let/systemDay=getTodayISO()>
<script>
  systemDay = getTodayISO();
</script>

<const/locale=localeDefault(input.locale)>

<const/{
  a11yNavigateText,
  numMonths = 1,
  selectMode,
  today = systemDay,
  linkBuilder,
  disable,
  a11yTodayText,
  a11yDisabledText,
  a11ySelectedText,
  a11yRangeText,
}=input>

<let/selected:=input.selected>
// `viewStart` is the first displayed month (YYYY-MM). `valueChange` notifies `input.viewStartChange`.
// `focus` is fully uncontrolled — always within the visible window, resets when viewStart changes.
<let/viewStart=(input.viewStart ?? today.slice(0, 7) as MonthISO) valueChange=input.viewStartChange>
<let/focus=(viewStart + "-01" as DayISO)>
<script>
  // If viewStart changes externally and focus is no longer in the window, reset it.
  if (focus.slice(0, 7) < viewStart || focus.slice(0, 7) > monthOffset(viewStart, numMonths - 1)) {
    focus = viewStart + "-01" as DayISO;
  }
</script>

<const/{ firstDayOfWeek, weekdayLabels }=getWeekdayInfo(locale)>

<let/bodyHasFocus=false>
<let/hoverDate=null as null | DayISO>
<const/range=(() => {
  if (selectMode !== "range") return null;
  if (typeof selected === "object") return selected;
  const interactingWith = hoverDate || (bodyHasFocus && focus);
  if (interactingWith && selected) {
    return selected > interactingWith
      ? { from: interactingWith, to: selected }
      : { from: selected, to: interactingWith };
  }
  return null;
})()>

<div class="calendar">
  <if=a11yNavigateText>
    <div class="calendar__header">
      <div class="calendar__header--inner">
        <evo-icon-button
          onClick() {
            viewStart = monthOffset(viewStart, -1);
            if (focus.slice(0, 7) > monthOffset(viewStart, numMonths - 1)) focus = viewStart + "-01" as DayISO;
          }
          a11yText=a11yNavigateText(getMonthName(locale, viewStart, -1), "prev")>
          <evo-icon-chevron-left-24/>
        </evo-icon-button>
        <for|i| until=numMonths>
          <h3>${getMonthName(locale, viewStart, i)}</h3>
        </for>
        <evo-icon-button
          onClick() {
            viewStart = monthOffset(viewStart, 1);
            if (focus.slice(0, 7) < viewStart) focus = monthOffset(viewStart, numMonths - 1) + "-01" as DayISO;
          }
          a11yText=a11yNavigateText(getMonthName(locale, viewStart, numMonths), "next")>
          <evo-icon-chevron-right-24/>
        </evo-icon-button>
      </div>
    </div>
  </if>
  <div
    class="calendar__body"
    onFocusIn() {
      bodyHasFocus = true;
    }
    onFocusOut(e, el) {
      bodyHasFocus = el.contains(e.relatedTarget as Node);
    }
    onKeyDown(e) {
      if (e.key in DAY_UPDATE_KB) {
        const change = DAY_UPDATE_KB[e.key as keyof typeof DAY_UPDATE_KB];
        e.preventDefault();
        const windowFirst = viewStart + "-01" as DayISO;
        const windowLast = toISO(new Date(getMonthDate(viewStart, numMonths).setUTCDate(0)));
        const earliest = disable?.before && disable.before > windowFirst ? disable.before : windowFirst;
        const latest = disable?.after && disable.after < windowLast ? disable.after : windowLast;
        let iso = focus;
        let tries = 31;
        do { iso = offsetISO(iso, change); } while (tries-- > 0 && disable && isDisabled(disable, iso));
        if (iso < earliest) iso = earliest;
        else if (iso > latest) iso = latest;
        focus = iso;
      } else switch (e.key) {
        case "PageUp": {
          e.preventDefault();
          viewStart = monthOffset(viewStart, -1);
          if (focus.slice(0, 7) > monthOffset(viewStart, numMonths - 1)) focus = viewStart + "-01" as DayISO;
          break;
        }
        case "PageDown": {
          e.preventDefault();
          viewStart = monthOffset(viewStart, 1);
          if (focus.slice(0, 7) < viewStart) focus = monthOffset(viewStart, numMonths - 1) + "-01" as DayISO;
          break;
        }
        case "Home": {
          e.preventDefault();
          focus = viewStart + "-01" as DayISO;
          break;
        }
        case "End": {
          e.preventDefault();
          const { year: veY, month: veM } = getMonthInfo(viewStart, numMonths - 1);
          focus = toISO(new Date(Date.UTC(veY, veM + 1, 0)));
          break;
        }
      }
    }>
    <for|i| until=numMonths>
      <div class="calendar__month">
        <table>
          <caption>${getMonthName(locale, viewStart, i)}</caption>
          <thead>
            <tr>
              <for|dayName| of=weekdayLabels>
                <th>${dayName}</th>
              </for>
            </tr>
          </thead>
          <tbody>
            <const/{ year, month, firstWeekday, length }=getMonthInfo(
              viewStart,
              i,
            )>
            <const/blankDays=(firstWeekday - firstDayOfWeek + 7) % 7>
            <for|row| until=Math.ceil((blankDays + length) / 7)>
              <tr>
                <const/startDate=row * 7 - blankDays + 1>
                <const/endDate=Math.min(startDate + 7, length + 1)>
                <if=row === 0 && blankDays !== 0>
                  <td colspan=blankDays/>
                </if>
                <for|day| from=Math.max(startDate, 1) until=endDate>
                  <const/iso=toISO(new Date(Date.UTC(year, month, day)))>
                  <const/isSelected=(
                    typeof selected === "object"
                      ? selected.from === iso || selected.to === iso
                      : selected === iso
                  )>
                  <const/rangeStart=range && range.from === iso>
                  <const/rangeEnd=range && range.to === iso>
                  <const/inRange=(range && iso > range.from && iso < range.to)>
                  <const/disabled=disable && isDisabled(disable, iso)>
                  <td class={
                    "calendar__cell--selected": isSelected,
                    "calendar__range--start": rangeStart,
                    calendar__range: inRange,
                    "calendar__range--end": rangeEnd,
                  }>
                    <if=selectMode>
                      <script>
                        if (bodyHasFocus && focus === iso) $el().focus();
                      </script>
                      <button/$el
                        type="button"
                        disabled=disabled
                        aria-label=(
                          [
                            day,
                            rangeStart && a11yRangeText?.start,
                            inRange && a11yRangeText?.in,
                            rangeEnd && a11yRangeText?.end,
                          ]
                            .filter(Boolean)
                            .join(" - ")
                        )
                        tabindex=(focus !== iso && -1)
                        aria-current=iso === today && "date"
                        aria-pressed=isSelected && "true"
                        onMouseEnter() {
                          hoverDate = iso;
                        }
                        onMouseLeave() {
                          hoverDate = null;
                        }
                        onClick() {
                          focus = iso;
                          if (selectMode === "day") {
                            selected = iso;
                          } else if (selectMode === "range") {
                            if (typeof selected === "object") {
                              selected = iso;
                            } else if (selected) {
                              selected =
                                selected > iso
                                  ? { from: iso, to: selected }
                                  : { from: selected, to: iso };
                            } else {
                              selected = iso;
                            }
                          }
                        }>
                        ${day}
                      </button>
                    </if>
                    <else>
                      <const/link=!disabled && linkBuilder?.(iso)>
                      <${link ? "a" : "span"}
                        class={
                          "calendar__cell--disabled": disabled,
                          "calendar__cell--current": iso === today,
                        }
                        href=link>
                        ${day}
                        <const/clippedText=(
                          [
                            "",
                            today && a11yTodayText,
                            selected && a11ySelectedText,
                            rangeStart && a11yRangeText?.start,
                            inRange && a11yRangeText?.in,
                            rangeEnd && a11yRangeText?.end,
                            disabled && a11yDisabledText,
                          ]
                            .filter(Boolean)
                            .join(" - ")
                        )>
                        <if=clippedText>
                          <span class="clipped">
                            ${clippedText}
                          </span>
                        </if>
                      </>
                    </else>
                  </td>
                </for>
              </tr>
            </for>
          </tbody>
        </table>
      </div>
    </for>
  </div>
</div>
static function getTodayISO() {
  return toISO(new Date());
}
static function getMonthName(
  locale: string,
  date: DayISO | MonthISO,
  offset: number,
) {
  return new Intl.DateTimeFormat(locale, {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(getMonthDate(date, offset));
}
static function getMonthInfo(baseDate: DayISO | MonthISO, offset: number) {
  const date = getMonthDate(baseDate, offset);
  const year = date.getUTCFullYear();
  const month = date.getUTCMonth();

  return {
    year,
    month,
    firstWeekday: date.getUTCDay(),
    length: new Date(Date.UTC(year, month + 1, 0)).getUTCDate(),
  };
}
static function getMonthDate(date: DayISO | MonthISO, offset: number) {
  const [year, month] = date.split("-").map(Number);
  return new Date(Date.UTC(year, month + offset - 1));
}
static function isDisabled(
  { before, after, weekdays, list, callback }: Disable,
  date: DayISO,
) {
  return (
    (after && date > after) ||
    (before && date < before) ||
    weekdays?.includes(fromISO(date).getUTCDay()) ||
    list?.includes(date) ||
    callback?.(date)
  );
}
static const DAY_UPDATE_KB = {
  ArrowRight: 1,
  ArrowLeft: -1,
  ArrowDown: 7,
  ArrowUp: -7,
};
