export interface Input extends Marko.HTML.Span {
  /**
   * @deprecated Use `tone`. Maps: trustworthy → information, recent → positive, time-sensitive → attention, neutral → neutral.
   */
  status?: "trustworthy" | "recent" | "time-sensitive" | "neutral";
  tone?: "neutral" | "information" | "positive" | "warning" | "attention";
  emphasis?: "default" | "strong" | "subtle";
  icon?: Marko.AttrTag<{ content?: Marko.Body }>;
}
<const/{
  class: inputClass,
  status = "neutral",
  tone,
  emphasis = "default",
  icon,
  content,
  ...htmlAttributes
}=input>

<span
  ...htmlAttributes
  class=[
    inputClass,
    "signal",
    `signal--${tone || status}`,
    emphasis !== "default" && `signal--${emphasis}`,
  ]
>
  <if=icon>
    <${icon}/>
  </if>
  <${content}/>
</span>
