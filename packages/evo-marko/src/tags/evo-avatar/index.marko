import { getColorForText } from "./util";
static type Size = 32 | 40 | 48 | 56 | 64 | 96 | 128;
static type ImagePlacement = "cover" | "fit";
export interface Input extends Omit<Marko.HTML.Div, "role"> {
    username?: string;
    color?: string;
    size?: Size | `${Size}`;
    img?: Marko.AttrTag<Omit<Marko.HTML.Img, "alt">>;
    knownAspectRatio?: number;
}

<const/{
    class: inputClass,
    size,
    color,
    img,
    username,
    content,
    knownAspectRatio,
    ...htmlInput
}=input>

<let/aspectRatio=knownAspectRatio>

<const/imagePlacement=(
    (aspectRatio && (aspectRatio < 3 / 4 || aspectRatio > 4 / 3)
        ? "fit"
        : "cover") as ImagePlacement
)>

<div
    ...htmlInput
    role="img"
    class=[
        "avatar",
        imagePlacement === "fit" && "avatar--fit",
        inputClass,
        size && `avatar--${size}`,
        username && !img && `avatar--${getColorForText(username, color)}`,
    ]>
    <if=img>
        <img
            ...img
            alt=""
            onLoad(_, el) {
                aspectRatio = el.naturalWidth / el.naturalHeight;
            }
        >
    </if>
    <else if=content>
        <${content}/>
    </else>
    <else if=username>
        ${username.charAt(0).toUpperCase()}
    </else>
    <else>
        <evo-icon-avatar-signed-out/>
    </else>
</div>
