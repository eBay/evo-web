export interface Input extends Marko.HTML.Span {
    /**
     * The `aria-label` for the progress spinner
     * 
     * English default to be overridden is `"Loading"`
     */
    a11yText: Marko.HTML.Span["aria-label"];
    size?: "large" | "small";
}
<const/{
    class: inputClass,
    a11yText = "Loading",
    size,
    ...htmlInput
}=input/>

<span
    ...htmlInput
    aria-label=a11yText
    class=[
        "progress-spinner",
        size === "large" && "progress-spinner--large",
        inputClass,
    ]
    role="img"
>
    <if=size === "large">
        <evo-icon-spinner-30/>
    </if>
    <else if=size === "small">
        <evo-icon-spinner-20/>
    </else>
    <else>
        <evo-icon-spinner-24/>
    </else>
</span>
