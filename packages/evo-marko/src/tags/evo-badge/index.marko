export interface Input extends Omit<Marko.HTML.Span, "role" | "aria-label"> {
  type?: "menu" | "icon";
  number?: number | string;
  /**
   * The `aria-label` of the badge
   *
   * English default to be overridden is `"n notifications"`
   *
   * Pass `null` explicitly _only_ if alternative accessibility information is present
   */
  a11yText: string | null;
}
<const/{
  class: inputClass,
  type,
  number,
  a11yText = number ? `${number} notifications` : "notification",
  ...htmlInput
}=input>

<const/role=type !== "menu" && type !== "icon" && ("img" as const)>

<if=number == undefined>
  <span ...htmlInput aria-label=a11yText role=role class=["badge", inputClass]/>
</if>
<else if=(+number > 99)>
  <span ...htmlInput aria-label=a11yText role=role class=["badge", inputClass]>
    99+
  </span>
</else>
<else if=(+number > 0)>
  <span
    ...htmlInput
    aria-label=a11yText
    role=role
    class=["badge", "badge--circle", inputClass]>
    ${number}
  </span>
</else>
