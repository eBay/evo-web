{
  "name": "@evo-web/marko",
  "version": "0.1.4",
  "description": "Collection of core eBay components; considered to be the building blocks for all composite structures, pages & apps.",
  "keywords": [
    "marko-components",
    "marko-tags"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ebay/evo-core"
  },
  "license": "MIT",
  "files": [
    "dist",
    "marko.json",
    "!**/*test*",
    "!**/examples",
    "!**/storybook",
    "!*.tsbuildinfo",
    "!**/{,*.}stories.*"
  ],
  "scripts": {
    "build": "mtc && cp -r src/node_modules dist/",
    "build:readme": "node scripts/add-ds-version",
    "build:storybook": "storybook build -o ./_site",
    "deploy": "exit 0",
    "format": "eslint --fix; prettier . --write --log-level=warn",
    "importSVG": "tsx scripts/import-svg && prettier \"{./src/tags/evo-{icon,flag,star-rating,image-placeholder}/**/*,**/*.{js,ts,json,MD}}\" --write --log-level=warn",
    "lint": "mtc && eslint && prettier . --check --log-level=warn",
    "prepublishOnly": "exit 0",
    "postpublish": "exit 0",
    "release": "exit 0",
    "start": "storybook dev -p 6006 --no-open",
    "test": "vitest run --browser.headless",
    "test:browser": "vitest run browser",
    "test:ci": "CI=true vitest run --no-color",
    "test:server": "vitest run server",
    "test:watch": "vitest",
    "version": "exit 0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@google/model-viewer": "^4.1.0",
    "highcharts": "^12.4.0",
    "makeup-active-descendant": "0.7.10",
    "makeup-expander": "~0.11.9",
    "makeup-floating-label": "~0.4.9",
    "makeup-focusables": "~0.4.5",
    "makeup-key-emitter": "~0.4.7",
    "makeup-keyboard-trap": "~0.5.7",
    "makeup-prevent-scroll-keys": "~0.3.4",
    "makeup-roving-tabindex": "~0.7.7",
    "makeup-screenreader-trap": "~0.5.6",
    "makeup-typeahead": "^0.3.3",
    "shaka-player": "4.16.12"
  },
  "devDependencies": {
    "marko": "^6.0.136"
  },
  "peerDependencies": {
    "@ebay/skin": "^19.2.0",
    "marko": "5 - 6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
