{
  "name": "@evo-web/marko",
  "version": "0.5.2",
  "description": "Collection of core eBay components; considered to be the building blocks for all composite structures, pages & apps.",
  "keywords": [
    "marko-components",
    "marko-tags"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eBay/evo-web.git",
    "directory": "packages/evo-marko"
  },
  "license": "MIT",
  "files": [
    "dist",
    "marko.json",
    "!**/*test*",
    "!**/examples",
    "!**/storybook",
    "!*.tsbuildinfo",
    "!**/{,*.}stories.*"
  ],
  "scripts": {
    "build": "mtc",
    "build:icons": "pnpm importSVG",
    "build:readme": "node scripts/add-ds-version",
    "build:storybook": "storybook build -o ./_site",
    "deploy": "storybook build -o ./_site",
    "format": "eslint --fix; prettier . --write --log-level=warn",
    "generate-locale-info": "node scripts/generate-locale-info && prettier --write src/common/dates/locale-info.ts",
    "importSVG": "tsx scripts/import-svg",
    "lint": "mtc && eslint && prettier . --check --log-level=warn",
    "prepublishOnly": "node scripts/prepublish",
    "postpublish": "node scripts/postpublish",
    "release": "mtc",
    "start": "storybook dev -p 6006 --no-open",
    "test": "vitest run --browser.headless",
    "test:browser": "vitest run browser",
    "test:ci": "CI=true vitest run --no-color",
    "test:server": "vitest run server",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@google/model-viewer": "catalog:",
    "highcharts": "catalog:",
    "makeup-active-descendant": "catalog:",
    "makeup-expander": "catalog:",
    "makeup-floating-label": "catalog:",
    "makeup-focusables": "catalog:",
    "makeup-key-emitter": "catalog:",
    "makeup-keyboard-trap": "catalog:",
    "makeup-prevent-scroll-keys": "catalog:",
    "makeup-roving-tabindex": "catalog:",
    "makeup-screenreader-trap": "catalog:",
    "makeup-typeahead": "catalog:",
    "shaka-player": "catalog:"
  },
  "devDependencies": {
    "@babel/register": "catalog:",
    "@ebay/skin": "workspace:^",
    "@eslint/js": "catalog:",
    "@marko/compiler": "catalog:",
    "@marko/language-tools": "catalog:",
    "@marko/testing-library": "catalog:",
    "@marko/type-check": "catalog:",
    "@marko/vite": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/icons": "^2.0.1",
    "@storybook/marko": "catalog:",
    "@storybook/marko-vite": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cheerio": "catalog:",
    "cldr-core": "catalog:",
    "cldr-dates-full": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "html-minifier": "catalog:",
    "libphonenumber-js": "catalog:",
    "marko": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "visual-html": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@ebay/skin": "^19.2.0",
    "marko": "5 - 6"
  }
}
