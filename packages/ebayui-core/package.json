{
    "name": "@ebay/ebayui-core",
    "version": "16.11.1",
    "description": "Collection of core eBay components; considered to be the building blocks for all composite structures, pages & apps.",
    "keywords": [
        "marko-components"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eBay/evo-web.git",
        "directory": "packages/ebayui-core"
    },
    "license": "MIT",
    "files": [
        "dist",
        "!*.marko.js",
        "!**/test*",
        "marko.json",
        "*.browser.json",
        "marketplace.json",
        "!**/{,*.}stories.*",
        "!**/{,*.}stories-ignore.*"
    ],
    "scripts": {
        "build": "rm -rf dist && concurrently --kill-others-on-fail \"mtc\" \"pnpm lint\" \"node scripts/check-postpublish\" \"pnpm test\"",
        "build:icons": "pnpm importSVG",
        "build:readme": "node scripts/add-ds-version",
        "coverage": "vitest run --browser.headless --coverage",
        "deploy": "storybook build -o ./_site",
        "importSVG": "node scripts/import-svg && prettier \"{./src/components/ebay-{icon,flag,star-rating,image-placeholder}/**/*,**/*.{js,ts,json,MD}}\" --write --log-level=warn",
        "lint": "pnpm lint:less && pnpm lint:js && pnpm lint:whitespace",
        "lint:js": "eslint",
        "lint:less": "stylelint \"src/**/*.{css,less}\" --config .stylelintrc",
        "lint:whitespace": "lintspaces *.md src/**/*.md src/**/*.marko src/**/*.less --newline --maxnewlines 1 --trailingspaces --spaces 4",
        "prepublishOnly": "node scripts/postpublish && mtc && node scripts/prepublish",
        "postpublish": "node scripts/postpublish",
        "release": "node scripts/postpublish && node scripts/prepublish",
        "report": "nyc report --reporter=text-summary",
        "start": "storybook dev -p 6006 --no-open",
        "start:prod": "NODE_ENV=production pnpm start",
        "storybook": "storybook dev -p 6006",
        "tb": "pnpm test:browser",
        "test": "vitest run --browser.headless",
        "test:browser": "vitest run browser",
        "test:ci": "CI=true vitest run --no-color",
        "test:server": "vitest run server",
        "test:visual": "vitest run",
        "test:watch": "vitest",
        "tr": "pnpm coverage && pnpm report && open .coverage/index.html",
        "ts": "pnpm test:server",
        "tt": "mtc",
        "update-snapshots": "vitest run -u --browser.headless",
        "version": "pnpm importSVG && pnpm build:readme"
    },
    "dependencies": {
        "@floating-ui/dom": "catalog:",
        "@google/model-viewer": "catalog:",
        "@marko-tags/subscribe": "^0.5.2",
        "highcharts": "catalog:",
        "makeup-active-descendant": "catalog:",
        "makeup-expander": "catalog:",
        "makeup-floating-label": "catalog:",
        "makeup-focusables": "catalog:",
        "makeup-key-emitter": "catalog:",
        "makeup-keyboard-trap": "catalog:",
        "makeup-prevent-scroll-keys": "catalog:",
        "makeup-roving-tabindex": "catalog:",
        "makeup-screenreader-trap": "catalog:",
        "makeup-typeahead": "catalog:",
        "shaka-player": "catalog:"
    },
    "devDependencies": {
        "@babel/core": "catalog:",
        "@babel/eslint-parser": "^7.28.5",
        "@babel/plugin-syntax-import-assertions": "^7.27.1",
        "@babel/preset-env": "catalog:",
        "@babel/preset-typescript": "catalog:",
        "@babel/register": "catalog:",
        "@ebay/skin": "workspace:^",
        "@eslint/eslintrc": "^3.3.3",
        "@marko/compiler": "catalog:",
        "@marko/language-tools": "catalog:",
        "@marko/testing-library": "catalog:",
        "@marko/type-check": "catalog:",
        "@marko/vite": "catalog:",
        "@storybook/addon-a11y": "catalog:",
        "@storybook/addon-docs": "catalog:",
        "@storybook/marko": "catalog:",
        "@storybook/marko-vite": "catalog:",
        "@types/mdx": "^2.0.13",
        "@types/node": "catalog:",
        "@vitest/browser": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "chai": "^5.3.3",
        "cheerio": "catalog:",
        "cldr-core": "catalog:",
        "cldr-dates-full": "catalog:",
        "concurrently": "catalog:",
        "del": "catalog:",
        "diff": "^8.0.2",
        "eslint": "catalog:",
        "eslint-config-ebay": "catalog:",
        "eslint-config-prettier": "catalog:",
        "html-minifier": "catalog:",
        "libphonenumber-js": "catalog:",
        "lintspaces-cli": "^1.0.0",
        "marko": "^5.38.38",
        "playwright": "catalog:",
        "prettier": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "specificity": "^1.0.0",
        "storybook": "catalog:",
        "stylelint": "catalog:",
        "stylelint-config-standard": "catalog:",
        "stylelint-order": "catalog:",
        "typescript": "catalog:",
        "visual-html": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@ebay/skin": "^19",
        "marko": "^5.38.38"
    }
}
