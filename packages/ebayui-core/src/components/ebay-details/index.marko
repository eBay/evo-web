import { processHtmlAttributes } from "../../common/html-attributes";
static function noop() {}
$ const {
    class: inputClass,
    open,
    alignment,
    size,
    summary,
    leading,
    renderBody,
    as: inputAs,
    ...htmlInput
} = input;
$ (input as any).toJSON = noop;

<details
    ...processHtmlAttributes(htmlInput)
    class=["details", inputClass]
    open=open
    key="root"
    onToggle("toggleDetails")
    onClick("clickDetails")
>
    <if(summary)>
        <summary class=[
            "details__summary",
            size === "small" && "details__summary--small",
            alignment === "center" && "details__summary--center",
        ]>
            <if(leading)>
                <span ...leading class=["details__leading", leading.class]>
                    <${leading}/>
                </span>
            </if>
            <span class="details__label">
                <${summary.renderBody}/>
            </span>
            <span class="details__icon" hidden>
                <ebay-chevron-down-16-icon/>
            </span>
        </summary>
    </if>
    <${inputAs || "div"} class="details__content">
        <${renderBody}/>
    </>
</details>
