export type Input =
    | {
          date: string;
          data: { label?: string; x: number; y?: number };
          stacked: false;
          valueFormatter: (value: number | string) => string;
          x: number;
      }
    | {
          date: string;
          data: Array<{
              name?: string;
              data: Array<{ label?: string; x: number; y?: number }>;
          }>;
          stacked: true;
          valueFormatter: (value: number | string) => string;
          x: number;
      };

<b>${input.date}</b>
<if(!input.stacked)>
    <div>
        <span>${input.data.label ?? input.valueFormatter(input.data.y ?? 0)}</span>
    </div>
</if>
<else>
    <for|series| of=input.data>
        <for|point| of=series.data>
            <if(point.x === input.x)>
                <div style="display: flex; justify-content: space-between; width: 100%; align-items: flex-start;">
                    ${series.name}
                    <span style="margin-left: 16px">
                        ${point.label ?? input.valueFormatter(point.y ?? 0)}
                    </span>
                </div>
            </if>
        </for>
    </for>
</else>
