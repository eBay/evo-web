import { table } from "../../../../sass/table.module.scss";
<div id="eek">
  <section-header/>

  <p>The following ranges are available:</p>
  <table class=table>
    <thead>
      <tr>
        <th>EEK MIN</th>
        <th>EEK MAX</th>
        <th>ICON</th>
      </tr>
    </thead>
    <tbody>
      <for|
        icon,
      | of="A+++-D, A+++-E, A+++-G, A++-E, A++-G, A+-F, A+-E, A-G".split(", ")>
        <const/range=icon.split("-")>
        <const/min=range[1]>
        <const/max=range[0]>

        <tr>
          <td>${min}</td>
          <td>${max}</td>
          <td>
            <span class="demo">
              <span class="demo__inner">
                <eek-range min=min max=max/>
              </span>
            </span>
          </td>
        </tr>
      </for>
    </tbody>
  </table>

  <p>
    And for each range, making sure each rating exists within that given range,
    the EEK can have the following ratings:
  </p>
  <p>
    Then each rating needs to have a different color. This depends on the
    distance it is from the upper range
  </p>

  <table class=table>
    <thead>
      <tr>
        <th>EEK RATING NAME</th>
        <th>

          <eek-range min="D" max="A+++"/>
        </th>
        <th>
          <eek-range min="E" max="A+++"/>
        </th>
        <th>
          <eek-range min="G" max="A+++"/>
        </th>
        <th>
          <eek-range min="E" max="A++"/>
        </th>
      </tr>
    </thead>
    <tbody>

      <for|iconName, index| of="A+++, A++, A+, A, B, C, D, E, F, G".split(", ")>
        <tr>
          <td>
            <span class="demo">
              <span class="demo__inner">
                <span class="eek__rating">
                  ${iconName}
                </span>
              </span>
            </span>
          </td>
          <td>
            <eek-rating idx=index offset=0/>
          </td>
          <td>
            <eek-rating idx=index offset=0/>
          </td>
          <td>
            <eek-rating idx=index offset=0/>
          </td>
          <td>
            <eek-rating idx=index offset=1/>
          </td>
        </tr>
      </for>
    </tbody>
  </table>

  <table class=table>
    <thead>
      <tr>
        <th>EEK RATING NAME</th>
        <th>
          <eek-range min="G" max="A++"/>
        </th>
        <th>
          <eek-range min="F" max="A+"/>
        </th>
        <th>
          <eek-range min="E" max="A+"/>
        </th>
        <th>
          <eek-range min="G" max="A"/>
        </th>
      </tr>
    </thead>
    <tbody>
      <for|iconName, index| of="A+++, A++, A+, A, B, C, D, E, F, G".split(", ")>
        <tr>
          <td>
            <span class="demo">
              <span class="demo__inner">
                <span class="eek__rating">
                  ${iconName}
                </span>
              </span>
            </span>
          </td>
          <td>
            <eek-rating idx=index offset=1/>
          </td>
          <td>
            <eek-rating idx=index offset=2/>
          </td>
          <td>
            <eek-rating idx=index offset=2/>
          </td>
          <td>
            <eek-rating idx=index offset=3/>
          </td>
        </tr>
      </for>
    </tbody>
  </table>

  <h3 id="eek-default">
    EEK examples
  </h3>
  <div class="demo">
    <div class="demo__inner">
      <div
        class="eek eek--rating-1"
        role="img"
        aria-label="Energy Rating: A+++. Range: A+++ - D">
        <div class="eek__container" aria-hidden="true">
          <span class="eek__rating-range">
            <span>
              A+++
            </span>
            <svg class="icon icon--eek-range-arrow">
              <icon-symbol name="eek-range-arrow"/>
            </svg>
            <span>
              D
            </span>
          </span>
          <span class="eek__rating">
            A+++
