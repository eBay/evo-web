          class="textbox__control"
          id="first-name"
          type="text"
          aria-invalid="true">
      </span>
    </span>
  </highlight-code>

  <h3 id="floating-label-textarea">
    Floating Label with Textarea
  </h3>
  <p>Use the textarea tag for a multi-line textbox.</p>
  <p>
    A multi-line textbox allows line breaks and has a minimum height of 200px.
  </p>
  <p>
    In order to prevent overlap for floating label, use
    <code>.floating-label--opaque</code>
    class
  </p>
  <div class="demo">
    <div class="demo__inner">
      <span class="floating-label floating-label--opaque">
        <label class="floating-label__label" for="first-name">
          Enter list of users
        </label>
        <span class="textbox">
          <textarea aria-label="Textbox demo" class="textbox__control"/>
        </span>
      </span>
    </div>
  </div>

  <highlight-code type="html">
    <span class="floating-label floating-label--opaque">
      <label class="floating-label__label" for="first-name">
        Enter list of users
      </label>
      <span class="textbox">
        <textarea aria-label="Textbox demo" class="textbox__control"/>
      </span>
    </span>
  </highlight-code>

  <h3 id="floating-label-combobox">
    Floating label with Combobox
  </h3>
  <p>Use the textarea tag for a multi-line textbox.</p>
