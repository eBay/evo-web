<div id="floating-label">
  <section-header/>

  <h3>Floating Label with no Value</h3>
  <p>
    If the textbox has no value, the label can be positioned inside the textbox.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <span class="floating-label">
        <label class="floating-label__label" for="first-name-1">
          First Name
        </label>
        <span class="textbox">
          <input class="textbox__control" id="first-name-1" type="text">
        </span>
      </span>
    </div>
  </div>

  <highlight-code type="html">
    <span class="floating-label">
      <label class="floating-label__label" for="first-name">
        First Name
      </label>
      <span class="textbox">
        <input class="textbox__control" id="first-name" type="text">
      </span>
    </span>
  </highlight-code>

  <h3>Floating Label with Value</h3>
  <p>
    If the textbox has a value, the label must be positioned above the textbox.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <span class="floating-label">
        <label class="floating-label__label" for="last-name-1">
          Last Name
        </label>
        <span class="textbox">
          <input
            class="textbox__control"
            id="last-name-1"
            type="text"
            value="Smith">
        </span>
      </span>
    </div>
  </div>

  <highlight-code type="html">
    <span class="floating-label">
      <label class="floating-label__label" for="last-name">
        Last Name
      </label>
      <span class="textbox">
        <input
          class="textbox__control"
          id="last-name"
          type="text"
          value="Smith">
      </span>
    </span>
  </highlight-code>

  <h3>Large floating label</h3>

  <div class="demo">
    <div class="demo__inner">
      <span class="floating-label floating-label--large">
        <label class="floating-label__label" for="dob-1">
          Date Of Birth
        </label>
        <span class="textbox textbox--large">
          <input class="textbox__control" id="dob-1" type="text">
        </span>
