import { urls } from "../../../../data";
<div id="listbox-button">
  <section-header/>

  <h3 id="listbox-button-unselected">
    Unselected Listbox Button
  </h3>
  <p>By default, the listbox button is in an unselected state.</p>

  <div class="demo">
    <div class="demo__inner">
      <span class="listbox-button" data-makeup-auto-select="false">
        <button
          class="btn btn--form"
          style="min-width: 150px"
          aria-expanded="false"
          aria-haspopup="listbox">
          <span class="btn__cell">
            <span class="btn__label">
              Color:
            </span>
            <span class="btn__text">
              -
            </span>
            <svg
              class="icon icon--12"
              height="10"
              width="14"
              aria-hidden="true">
              <icon-symbol name="chevron-down-12"/>
            </svg>
          </span>
        </button>
        <div class="listbox-button__listbox">
          <div class="listbox-button__options" role="listbox">
            <div class="listbox-button__option" role="option">
              <span class="listbox-button__value">
                Red
              </span>
              <svg class="icon icon--16" height="10" width="14">
                <icon-symbol name="tick-16"/>
              </svg>
            </div>
            <div class="listbox-button__option" role="option">
              <span class="listbox-button__value">
                Blue
              </span>
              <svg class="icon icon--16" height="10" width="14">
                <icon-symbol name="tick-16"/>
              </svg>
            </div>
            <div
              class="listbox-button__option"
              role="option"
              aria-disabled="true">
              <span class="listbox-button__value">
                Yellow
              </span>
              <svg class="icon icon--16" height="10" width="14">
                <icon-symbol name="tick-16"/>
              </svg>
            </div>
            <div class="listbox-button__option" role="option">
              <span class="listbox-button__value">
                Green
              </span>
              <svg class="icon icon--16" height="10" width="14">
                <icon-symbol name="tick-16"/>
              </svg>
            </div>
          </div>
        </div>
      </span>
    </div>
  </div>

  <highlight-code type="html">
    <span class="listbox-button">
      <button
        class="btn btn--form"
        style="min-width: 150px"
        aria-expanded="false"
        aria-haspopup="listbox">
        <span class="btn__cell">
          <span class="btn__label">
            Color:
          </span>
          <span class="btn__text">
            -
          </span>
          <svg class="icon icon--12" height="10" width="14" aria-hidden="true">
            <use href="#icon-chevron-down-12"/>
          </svg>
        </span>
      </button>
      <div class="listbox-button__listbox">
        <div class="listbox-button__options" role="listbox" tabindex="0">
          <div class="listbox-button__option" role="option">
            <span class="listbox-button__value">
              Red
            </span>
            <svg class="icon icon--16" height="10" width="14">
              <use href="#icon-tick-16"/>
            </svg>
          </div>
          <div class="listbox-button__option" role="option">
            <span class="listbox-button__value">
              Blue
            </span>
            <svg class="icon icon--16" height="10" width="14">
              <use href="#icon-tick-16"/>
            </svg>
          </div>
          <div
            class="listbox-button__option"
            role="option"
            aria-disabled="true">
            <span class="listbox-button__value">
              Yellow
            </span>
            <svg class="icon icon--16" height="10" width="14">
              <use href="#icon-tick-16"/>
            </svg>
          </div>
          <div class="listbox-button__option" role="option">
            <span class="listbox-button__value">
              Green
            </span>
            <svg class="icon icon--16" height="10" width="14">
              <use href="#icon-tick-16"/>
            </svg>
          </div>
        </div>
      </div>
    </span>
  </highlight-code>

  <p>
    To give the illusion of a floated label use the
    <code>btn--floating-label</code>
    and
    <code>btn__floating-label</code>
    classes.
  </p>
  <p>
    <strong>NOTE</strong>
    : a
    <code>btn__floating-label--inline</code>
    class must also be toggled with JavaScript. It should be present when
    there is no selection, and vice versa.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <span class="listbox-button" data-makeup-auto-select="false">
        <button
          class="btn btn--form btn--floating-label"
          style="min-width: 150px"
          aria-expanded="false"
          aria-haspopup="listbox">
          <span class="btn__cell">
            <span class="btn__floating-label">
              Color
            </span>
            <span class="btn__text"/>
            <svg
              class="icon icon--12"
              height="10"
              width="14"
              aria-hidden="true">
              <icon-symbol name="chevron-down-12"/>
            </svg>
          </span>
        </button>
        <div class="listbox-button__listbox">
          <div class="listbox-button__options" role="listbox">
            <div class="listbox-button__option" role="option">
              <span class="listbox-button__value">
                Red
              </span>
              <svg class="icon icon--16" height="10" width="14">
                <icon-symbol name="tick-16"/>
              </svg>
            </div>
            <div class="listbox-button__option" role="option">
              <span class="listbox-button__value">
                Blue
              </span>
              <svg class="icon icon--16" height="10" width="14">
                <icon-symbol name="tick-16"/>
              </svg>
            </div>
            <div class="listbox-button__option" role="option">
              <span class="listbox-button__value">
                Yellow
              </span>
              <svg class="icon icon--16" height="10" width="14">
                <icon-symbol name="tick-16"/>
              </svg>
            </div>
            <div class="listbox-button__option" role="option">
              <span class="listbox-button__value">
                Green
              </span>
              <svg class="icon icon--16" height="10" width="14">
                <icon-symbol name="tick-16"/>
              </svg>
            </div>
          </div>
        </div>
      </span>
    </div>
  </div>

