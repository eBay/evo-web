      <div
        aria-labelledby="alert-dialog-title"
        aria-modal="true"
        class="alert-dialog alert-dialog--mask-fade"
        hidden
        id="alert-dialog-0"
        role="alertdialog">
        <div class="alert-dialog__window alert-dialog__window--animate">
          <div class="alert-dialog__header">
