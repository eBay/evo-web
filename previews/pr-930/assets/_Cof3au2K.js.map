import { urls } from "../../../../data";
<div id="icon-button">
  <section-header/>

  <div class="demo">
    <div class="demo__inner">
      <button class="icon-btn" type="button" aria-label="Menu">
        <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
          <icon-symbol name="menu-24"/>
        </svg>
      </button>
      <a class="icon-link" href="https://www.ebay.com" aria-label="Settings">
        <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
          <icon-symbol name="settings-24"/>
        </svg>
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <button class="icon-btn" type="button" aria-label="Menu">
      <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
        <use href="#icon-menu-24"/>
      </svg>
    </button>
    <a class="icon-link" href="https://www.ebay.com" aria-label="Settings">
      <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
        <use href="#icon-settings-24"/>
      </svg>
    </a>
  </highlight-code>

  <div class="demo">
    <div class="demo__inner">
      <button class="icon-btn icon-btn--large" type="button" aria-label="Save">
        <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
          <icon-symbol name="heart-24"/>
        </svg>
      </button>
      <button class="icon-btn" type="button" aria-label="Save">
        <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
          <icon-symbol name="heart-24"/>
        </svg>
      </button>
      <button class="icon-btn icon-btn--small" type="button" aria-label="Save">
        <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
          <icon-symbol name="heart-24"/>
        </svg>
      </button>
    </div>
  </div>

  <highlight-code type="html">
    <button class="icon-btn icon-btn--large" type="button" aria-label="Save">
      <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
        <use href="#icon-heart-24"/>
      </svg>
    </button>
    <button class="icon-btn" type="button" aria-label="Save">
      <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
        <use href="#icon-heart-24"/>
      </svg>
    </button>
    <button class="icon-btn icon-btn--small" type="button" aria-label="Save">
      <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
        <use href="#icon-heart-24"/>
      </svg>
    </button>
  </highlight-code>

  <p>
    To remove the background colour and hover states, apply the
    <code>icon-btn--transparent</code>
    modifier. This is typically needed if the icon button is placed on a
    non-default background colour or if the icon has a colour fill (as in the
    case below).
  </p>

  <div class="demo">
    <div class="demo__inner">
      <button
        class="icon-btn icon-btn--transparent"
        type="button"
        aria-label="Confirmation">
        <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
          <icon-symbol name="confirmation-filled-24"/>
        </svg>
      </button>
      <a
        class="icon-link icon-link--transparent"
        href="https://www.ebay.com"
        aria-label="Attention">
        <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
          <icon-symbol name="attention-filled-24"/>
        </svg>
      </a>
    </div>
  </div>

  <highlight-code type="html">
    <button
      class="icon-btn icon-btn--transparent"
      type="button"
      aria-label="Confirmation">
      <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
        <use href="#icon-confirmation-filled-24"/>
      </svg>
    </button>
    <a
      class="icon-link icon-link--transparent"
      href="https://www.ebay.com"
      aria-label="Attention">
      <svg class="icon icon--24" width="16" height="16" aria-hidden="true">
        <use href="#icon-attention-filled-24"/>
      </svg>
    </a>
  </highlight-code>

  <h3 id="icon-button-badged">
    Badged Icon Button
  </h3>
  <p>
    An icon button can be badged using the
    <a href=`${urls.components}/badge`>
      badge
    </a>
    module.
  </p>
  <p>
    The button or anchor element requires an additional
    <code>icon-btn--badged</code>
    or
    <code>icon-link--badged</code>
    modifier, respectively.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <button
        aria-label="Watchlist (4 notifications)"
        class="icon-btn icon-btn--badged"
        type="button">
        <svg class="icon icon--24" width="24" height="24" aria-hidden="true">
          <icon-symbol name="heart-24"/>
        </svg>
        <span aria-hidden="true" class="badge">
          4
        </span>
      </button>
      <a
        aria-label="Inbox (4 notifications)"
        class="icon-link icon-link--badged"
        href="https://www.ebay.com">
        <svg class="icon icon--24" width="24" height="24" aria-hidden="true">
          <icon-symbol name="notification-24"/>
        </svg>
        <span aria-hidden="true" class="badge">
          99+
        </span>
      </a>
    </div>
  </div>
  <highlight-code type="html">
    <button
      aria-label="Watchlist (4 notifications)"
      class="icon-btn icon-btn--badged"
      type="button">
      <svg class="icon icon--24" width="24" height="24" aria-hidden="true">
        <use href="#icon-heart-24"/>
      </svg>
      <span aria-hidden="true" class="badge">
        4
      </span>
    </button>
    <a
      aria-label="Inbox (4 notifications)"
      class="icon-link icon-link--badged"
      href="https://www.ebay.com">
      <svg class="icon icon--24" width="24" height="24" aria-hidden="true">
        <use href="#icon-notification-24"/>
      </svg>
      <span aria-hidden="true" class="badge">
        99+
      </span>
    </a>
  </highlight-code>

