  <h3 id="lightbox-scrolling">
    Scrolling Lightbox
  </h3>
  <p>
    The lightbox scales vertically and adds scrollbars when content overflows
    the viewport.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <button
        class="btn btn--primary dialog-button"
        data-makeup-for="lightbox-dialog-scrolling"
        type="button">
