<div id="video">
  <section-header/>

  <h3 id="video-base">Base Video</h3>
  <p>
    The <code>video</code> block wraps a native <code>&lt;video&gt;</code>
    element and a <code>video__controls</code> bar. The control bar is a flex
    row that sizes to 100% of the container. Time labels are
    <code>&lt;span&gt;</code> elements using the <code>video__timestamp</code>
    class. The scrubber range input uses <code>video__scrubber</code> to fill
    remaining space. All buttons in the bar use <code>video__control</code> — a
    bare, unstyled button with only a pressed state.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <div class="video" style="max-width: 640px">
        <video
          src="https://archive.org/download/BigBuckBunny_124/Content/big_buck_bunny_720p_surround.mp4"
          poster="https://peach.blender.org/wp-content/uploads/title_anouncement.jpg?x11217"
          aria-label="sample video"
        />
        <div class="video__controls" role="group" aria-label="Video controls">
          <button class="video__control" type="button" aria-label="Play">
            <svg
              class="icon icon--20"
              width="20"
              height="20"
              aria-hidden="true"
            >
              <icon-symbol name="play-20"/>
            </svg>
          </button>
          <span class="video__timestamp">0:00</span>
          <input
            class="video__scrubber"
            type="range"
            min="0"
            max="100"
            value="0"
            step="0.1"
            aria-label="Seek"
          >
          <span class="video__timestamp">1:23</span>
          <button class="video__control" type="button" aria-label="Fullscreen">
            <svg
              class="icon icon--16"
              width="16"
              height="16"
              aria-hidden="true"
            >
              <icon-symbol name="expand-16"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <highlight-code type="html">
    <div class="video">
      <video src="..." preload="metadata" aria-label="Sample video"/>
      <div class="video__controls" role="group" aria-label="Video controls">
        <button class="video__control" type="button" aria-label="Play">
          <svg class="icon icon--20" width="20" height="20" aria-hidden="true">
            <use href="#icon-play-20"/>
          </svg>
        </button>
        <span class="video__timestamp">0:00</span>
        <input
          class="video__scrubber"
          type="range"
          min="0"
          max="100"
          value="0"
          step="0.1"
          aria-label="Seek"
        >
        <span class="video__timestamp">1:23</span>
        <button class="video__control" type="button" aria-label="Fullscreen">
          <svg class="icon icon--16" width="16" height="16" aria-hidden="true">
            <use href="#icon-expand-16"/>
          </svg>
        </button>
      </div>
    </div>
  </highlight-code>

  <h3 id="video-popover-control">Popover Controls</h3>
  <p>
    The control bar may contain buttons that open popovers.
    <code>video__popover-container</code> anchors a <code>video__popover</code>
    to its trigger, shown while the trigger is <code>aria-expanded="true"</code>.
    Add <code>video__popover-container--hover</code> instead to reveal the popover
    on hover and focus, as the volume slider does.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <div class="video" style="max-width: 640px">
        <video
          src="https://archive.org/download/BigBuckBunny_124/Content/big_buck_bunny_720p_surround.mp4"
          poster="https://peach.blender.org/wp-content/uploads/title_anouncement.jpg?x11217"
          aria-label="sample video"
        />
        <div class="video__controls" role="group" aria-label="Video controls">
          <button class="video__control" type="button" aria-label="Play">
            <svg
              class="icon icon--20"
              width="20"
              height="20"
              aria-hidden="true"
            >
              <icon-symbol name="play-20"/>
            </svg>
          </button>
          <span class="video__timestamp">0:00</span>
          <input
            class="video__scrubber"
            type="range"
            min="0"
            max="100"
            value="0"
            step="0.1"
            aria-label="Seek"
          >
          <span class="video__timestamp">1:23</span>
          <span class="video__popover-container">
            <button
              class="video__control"
              type="button"
              aria-label="Closed captions"
              aria-expanded="false"
              onClick(_, el) {
                el.ariaExpanded = el.ariaExpanded === "true" ? "false" : "true";
              }
            >
              <svg
                class="icon icon--16"
                width="16"
                height="16"
                aria-hidden="true"
              >
                <icon-symbol name="closed-caption-16"/>
              </svg>
            </button>
            <span class="video__popover">
              <span class="menu">
                <div role="menu" class="menu__items">
                  <div
                    class="menu__item"
                    role="menuitemradio"
                    aria-checked="false"
                  >
                    <span>Off</span>
                  </div>
                </div>
                <div role="menu" class="menu__items">
                  <div
                    class="menu__item"
                    role="menuitemradio"
                    aria-checked="false"
                  >
                    <span>English</span>
                  </div>
                </div>
              </span>
            </span>
          </span>
          <span class="video__popover-container video__popover-container--hover">
            <button
              class="video__control"
              type="button"
              aria-label="Mute"
              aria-pressed="false"
            >
              <svg
                class="icon icon--16"
                width="16"
                height="16"
                aria-hidden="true"
              >
                <icon-symbol name="audio-high-16"/>
              </svg>
            </button>
            <div class="video__popover">
              <input
                class="video__volume"
                type="range"
                min="0"
                max="100"
                value="80"
                aria-label="Volume"
              >
            </div>
          </span>
          <button class="video__control" type="button" aria-label="Fullscreen">
            <svg
              class="icon icon--16"
              width="16"
              height="16"
              aria-hidden="true"
            >
              <icon-symbol name="expand-16"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <highlight-code type="html">
