export const metadata = {
  component: "star-rating-select",
  "ds-component": {
    name: "review-input",
    version: 1,
  },
};

<script>
  document.querySelectorAll(".star-rating-select").forEach(function (widgetEl) {
    widgetEl.addEventListener("change", function (e: Event) {
      const selectedIndex = parseInt((e.target as HTMLInputElement).value) - 1;
      widgetEl.querySelectorAll("input").forEach(function (inputEl, index) {
        inputEl.classList.toggle(
          "star-rating-select__control--filled",
          index < selectedIndex,
        );
      });
    });
  });
</script>
